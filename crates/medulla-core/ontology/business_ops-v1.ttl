@prefix : <https://knuckles-team.github.io/ontology/core#> .
@prefix bfo: <http://purl.obolibrary.org/obo/BFO_> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Business operations pack (MEDULLA-BUSINESS-OPS-R001). It adds only the terms that no
# existing pack owns. Every class rolls up to a core-foundation class. Amounts are
# integers in minor units with a currency code; no term here names a product.

<https://knuckles-team.github.io/ontology/business_ops> a owl:Ontology ;
    rdfs:label "Business Operations" ;
    rdfs:comment "Business profile, governance, order, payment, procurement, stock, compliance, tax, approval and deploy vocabulary for running a small business. Reuses the core, commercial and supply-chain classes; redeclares none." ;
    owl:imports <https://knuckles-team.github.io/ontology/commercial>, <https://knuckles-team.github.io/ontology/supply_chain> .

# spec: MEDULLA-BUSINESS-OPS-R001.1
:BusinessProfile a owl:Class ;
    rdfs:label "Business Profile" ;
    rdfs:comment "The legal entity an operating business runs as, with its brands, role assignments and approval matrix." ;
    rdfs:subClassOf :LegalEntity .

:Brand a owl:Class ;
    rdfs:label "Brand" ;
    rdfs:comment "A trading name a business profile sells under." ;
    rdfs:subClassOf :DomainEntity .

:RoleAssignment a owl:Class ;
    rdfs:label "Role Assignment" ;
    rdfs:comment "One person holding one role within a scope for a valid interval." ;
    rdfs:subClassOf :DomainEntity .

:ApprovalRule a owl:Class ;
    rdfs:label "Approval Rule" ;
    rdfs:comment "Who must approve one action kind up to an amount ceiling, and how many approvers are required. The set of approval rules of one profile is its approval matrix." ;
    rdfs:subClassOf :GovernanceRule .

:ClaimPolicy a owl:Class ;
    rdfs:label "Claim Policy" ;
    rdfs:comment "The approved and forbidden phrases that govern public claim text." ;
    rdfs:subClassOf :Policy .

:ApprovedPhrase a owl:Class ;
    rdfs:label "Approved Phrase" ;
    rdfs:comment "A phrase a claim policy permits." ;
    rdfs:subClassOf :DomainEntity .

:ForbiddenPhrase a owl:Class ;
    rdfs:label "Forbidden Phrase" ;
    rdfs:comment "A phrase a claim policy forbids." ;
    rdfs:subClassOf :DomainEntity .

:brandOfProfile a owl:ObjectProperty ;
    rdfs:label "brand of profile" ;
    rdfs:comment "Links a brand to the business profile that owns it." ;
    rdfs:domain :Brand ;
    rdfs:range :BusinessProfile .

:assigneePerson a owl:ObjectProperty ;
    rdfs:label "assignee person" ;
    rdfs:comment "The person a role assignment gives the role to." ;
    rdfs:domain :RoleAssignment ;
    rdfs:range :Person .

:assignedRole a owl:ObjectProperty ;
    rdfs:label "assigned role" ;
    rdfs:comment "The role a role assignment grants." ;
    rdfs:domain :RoleAssignment ;
    rdfs:range :Role .

:roleScope a owl:DatatypeProperty ;
    rdfs:label "role scope" ;
    rdfs:comment "The scope (a brand, a profile or a system) in which the assigned role holds." ;
    rdfs:domain :RoleAssignment ;
    rdfs:range xsd:string .

:assignmentValidFrom a owl:DatatypeProperty ;
    rdfs:label "assignment valid from" ;
    rdfs:comment "The first day a role assignment holds." ;
    rdfs:domain :RoleAssignment ;
    rdfs:range xsd:date .

:assignmentValidUntil a owl:DatatypeProperty ;
    rdfs:label "assignment valid until" ;
    rdfs:comment "The last day a role assignment holds; absent means still current." ;
    rdfs:domain :RoleAssignment ;
    rdfs:range xsd:date .

:approvalRuleOfProfile a owl:ObjectProperty ;
    rdfs:label "approval rule of profile" ;
    rdfs:comment "Links an approval rule to the business profile whose approval matrix it belongs to." ;
    rdfs:domain :ApprovalRule ;
    rdfs:range :BusinessProfile .

:approvalActionKind a owl:DatatypeProperty ;
    rdfs:label "approval action kind" ;
    rdfs:comment "The kind of action the approval rule governs, such as refund or purchase." ;
    rdfs:domain :ApprovalRule ;
    rdfs:range xsd:string .

:approvalCeilingMinor a owl:DatatypeProperty ;
    rdfs:label "approval ceiling" ;
    rdfs:comment "The largest amount the rule covers, an integer in minor units." ;
    rdfs:domain :ApprovalRule ;
    rdfs:range xsd:integer .

:approvalCurrency a owl:DatatypeProperty ;
    rdfs:label "approval currency" ;
    rdfs:comment "The currency code of the ceiling." ;
    rdfs:domain :ApprovalRule ;
    rdfs:range xsd:string .

:approvalRequiredRole a owl:ObjectProperty ;
    rdfs:label "approval required role" ;
    rdfs:comment "The role whose holder may approve under this rule." ;
    rdfs:domain :ApprovalRule ;
    rdfs:range :Role .

:approvalQuorum a owl:DatatypeProperty ;
    rdfs:label "approval quorum" ;
    rdfs:comment "How many distinct approvers the rule requires." ;
    rdfs:domain :ApprovalRule ;
    rdfs:range xsd:integer .

# spec: MEDULLA-BUSINESS-OPS-R004
# The two properties the approval gate question reads beside the quorum, the role and the
# ceiling: the class of the gate and how long an approval of the rule stays open.
:approvalGateClass a owl:DatatypeProperty ;
    rdfs:label "approval gate class" ;
    rdfs:comment "The class of the gate the rule sets: legal_filing, money_movement, publishing or production_qa." ;
    rdfs:domain :ApprovalRule ;
    rdfs:range xsd:string .

:approvalExpiryMs a owl:DatatypeProperty ;
    rdfs:label "approval expiry" ;
    rdfs:comment "How long an approval under the rule stays open, in milliseconds." ;
    rdfs:domain :ApprovalRule ;
    rdfs:range xsd:integer .

:claimApprovedPhrase a owl:ObjectProperty ;
    rdfs:label "claim approved phrase" ;
    rdfs:comment "Links a claim policy to a phrase it approves." ;
    rdfs:domain :ClaimPolicy ;
    rdfs:range :ApprovedPhrase .

:claimForbiddenPhrase a owl:ObjectProperty ;
    rdfs:label "claim forbidden phrase" ;
    rdfs:comment "Links a claim policy to a phrase it forbids." ;
    rdfs:domain :ClaimPolicy ;
    rdfs:range :ForbiddenPhrase .

:phraseText a owl:DatatypeProperty ;
    rdfs:label "phrase text" ;
    rdfs:comment "The text of an approved or forbidden phrase." ;
    rdfs:range xsd:string .

:phraseLocale a owl:DatatypeProperty ;
    rdfs:label "phrase locale" ;
    rdfs:comment "The locale (BCP 47 tag) the phrase applies to." ;
    rdfs:range xsd:string .

:phraseMatchMode a owl:DatatypeProperty ;
    rdfs:label "phrase match mode" ;
    rdfs:comment "How the phrase matches: exact, word (word-bounded) or stem." ;
    rdfs:range xsd:string .

# spec: MEDULLA-BUSINESS-OPS-R001.3
# Money is an integer in minor units with a currency code; `MoneyShape` refuses any
# other literal on an amount property.
:OrderLine a owl:Class ;
    rdfs:label "Order Line" ;
    rdfs:comment "One line of an order: a variant, optionally the lot it was drawn from, a quantity, a unit price and a tax amount." ;
    rdfs:subClassOf :DomainEntity .

:Payment a owl:Class ;
    rdfs:label "Payment" ;
    rdfs:comment "Money received against an order, in minor units." ;
    rdfs:subClassOf :DomainEntity .

:Refund a owl:Class ;
    rdfs:label "Refund" ;
    rdfs:comment "Money returned against one payment; never more than that payment." ;
    rdfs:subClassOf :DomainEntity .

:Payout a owl:Class ;
    rdfs:label "Payout" ;
    rdfs:comment "A batch transfer that settles payments, less fees." ;
    rdfs:subClassOf :DomainEntity .

:Fee a owl:Class ;
    rdfs:label "Fee" ;
    rdfs:comment "A charge netted against a payout." ;
    rdfs:subClassOf :DomainEntity .

:lineOfOrder a owl:ObjectProperty ;
    rdfs:label "line of order" ;
    rdfs:comment "Links an order line to the order it belongs to." ;
    rdfs:domain :OrderLine ;
    rdfs:range :Order .

:lineVariant a owl:ObjectProperty ;
    rdfs:label "line variant" ;
    rdfs:comment "The product variant an order line sells." ;
    rdfs:domain :OrderLine ;
    rdfs:range :ProductVariant .

:lineLot a owl:ObjectProperty ;
    rdfs:label "line lot" ;
    rdfs:comment "The lot an order line was drawn from." ;
    rdfs:domain :OrderLine ;
    rdfs:range :InventoryLot .

:lineQuantity a owl:DatatypeProperty ;
    rdfs:label "line quantity" ;
    rdfs:comment "The quantity an order line sells, an integer count of units." ;
    rdfs:domain :OrderLine ;
    rdfs:range xsd:integer .

:unitPriceMinor a owl:DatatypeProperty ;
    rdfs:label "unit price" ;
    rdfs:comment "The price of one unit, an integer in minor units." ;
    rdfs:domain :OrderLine ;
    rdfs:range xsd:integer .

:taxMinor a owl:DatatypeProperty ;
    rdfs:label "tax amount" ;
    rdfs:comment "The tax on an order line, an integer in minor units." ;
    rdfs:domain :OrderLine ;
    rdfs:range xsd:integer .

:paymentOfOrder a owl:ObjectProperty ;
    rdfs:label "payment of order" ;
    rdfs:comment "Links a payment to the order it pays." ;
    rdfs:domain :Payment ;
    rdfs:range :Order .

:refundOf a owl:ObjectProperty ;
    rdfs:label "refund of" ;
    rdfs:comment "Links a refund to the one payment it returns." ;
    rdfs:domain :Refund ;
    rdfs:range :Payment .

:settlesPayment a owl:ObjectProperty ;
    rdfs:label "settles payment" ;
    rdfs:comment "Links a payout to each payment it settles." ;
    rdfs:domain :Payout ;
    rdfs:range :Payment .

:feeOfPayout a owl:ObjectProperty ;
    rdfs:label "fee of payout" ;
    rdfs:comment "Links a fee to the payout it is netted against." ;
    rdfs:domain :Fee ;
    rdfs:range :Payout .

:amountMinor a owl:DatatypeProperty ;
    rdfs:label "amount" ;
    rdfs:comment "The amount of a payment, refund, payout or fee, an integer in minor units." ;
    rdfs:range xsd:integer .

:amountCurrency a owl:DatatypeProperty ;
    rdfs:label "amount currency" ;
    rdfs:comment "The currency code of an amount." ;
    rdfs:range xsd:string .

# spec: MEDULLA-BUSINESS-OPS-R001.4
# Procurement and stock. :PurchaseOrder and :PurchaseInvoice are declared by the
# commercial module and :Supplier by the supply-chain module; none is redeclared here.
:PurchaseOrderLine a owl:Class ;
    rdfs:label "Purchase Order Line" ;
    rdfs:comment "One line of a purchase order: a variant, a quantity and a unit cost." ;
    rdfs:subClassOf :DomainEntity .

:GoodsReceipt a owl:Class ;
    rdfs:label "Goods Receipt" ;
    rdfs:comment "The receipt of goods against a purchase order." ;
    rdfs:subClassOf :DomainEntity .

:StockLevel a owl:Class ;
    rdfs:label "Stock Level" ;
    rdfs:comment "The on-hand and reserved quantity of one variant at one location as of a time." ;
    rdfs:subClassOf :DomainEntity .

:ReorderPolicy a owl:Class ;
    rdfs:label "Reorder Policy" ;
    rdfs:comment "When and how much to reorder one variant from one supplier." ;
    rdfs:subClassOf :RuleSpec .

:purchaseLineOfOrder a owl:ObjectProperty ;
    rdfs:label "purchase line of order" ;
    rdfs:comment "Links a purchase order line to its purchase order." ;
    rdfs:domain :PurchaseOrderLine ;
    rdfs:range :PurchaseOrder .

:purchaseLineVariant a owl:ObjectProperty ;
    rdfs:label "purchase line variant" ;
    rdfs:comment "The product variant a purchase order line buys." ;
    rdfs:domain :PurchaseOrderLine ;
    rdfs:range :ProductVariant .

:purchaseLineQuantity a owl:DatatypeProperty ;
    rdfs:label "purchase line quantity" ;
    rdfs:comment "The quantity ordered, an integer count of units." ;
    rdfs:domain :PurchaseOrderLine ;
    rdfs:range xsd:integer .

:receiptOfOrder a owl:ObjectProperty ;
    rdfs:label "receipt of order" ;
    rdfs:comment "Links a goods receipt to the purchase order it fulfils." ;
    rdfs:domain :GoodsReceipt ;
    rdfs:range :PurchaseOrder .

:stockVariant a owl:ObjectProperty ;
    rdfs:label "stock variant" ;
    rdfs:comment "The product variant a stock level counts." ;
    rdfs:domain :StockLevel ;
    rdfs:range :ProductVariant .

:stockLocation a owl:DatatypeProperty ;
    rdfs:label "stock location" ;
    rdfs:comment "The location a stock level counts." ;
    rdfs:domain :StockLevel ;
    rdfs:range xsd:string .

:onHand a owl:DatatypeProperty ;
    rdfs:label "on hand" ;
    rdfs:comment "The quantity physically held, an integer count of units." ;
    rdfs:domain :StockLevel ;
    rdfs:range xsd:integer .

:reservedQuantity a owl:DatatypeProperty ;
    rdfs:label "reserved quantity" ;
    rdfs:comment "The quantity held back for open orders, an integer count of units." ;
    rdfs:domain :StockLevel ;
    rdfs:range xsd:integer .

:stockAsOf a owl:DatatypeProperty ;
    rdfs:label "stock as of" ;
    rdfs:comment "The time the stock level was counted." ;
    rdfs:domain :StockLevel ;
    rdfs:range xsd:dateTime .

:reorderVariant a owl:ObjectProperty ;
    rdfs:label "reorder variant" ;
    rdfs:comment "The product variant a reorder policy governs." ;
    rdfs:domain :ReorderPolicy ;
    rdfs:range :ProductVariant .

:reorderSupplier a owl:ObjectProperty ;
    rdfs:label "reorder supplier" ;
    rdfs:comment "The supplier a reorder policy buys from." ;
    rdfs:domain :ReorderPolicy ;
    rdfs:range :Supplier .

:leadTimeDays a owl:DatatypeProperty ;
    rdfs:label "lead time days" ;
    rdfs:comment "Days from order to receipt: the lead time of a supplier, and the lead time a reorder policy plans with. It has no domain so both uses hold." ;
    rdfs:range xsd:integer .

# spec: MEDULLA-BUSINESS-OPS-R001.5
# Compliance obligations. The status of an obligation instance follows the one explicit
# state machine :ObligationInstanceMachine of state-machines-v1.ttl; its only writer is
# the transition function of `medulla_core::obligation_machine`.
:Jurisdiction a owl:Class ;
    rdfs:label "Jurisdiction" ;
    rdfs:comment "A legal territory whose authority imposes obligations, taxes and registrations." ;
    rdfs:subClassOf :DomainEntity .

:ComplianceObligation a owl:Class ;
    rdfs:label "Compliance Obligation" ;
    rdfs:comment "A recurring duty an authority imposes on a business, with the rule that says when it applies and the evidence that satisfies it." ;
    rdfs:subClassOf :GovernanceRule .

:RecurrenceRule a owl:Class ;
    rdfs:label "Recurrence Rule" ;
    rdfs:comment "When an obligation falls due: a rule spec of kind recurrence whose parameters hold the frequency, interval, day selector, business-day adjustment, zone and anchor, evaluated against a holiday calendar." ;
    rdfs:subClassOf :RuleSpec .

:HolidayCalendar a owl:Class ;
    rdfs:label "Holiday Calendar" ;
    rdfs:comment "The non-business days of one jurisdiction, revisioned." ;
    rdfs:subClassOf :DomainEntity .

# spec: MEDULLA-BUSINESS-OPS-R002.7
:holidayDate a owl:DatatypeProperty ;
    rdfs:label "holiday date" ;
    rdfs:comment "One non-business day of a holiday calendar; a calendar holds a list of them." ;
    rdfs:domain :HolidayCalendar ;
    rdfs:range xsd:date .

:ObligationInstance a owl:Class ;
    rdfs:label "Obligation Instance" ;
    rdfs:comment "One due occurrence of a compliance obligation, with a due date, a status and its evidence items." ;
    rdfs:subClassOf :DomainEntity .

:EvidenceItem a owl:Class ;
    rdfs:label "Evidence Item" ;
    rdfs:comment "One piece of evidence that an obligation instance was met." ;
    rdfs:subClassOf :Evidence .

:obligationJurisdiction a owl:ObjectProperty ;
    rdfs:label "obligation jurisdiction" ;
    rdfs:comment "The jurisdiction that imposes the obligation." ;
    rdfs:domain :ComplianceObligation ;
    rdfs:range :Jurisdiction .

:obligationAuthority a owl:DatatypeProperty ;
    rdfs:label "obligation authority" ;
    rdfs:comment "The name of the authority the obligation is owed to." ;
    rdfs:domain :ComplianceObligation ;
    rdfs:range xsd:string .

:obligationRecurrence a owl:ObjectProperty ;
    rdfs:label "obligation recurrence" ;
    rdfs:comment "The recurrence rule that says when the obligation falls due." ;
    rdfs:domain :ComplianceObligation ;
    rdfs:range :RecurrenceRule .

:applicabilityRule a owl:DatatypeProperty ;
    rdfs:label "applicability rule" ;
    rdfs:comment "The expression that decides whether the obligation applies, evaluated by the threshold rule kind." ;
    rdfs:domain :ComplianceObligation ;
    rdfs:range xsd:string .

:evidenceRequirement a owl:DatatypeProperty ;
    rdfs:label "evidence requirement" ;
    rdfs:comment "What evidence satisfies one instance of the obligation." ;
    rdfs:domain :ComplianceObligation ;
    rdfs:range xsd:string .

:recurrenceCalendar a owl:ObjectProperty ;
    rdfs:label "recurrence calendar" ;
    rdfs:comment "The holiday calendar the business-day adjustment reads." ;
    rdfs:domain :RecurrenceRule ;
    rdfs:range :HolidayCalendar .

:instanceOfObligation a owl:ObjectProperty ;
    rdfs:label "instance of obligation" ;
    rdfs:comment "Links an obligation instance to its compliance obligation." ;
    rdfs:domain :ObligationInstance ;
    rdfs:range :ComplianceObligation .

:instanceDueDate a owl:DatatypeProperty ;
    rdfs:label "instance due date" ;
    rdfs:comment "The date the instance falls due." ;
    rdfs:domain :ObligationInstance ;
    rdfs:range xsd:date .

:obligationStatus a owl:DatatypeProperty ;
    rdfs:label "obligation status" ;
    rdfs:comment "open, satisfied, waived or overdue; written only by the ObligationInstanceMachine transition function." ;
    rdfs:domain :ObligationInstance ;
    rdfs:range xsd:string .

:instanceEvidence a owl:ObjectProperty ;
    rdfs:label "instance evidence" ;
    rdfs:comment "Links an obligation instance to an evidence item that shows it was met." ;
    rdfs:domain :ObligationInstance ;
    rdfs:range :EvidenceItem .

# spec: MEDULLA-BUSINESS-OPS-R001.6
# Tax. A tax identifier is stored only as its keyed hash; a raw identifier property is
# refused by `TaxRegistrationShape`.
:TaxRegistration a owl:Class ;
    rdfs:label "Tax Registration" ;
    rdfs:comment "A business registered with a tax authority of one jurisdiction under a scheme, for a valid interval. The identifier is held only as a keyed hash." ;
    rdfs:subClassOf :DomainEntity .

:TaxRate a owl:Class ;
    rdfs:label "Tax Rate" ;
    rdfs:comment "The rate of one tax category in one jurisdiction for a valid interval, in basis points." ;
    rdfs:subClassOf :DomainEntity .

:TaxReturn a owl:Class ;
    rdfs:label "Tax Return" ;
    rdfs:comment "A filing of tax due for one period under one registration. It is an obligation instance, so its status follows the obligation instance machine." ;
    rdfs:subClassOf :ObligationInstance .

:taxJurisdiction a owl:ObjectProperty ;
    rdfs:label "tax jurisdiction" ;
    rdfs:comment "The jurisdiction a tax registration or tax rate belongs to." ;
    rdfs:range :Jurisdiction .

:taxIdentifierHash a owl:DatatypeProperty ;
    rdfs:label "tax identifier hash" ;
    rdfs:comment "The keyed SHA-256 of the tax identifier, 64 lowercase hex characters. The raw identifier is never stored." ;
    rdfs:domain :TaxRegistration ;
    rdfs:range xsd:string .

:taxScheme a owl:DatatypeProperty ;
    rdfs:label "tax scheme" ;
    rdfs:comment "The tax scheme the registration is under, such as sales tax or value added tax." ;
    rdfs:domain :TaxRegistration ;
    rdfs:range xsd:string .

:taxValidFrom a owl:DatatypeProperty ;
    rdfs:label "tax valid from" ;
    rdfs:comment "The first day a tax registration or rate holds." ;
    rdfs:range xsd:date .

:taxValidUntil a owl:DatatypeProperty ;
    rdfs:label "tax valid until" ;
    rdfs:comment "The last day a tax registration or rate holds; absent means still current." ;
    rdfs:range xsd:date .

:taxCategory a owl:DatatypeProperty ;
    rdfs:label "tax category" ;
    rdfs:comment "The category of goods or services a tax rate applies to." ;
    rdfs:domain :TaxRate ;
    rdfs:range xsd:string .

:rateBasisPoints a owl:DatatypeProperty ;
    rdfs:label "rate in basis points" ;
    rdfs:comment "A tax rate as an integer number of basis points (one hundredth of a percent)." ;
    rdfs:domain :TaxRate ;
    rdfs:range xsd:integer .

:returnRegistration a owl:ObjectProperty ;
    rdfs:label "return registration" ;
    rdfs:comment "The tax registration a tax return is filed under." ;
    rdfs:domain :TaxReturn ;
    rdfs:range :TaxRegistration .

:returnPeriod a owl:DatatypeProperty ;
    rdfs:label "return period" ;
    rdfs:comment "The period a tax return covers, such as 2027-Q1." ;
    rdfs:domain :TaxReturn ;
    rdfs:range xsd:string .

:returnTaxableMinor a owl:DatatypeProperty ;
    rdfs:label "return taxable amount" ;
    rdfs:comment "The taxable amount of a tax return, an integer in minor units." ;
    rdfs:domain :TaxReturn ;
    rdfs:range xsd:integer .

:returnTaxDueMinor a owl:DatatypeProperty ;
    rdfs:label "return tax due" ;
    rdfs:comment "The tax due on a tax return, an integer in minor units." ;
    rdfs:domain :TaxReturn ;
    rdfs:range xsd:integer .

:returnFiledAt a owl:DatatypeProperty ;
    rdfs:label "return filed at" ;
    rdfs:comment "When the tax return was filed." ;
    rdfs:domain :TaxReturn ;
    rdfs:range xsd:dateTime .

:filingReference a owl:DatatypeProperty ;
    rdfs:label "filing reference" ;
    rdfs:comment "The reference the authority gave the filing." ;
    rdfs:domain :TaxReturn ;
    rdfs:range xsd:string .

# spec: MEDULLA-BUSINESS-OPS-R001.7
# Approvals, gate decisions, deploys and incidents. The status of an approval request
# follows the one explicit state machine :ApprovalRequestMachine of
# state-machines-v1.ttl. The core :Incident and the :affects property of the
# service-operations module are reused.
:ApprovalRequest a owl:Class ;
    rdfs:label "Approval Request" ;
    rdfs:comment "A request that a person holding the required role approve one action on one subject node." ;
    rdfs:subClassOf :DomainEntity .

:GateDecision a owl:Class ;
    rdfs:label "Gate Decision" ;
    rdfs:comment "The signed decision of an approver on an approval request: approve, reject or defer." ;
    rdfs:subClassOf :Decision .

:DeployRecord a owl:Class ;
    rdfs:label "Deploy Record" ;
    rdfs:comment "One deployment of an artifact version to an environment under a gate decision, with its outcome." ;
    rdfs:subClassOf :DomainEntity .

:requestSubject a owl:ObjectProperty ;
    rdfs:label "request subject" ;
    rdfs:comment "The node the approval request is about." ;
    rdfs:domain :ApprovalRequest .

:requestActionKind a owl:DatatypeProperty ;
    rdfs:label "request action kind" ;
    rdfs:comment "The kind of action the request asks to approve, matched against the approval rules of the profile." ;
    rdfs:domain :ApprovalRequest ;
    rdfs:range xsd:string .

:requestAmountMinor a owl:DatatypeProperty ;
    rdfs:label "request amount" ;
    rdfs:comment "The amount the request concerns, an integer in minor units." ;
    rdfs:domain :ApprovalRequest ;
    rdfs:range xsd:integer .

:requestPrincipal a owl:ObjectProperty ;
    rdfs:label "request principal" ;
    rdfs:comment "The person or agent that made the approval request." ;
    rdfs:domain :ApprovalRequest .

:requestRequiredRole a owl:ObjectProperty ;
    rdfs:label "request required role" ;
    rdfs:comment "The role whose holder may decide the request." ;
    rdfs:domain :ApprovalRequest ;
    rdfs:range :Role .

:requestStatus a owl:DatatypeProperty ;
    rdfs:label "request status" ;
    rdfs:comment "pending, approved, rejected or deferred; written only by the ApprovalRequestMachine transition function." ;
    rdfs:domain :ApprovalRequest ;
    rdfs:range xsd:string .

:decisionRequest a owl:ObjectProperty ;
    rdfs:label "decision request" ;
    rdfs:comment "The approval request a gate decision decides." ;
    rdfs:domain :GateDecision ;
    rdfs:range :ApprovalRequest .

:gateOutcome a owl:DatatypeProperty ;
    rdfs:label "gate outcome" ;
    rdfs:comment "approve, reject or defer." ;
    rdfs:domain :GateDecision ;
    rdfs:range xsd:string .

:gateApprover a owl:ObjectProperty ;
    rdfs:label "gate approver" ;
    rdfs:comment "The person who signed the gate decision." ;
    rdfs:domain :GateDecision ;
    rdfs:range :Person .

:gateSignedAt a owl:DatatypeProperty ;
    rdfs:label "gate signed at" ;
    rdfs:comment "When the approver signed the gate decision." ;
    rdfs:domain :GateDecision ;
    rdfs:range xsd:dateTime .

:gateReason a owl:DatatypeProperty ;
    rdfs:label "gate reason" ;
    rdfs:comment "The approver's stated reason." ;
    rdfs:domain :GateDecision ;
    rdfs:range xsd:string .

:deployArtifact a owl:DatatypeProperty ;
    rdfs:label "deploy artifact" ;
    rdfs:comment "The name of the artifact that was deployed." ;
    rdfs:domain :DeployRecord ;
    rdfs:range xsd:string .

:deployEnvironment a owl:DatatypeProperty ;
    rdfs:label "deploy environment" ;
    rdfs:comment "The environment the artifact was deployed to." ;
    rdfs:domain :DeployRecord ;
    rdfs:range xsd:string .

:deployVersion a owl:DatatypeProperty ;
    rdfs:label "deploy version" ;
    rdfs:comment "The artifact version that was deployed." ;
    rdfs:domain :DeployRecord ;
    rdfs:range xsd:string .

:deployDecision a owl:ObjectProperty ;
    rdfs:label "deploy decision" ;
    rdfs:comment "The gate decision that allowed the deployment." ;
    rdfs:domain :DeployRecord ;
    rdfs:range :GateDecision .

:deployOutcome a owl:DatatypeProperty ;
    rdfs:label "deploy outcome" ;
    rdfs:comment "succeeded, failed or rolled_back." ;
    rdfs:domain :DeployRecord ;
    rdfs:range xsd:string .

:rollbackOf a owl:ObjectProperty ;
    rdfs:label "rollback of" ;
    rdfs:comment "Links a deploy record that rolled back to the deploy record it reversed." ;
    rdfs:domain :DeployRecord ;
    rdfs:range :DeployRecord .

:incidentSeverity a owl:DatatypeProperty ;
    rdfs:label "incident severity" ;
    rdfs:comment "low, medium, high or critical." ;
    rdfs:domain :Incident ;
    rdfs:range xsd:string .

:resolvedBy a owl:ObjectProperty ;
    rdfs:label "resolved by" ;
    rdfs:comment "Links an incident to the change, deploy or person that resolved it." ;
    rdfs:domain :Incident .

# spec: MEDULLA-BUSINESS-OPS-R002.1
:RuleSpec a owl:Class ;
    rdfs:label "Rule Spec" ;
    rdfs:comment "A deterministic business rule: its kind, version, parameters and the canonical digest of those. Immutable by id and version; every evaluation result names the digest of the rule that produced it." ;
    rdfs:subClassOf :GovernanceRule .

:ruleKind a owl:DatatypeProperty ;
    rdfs:label "rule kind" ;
    rdfs:comment "recurrence, threshold, reconcile, reorder or phrase_policy." ;
    rdfs:domain :RuleSpec ;
    rdfs:range xsd:string .

:ruleVersion a owl:DatatypeProperty ;
    rdfs:label "rule version" ;
    rdfs:comment "The version of the rule kind the parameters are written for; an unknown version refuses with RULE_VERSION_UNKNOWN." ;
    rdfs:domain :RuleSpec ;
    rdfs:range xsd:integer .

:ruleParameters a owl:DatatypeProperty ;
    rdfs:label "rule parameters" ;
    rdfs:comment "The rule parameters as one canonical text." ;
    rdfs:domain :RuleSpec ;
    rdfs:range xsd:string .

:ruleDigest a owl:DatatypeProperty ;
    rdfs:label "rule digest" ;
    rdfs:comment "The canonical digest of kind, version and parameters: 64 lowercase hex characters." ;
    rdfs:domain :RuleSpec ;
    rdfs:range xsd:string .

# spec: MEDULLA-BUSINESS-OPS-R001.2
:Product a owl:Class ;
    rdfs:label "Product" ;
    rdfs:comment "A sellable item definition." ;
    rdfs:subClassOf :SupplyChainItem .

:ProductVariant a owl:Class ;
    rdfs:label "Product Variant" ;
    rdfs:comment "One sellable form of a product." ;
    rdfs:subClassOf :Product .

:ProductionBatch a owl:Class ;
    rdfs:label "Production Batch" ;
    rdfs:comment "One production run of a product variant." ;
    rdfs:subClassOf :SupplyChainItem .

:InventoryLot a owl:Class ;
    rdfs:label "Inventory Lot" ;
    rdfs:comment "One traceable quantity of a production batch or of a received input." ;
    rdfs:subClassOf :SupplyChainItem .

:variantOfProduct a owl:ObjectProperty ;
    rdfs:label "variant of product" ;
    rdfs:comment "Links a product variant to the product it is a form of." ;
    rdfs:domain :ProductVariant ;
    rdfs:range :Product .

:batchOfVariant a owl:ObjectProperty ;
    rdfs:label "batch of variant" ;
    rdfs:comment "Links a production batch to the product variant it produced." ;
    rdfs:domain :ProductionBatch ;
    rdfs:range :ProductVariant .

:lotOfBatch a owl:ObjectProperty ;
    rdfs:label "lot of batch" ;
    rdfs:comment "Links an inventory lot to the production batch it holds a quantity of." ;
    rdfs:domain :InventoryLot ;
    rdfs:range :ProductionBatch .

:madeFromLot a owl:ObjectProperty ;
    rdfs:label "made from lot" ;
    rdfs:comment "Links a production batch to an input lot the batch consumed." ;
    rdfs:domain :ProductionBatch ;
    rdfs:range :InventoryLot .

:lotSupplier a owl:ObjectProperty ;
    rdfs:label "lot supplier" ;
    rdfs:comment "Links an inventory lot to the supplier that delivered it." ;
    rdfs:domain :InventoryLot ;
    rdfs:range :Supplier .

:lotQuantityUnit a owl:DatatypeProperty ;
    rdfs:label "lot quantity unit" ;
    rdfs:comment "The unit code of an inventory lot quantity." ;
    rdfs:domain :InventoryLot ;
    rdfs:range xsd:string .

:lotStatus a owl:DatatypeProperty ;
    rdfs:label "lot status" ;
    rdfs:comment "The status the source system reports for an inventory lot: open, released, quarantined, recalled or exhausted. Copied by ingest; the engine has no writer that moves it." ;
    rdfs:domain :InventoryLot ;
    rdfs:range xsd:string .
