# Media shapes (MEDULLA-MEDIA-VOCAB-R004.1 to R004.3).
#
# SHACL Core plus aggregate-free `sh:sparql` only (the virtual-graph shapes
# convention, DECIDE §4.8): the absence check uses the
# `OPTIONAL ... FILTER(!BOUND(...))` form, never NOT EXISTS or an aggregate.

@prefix :    <http://knuckles.team/kg#> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix dc:  <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

# R004.1: a work that a connector sourced carries at least one provider
# identity key. Works the operator entered by hand (no dc:source provenance)
# are exempt.

:ConnectorSourcedWorkShape a sh:NodeShape ;
    sh:targetClass :Film, :TelevisionSeries ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A connector-sourced Film or TelevisionSeries carries at least one of tmdbId, tvdbId, imdbId." ;
        sh:prefixes :MediaVocabShapePrefixes ;
        sh:select """
            SELECT $this WHERE {
                $this dc:source ?source .
                OPTIONAL { $this kg:tmdbId ?tmdb . FILTER(?tmdb != "") }
                OPTIONAL { $this kg:tvdbId ?tvdb . FILTER(?tvdb != "") }
                OPTIONAL { $this kg:imdbId ?imdb . FILTER(?imdb != "") }
                FILTER(!BOUND(?tmdb) && !BOUND(?tvdb) && !BOUND(?imdb))
            }
        """ ;
    ] .

# R004.2: a download transfer names exactly one lower-case hex info-hash,
# 40 characters (SHA-1) or 64 (SHA-256).

:DownloadTransferInfoHashShape a sh:NodeShape ;
    sh:targetClass :DownloadTransfer ;
    sh:property [
        sh:path :infoHash ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:or (
            [ sh:pattern "^[0-9a-f]{40}$" ]
            [ sh:pattern "^[0-9a-f]{64}$" ]
        ) ;
        sh:message "A DownloadTransfer carries exactly one infoHash of 40 or 64 lower-case hex characters."
    ] .

# R004.3: the download request state is a closed set.

:DownloadRequestStateShape a sh:NodeShape ;
    sh:targetClass :DownloadRequest ;
    sh:property [
        sh:path :downloadRequestState ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "requested" "wanted" "grabbed" "importing" "imported" "failed" ) ;
        sh:message "A DownloadRequest state is requested, wanted, grabbed, importing, imported or failed."
    ] .

# R001.100.1: a media tag names its media item, media revision, producer,
# evidence and provenance digest; its kind and confidence are bounded.

:MediaTagShape a sh:NodeShape ;
    sh:targetClass :MediaTag ;
    sh:property [ sh:path :taggedMedia ; sh:minCount 1 ;
        sh:message "A MediaTag names the media item it tags (taggedMedia)." ] ;
    sh:property [ sh:path :mediaRevision ; sh:minCount 1 ;
        sh:message "A MediaTag carries the media revision it was asserted against (mediaRevision)." ] ;
    sh:property [ sh:path :producerId ; sh:minCount 1 ;
        sh:message "A MediaTag carries the opaque producer id (producerId)." ] ;
    sh:property [ sh:path :evidenceRef ; sh:minCount 1 ;
        sh:message "A MediaTag carries an evidence reference (evidenceRef)." ] ;
    sh:property [ sh:path :provenanceDigest ; sh:minCount 1 ;
        sh:message "A MediaTag carries a provenance digest (provenanceDigest)." ] ;
    sh:property [ sh:path :tagKind ; sh:maxCount 1 ;
        sh:in ( "object" "context" ) ;
        sh:message "A MediaTag kind is object or context." ] ;
    sh:property [ sh:path :tagConfidence ; sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ; sh:maxInclusive 1 ;
        sh:message "A MediaTag confidence is a decimal between 0 and 1." ] .

:MediaVocabShapePrefixes a owl:Ontology ;
    sh:declare [ sh:prefix "kg" ; sh:namespace "http://knuckles.team/kg#"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix "dc" ; sh:namespace "http://purl.org/dc/terms/"^^xsd:anyURI ] .
