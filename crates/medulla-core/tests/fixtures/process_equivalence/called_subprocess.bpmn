<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" id="defs">
  <process id="called" name="Onboard supplier">
    <startEvent id="s" name="Supplier applied"/>
    <callActivity id="kyc" name="Verify identity" calledElement="identity_check"/>
    <serviceTask id="create" name="Create supplier record"/>
    <endEvent id="e" name="Supplier onboarded"/>
    <sequenceFlow id="f1" sourceRef="s" targetRef="kyc"/>
    <sequenceFlow id="f2" sourceRef="kyc" targetRef="create"/>
    <sequenceFlow id="f3" sourceRef="create" targetRef="e"/>
  </process>
</definitions>
