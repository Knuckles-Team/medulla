# Connector seed vocabulary (MEDULLA-TYPED-PACKS-R104.1).
#
# A seed graph carries the small identity, catalog and reference/index surface
# needed to establish a connector instance.  Bulk records remain at the
# connector source and are not represented by this vocabulary.

@prefix seed: <https://knuckles-team.github.io/ontology/connector-seed#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://knuckles-team.github.io/ontology/connector-seed> a owl:Ontology ;
    rdfs:label "Connector seed graph" ;
    rdfs:comment "Identity, catalog and reference/index facts established when a connector pack is imported." .

seed:SeedSubject a owl:Class ;
    rdfs:label "Seed subject" ;
    rdfs:comment "A graph subject established by a connector seed part." .

seed:SeedRevision a owl:Class ;
    rdfs:label "Seed revision" ;
    rdfs:comment "The immutable seed revision node that records which seed established a subject." .

seed:fromSeed a owl:ObjectProperty ;
    rdfs:label "from seed" ;
    rdfs:domain seed:SeedSubject ;
    rdfs:range seed:SeedRevision ;
    rdfs:comment "The seed revision that established a seed subject." .

# ── Core rooting (MEDULLA-TYPED-PACKS-R071.2) ───────────────────────────────────
# Every class of this module above reaches the core class kg:DomainEntity through rdfs:subClassOf.
<https://knuckles-team.github.io/ontology/connector-seed#SeedRevision> rdfs:subClassOf <https://knuckles-team.github.io/ontology/core#DomainEntity> .
<https://knuckles-team.github.io/ontology/connector-seed#SeedSubject> rdfs:subClassOf <https://knuckles-team.github.io/ontology/core#DomainEntity> .
