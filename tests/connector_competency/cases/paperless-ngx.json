      "uql": "LET s0 = FOREIGN SCAN 'paperless-ngx-mcp'; LET s1 = FOREIGN SCAN 'erpnext-agent'; LET s2 = FOREIGN SCAN 'firefly-iii-mcp'; JOIN s0, s1, s2",
      "sources": [
        "paperless-ngx-mcp",
        "erpnext-agent",
        "firefly-iii-mcp"
      ],
      "optional_sources": [],
      "source_kinds": {
        "paperless-ngx-mcp": "mcp_tool",
        "erpnext-agent": "mcp_tool",
        "firefly-iii-mcp": "mcp_tool"
      },
      "columns": [
        "document",
        "correspondent",
        "amount"
      ],
      "min_rows": 1,
      "recordings": [
        "paperless-ngx-mcp/cross_erpnext-agent.json",
        "erpnext-agent/cross_paperless-ngx-mcp.json",
