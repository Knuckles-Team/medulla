    rdfs:comment "Guard: the lease owner matches." .

:AnalyticsJobMachine_Guard_LeaseLapsed a :AnalyticsJobGuard ;
    rdfs:label "AnalyticsJob LeaseLapsed" ;
    rdfs:comment "Guard: the lease has lapsed." .

:AnalyticsJobMachine_J01 a :AnalyticsJobTransition ;
