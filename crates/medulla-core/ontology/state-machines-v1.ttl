    rdfs:label "AnalyticsJob AttemptsBelowMax" ;
    rdfs:comment "Guard: attempts are below the maximum." .

:AnalyticsJobMachine_Guard_AttemptsReachedMax a :AnalyticsJobGuard ;
    rdfs:label "AnalyticsJob AttemptsReachedMax" ;
    rdfs:comment "Guard: attempts reached the maximum." .

:AnalyticsJobMachine_Guard_LeaseLive a :AnalyticsJobGuard ;
