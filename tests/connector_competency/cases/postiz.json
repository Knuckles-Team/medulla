{
  "connector": "postiz",
  "rollup": "MEDULLA-CQ-CONN-R049",
  "vocabulary_module": "media-v1.ttl",
  "terms": [
    "EmailCampaign",
    "EngagementMetric",
    "PublishingChannel",
    "SocialPost",
    "clickCount",
    "engagementMetricName",
    "engagementMetricValue",
    "postState",
    "socialScheduledAt"
  ],
  "questions": [
    {
      "id": "postiz.q1",
      "kind": "single",
      "question": "Which scheduled posts failed to publish and on which channel?",
      "uql": "FOREIGN SCAN 'postiz-agent'",
      "sources": [
        "postiz-agent"
      ],
      "optional_sources": [],
      "source_kinds": {
        "postiz-agent": "mcp_tool"
      },
      "columns": [
        "post",
        "scheduled_at",
        "channel"
      ],
      "min_rows": 1,
      "recordings": [
        "postiz-agent/single.json"
      ]
    },
    {
      "id": "postiz.q2",
      "kind": "cross",
      "question": "Which Postiz posts promote a campaign that Listmonk also sent, and which got the better engagement?",
      "uql": "LET s0 = FOREIGN SCAN 'postiz-agent'; LET s1 = FOREIGN SCAN 'listmonk-api'; JOIN s0, s1",
      "sources": [
        "postiz-agent",
        "listmonk-api"
      ],
      "optional_sources": [],
      "source_kinds": {
        "postiz-agent": "mcp_tool",
        "listmonk-api": "http_endpoint"
      },
      "columns": [
        "post",
        "campaign",
        "better"
      ],
      "min_rows": 1,
      "recordings": [
        "postiz-agent/cross_listmonk-api.json",
        "listmonk-api/cross_postiz-agent.json"
      ]
    }
  ]
}
