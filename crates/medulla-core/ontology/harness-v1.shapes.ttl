# SHACL shapes for the typed model facts (MEDULLA-TYPED-PACKS-R066.1).
#
# The Rust contract represents shell proficiency and stopping behaviour as
# MeasuredFact values.  Their RDF projection keeps each measured value in a
# node so the value and the evaluation that produced it cannot be separated.

@prefix :   <https://knuckles-team.github.io/ontology/core#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:ModelProfileShape a sh:NodeShape ;
    sh:targetClass :ModelProfile ;
    sh:property [
        sh:path :contextWindowTokens ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:message "A model profile contextWindowTokens value must be at least 1."
    ] ;
    sh:property [
        sh:path :shellProficiency ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node :ShellProficiencyFactShape ;
        sh:message "shellProficiency is a measured fact with a closed value vocabulary and evaluationRun."
    ] ;
    sh:property [
        sh:path :stoppingBehaviour ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node :StoppingBehaviourFactShape ;
        sh:message "stoppingBehaviour is a measured fact with a closed value vocabulary and evaluationRun."
    ] .

:ShellProficiencyFactShape a sh:NodeShape ;
    sh:property [
        sh:path :value ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "low" "medium" "high" ) ;
        sh:message "shellProficiency value must be low, medium or high."
    ] ;
    sh:property [
        sh:path :evaluationRun ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A shellProficiency value must cite its evaluationRun."
    ] .

:StoppingBehaviourFactShape a sh:NodeShape ;
    sh:property [
        sh:path :value ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "stops_early" "balanced" "over_verifies" ) ;
        sh:message "stoppingBehaviour value must be stops_early, balanced or over_verifies."
    ] ;
    sh:property [
        sh:path :evaluationRun ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A stoppingBehaviour value must cite its evaluationRun."
    ] .

# A proposed HarnessEdit reverts when the shipped edits on its dimension inside
# the policy window, counting the candidate, reach the policy's minShipped
# (MEDULLA-DECISION-ENGINE-R173.3). Decide answers the same question through
# concentration_verdict over the same policy node.
:EditConcentrationShape a sh:NodeShape ;
    sh:targetClass :HarnessEdit ;
    sh:sparql [
        sh:message "Shipped edits on this dimension in the policy window reach the concentration cap." ;
        sh:select """
            PREFIX core: <https://knuckles-team.github.io/ontology/core#>
            SELECT $this (COUNT(?shipped) AS ?count) WHERE {
                $this core:editStatus "proposed" ;
                      core:targetsDimension ?dimension ;
                      core:editRound ?round .
                ?policy a core:ConcentrationPolicy ;
                        core:minShipped ?min ;
                        core:windowRounds ?window .
                ?shipped core:editStatus "shipped" ;
                         core:targetsDimension ?dimension ;
                         core:editRound ?shippedRound .
                FILTER (?shippedRound <= ?round && ?shippedRound > ?round - ?window)
            }
            GROUP BY $this ?min
            HAVING (COUNT(?shipped) + 1 >= ?min)
        """ ;
    ] .
