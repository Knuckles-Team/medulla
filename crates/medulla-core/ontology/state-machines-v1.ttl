    rdfs:label "AnalyticsJob RequestCancel" .

:AnalyticsJobMachine_Event_ConfirmCancel a :AnalyticsJobEvent ;
    rdfs:label "AnalyticsJob ConfirmCancel" .

:AnalyticsJobMachine_Event_Reclaim a :AnalyticsJobEvent ;
    rdfs:label "AnalyticsJob Reclaim" .

