    :fromState :PlannerScopeMachine_Frozen ;
    :toState :PlannerScopeMachine_Frozen ;
    :firedBy :PlannerScopeMachine_Event_GateFailed .

:PlannerScopeMachine_P03 a :PlannerScopeTransition ;
