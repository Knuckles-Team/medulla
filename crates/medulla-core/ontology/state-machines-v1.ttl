:GenerationCycleMachine a :StateMachine ;
    rdfs:label "GenerationCycle machine" ;
    :initialState :GenerationCycleMachine_Published ;
    :hasState :GenerationCycleMachine_Published, :GenerationCycleMachine_Reembedding, :GenerationCycleMachine_Evaluated, :GenerationCycleMachine_Activated, :GenerationCycleMachine_Rejected .

:GenerationCycleMachine_Published a :GenerationCycleState ;
    rdfs:label "GenerationCycle Published" ;
    :storedForm "published" .

:GenerationCycleMachine_Reembedding a :GenerationCycleState ;
    rdfs:label "GenerationCycle Reembedding" ;
    :storedForm "reembedding" .

:GenerationCycleMachine_Evaluated a :GenerationCycleState ;
    rdfs:label "GenerationCycle Evaluated" ;
    :storedForm "evaluated" .

:GenerationCycleMachine_Activated a :GenerationCycleTerminalState ;
    rdfs:label "GenerationCycle Activated" ;
    :storedForm "activated" .

:GenerationCycleMachine_Rejected a :GenerationCycleTerminalState ;
    rdfs:label "GenerationCycle Rejected" ;
    :storedForm "rejected" .

:GenerationCycleMachine_Event_ReembedBegun a :GenerationCycleEvent ;
    rdfs:label "GenerationCycle ReembedBegun" .

:GenerationCycleMachine_Event_EvaluationPassed a :GenerationCycleEvent ;
    rdfs:label "GenerationCycle EvaluationPassed" .

:GenerationCycleMachine_Event_EvaluationFailed a :GenerationCycleEvent ;
    rdfs:label "GenerationCycle EvaluationFailed" .

:GenerationCycleMachine_Event_PointerMoved a :GenerationCycleEvent ;
    rdfs:label "GenerationCycle PointerMoved" .

:GenerationCycleMachine_Event_Bootstrapped a :GenerationCycleEvent ;
    rdfs:label "GenerationCycle Bootstrapped" .

:GenerationCycleMachine_G01 a :GenerationCycleTransition ;
    rdfs:label "GenerationCycle G01" ;
    :edgeId "G01" ;
    :fromState :GenerationCycleMachine_Published ;
    :toState :GenerationCycleMachine_Reembedding ;
