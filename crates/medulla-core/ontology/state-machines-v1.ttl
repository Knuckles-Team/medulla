# spec: MEDULLA-PLACEMENT-R783.7
# The MovePhase machine. The Rust edge table MOVE_PHASE_MACHINE is the same table; the ontology
# test asserts equal edge sets. A hydrate move enters at Hydrate; every other move enters at Snapshot.

:MovePhaseState a owl:Class ;
    rdfs:label "MovePhase State" ;
    rdfs:comment "A state of the MovePhase machine." ;
    rdfs:subClassOf :State .

:MovePhaseTerminalState a owl:Class ;
    rdfs:label "MovePhase Terminal State" ;
    rdfs:comment "A terminal state of the MovePhase machine." ;
    rdfs:subClassOf :TerminalState, :MovePhaseState .

:MovePhaseTransition a owl:Class ;
    rdfs:label "MovePhase Transition" ;
    rdfs:comment "A transition of the MovePhase machine." ;
    rdfs:subClassOf :Transition .

:MovePhaseEvent a owl:Class ;
    rdfs:label "MovePhase Event" ;
    rdfs:comment "An event of the MovePhase machine." ;
    rdfs:subClassOf :TransitionEvent .

:MovePhaseGuard a owl:Class ;
    rdfs:label "MovePhase Guard" ;
    rdfs:comment "A guard of the MovePhase machine." ;
    rdfs:subClassOf :TransitionGuard .

:MovePhaseMachine a :StateMachine ;
    rdfs:label "MovePhase machine" ;
    :initialState :MovePhaseMachine_Snapshot ;
    :hasState :MovePhaseMachine_Snapshot, :MovePhaseMachine_DeltaCatchUp, :MovePhaseMachine_FencedCutover, :MovePhaseMachine_Hydrate, :MovePhaseMachine_Complete, :MovePhaseMachine_Aborted .

:MovePhaseMachine_Snapshot a :MovePhaseState ;
    rdfs:label "MovePhase Snapshot" ;
    :storedForm "snapshot" .

:MovePhaseMachine_DeltaCatchUp a :MovePhaseState ;
    rdfs:label "MovePhase DeltaCatchUp" ;
    :storedForm "delta_catch_up" .

:MovePhaseMachine_FencedCutover a :MovePhaseState ;
    rdfs:label "MovePhase FencedCutover" ;
    :storedForm "fenced_cutover" .

:MovePhaseMachine_Hydrate a :MovePhaseState ;
    rdfs:label "MovePhase Hydrate" ;
    :storedForm "hydrate" .

:MovePhaseMachine_Complete a :MovePhaseTerminalState ;
    rdfs:label "MovePhase Complete" ;
    :storedForm "complete" .

:MovePhaseMachine_Aborted a :MovePhaseTerminalState ;
    rdfs:label "MovePhase Aborted" ;
    :storedForm "aborted" .

:MovePhaseMachine_Event_SnapshotCopied a :MovePhaseEvent ;
    rdfs:label "MovePhase SnapshotCopied" .

:MovePhaseMachine_Event_DeltaCaughtUp a :MovePhaseEvent ;
    rdfs:label "MovePhase DeltaCaughtUp" .

:MovePhaseMachine_Event_CutoverCommitted a :MovePhaseEvent ;
    rdfs:label "MovePhase CutoverCommitted" .

:MovePhaseMachine_Event_Hydrated a :MovePhaseEvent ;
    rdfs:label "MovePhase Hydrated" .

:MovePhaseMachine_Event_Abort a :MovePhaseEvent ;
    rdfs:label "MovePhase Abort" .

:MovePhaseMachine_MP01 a :MovePhaseTransition ;
    rdfs:label "MovePhase MP01" ;
    :edgeId "MP01" ;
    :fromState :MovePhaseMachine_Snapshot ;
    :toState :MovePhaseMachine_DeltaCatchUp ;
    :firedBy :MovePhaseMachine_Event_SnapshotCopied .

:MovePhaseMachine_MP02 a :MovePhaseTransition ;
    rdfs:label "MovePhase MP02" ;
    :edgeId "MP02" ;
    :fromState :MovePhaseMachine_DeltaCatchUp ;
    :toState :MovePhaseMachine_FencedCutover ;
    :firedBy :MovePhaseMachine_Event_DeltaCaughtUp .

:MovePhaseMachine_MP03 a :MovePhaseTransition ;
    rdfs:label "MovePhase MP03" ;
    :edgeId "MP03" ;
    :fromState :MovePhaseMachine_FencedCutover ;
    :toState :MovePhaseMachine_Complete ;
    :firedBy :MovePhaseMachine_Event_CutoverCommitted .

:MovePhaseMachine_MP04 a :MovePhaseTransition ;
    rdfs:label "MovePhase MP04" ;
    :edgeId "MP04" ;
    :fromState :MovePhaseMachine_Hydrate ;
    :toState :MovePhaseMachine_Complete ;
    :firedBy :MovePhaseMachine_Event_Hydrated .

:MovePhaseMachine_MP05 a :MovePhaseTransition ;
    rdfs:label "MovePhase MP05" ;
    :edgeId "MP05" ;
    :fromState :MovePhaseMachine_Snapshot ;
    :toState :MovePhaseMachine_Aborted ;
    :firedBy :MovePhaseMachine_Event_Abort .

:MovePhaseMachine_MP06 a :MovePhaseTransition ;
    rdfs:label "MovePhase MP06" ;
    :edgeId "MP06" ;
    :fromState :MovePhaseMachine_DeltaCatchUp ;
    :toState :MovePhaseMachine_Aborted ;
    :firedBy :MovePhaseMachine_Event_Abort .

:MovePhaseMachine_MP07 a :MovePhaseTransition ;
    rdfs:label "MovePhase MP07" ;
    :edgeId "MP07" ;
    :fromState :MovePhaseMachine_FencedCutover ;
    :toState :MovePhaseMachine_Aborted ;
    :firedBy :MovePhaseMachine_Event_Abort .

:MovePhaseMachine_MP08 a :MovePhaseTransition ;
    rdfs:label "MovePhase MP08" ;
    :edgeId "MP08" ;
    :fromState :MovePhaseMachine_Hydrate ;
    :toState :MovePhaseMachine_Aborted ;
    :firedBy :MovePhaseMachine_Event_Abort .

