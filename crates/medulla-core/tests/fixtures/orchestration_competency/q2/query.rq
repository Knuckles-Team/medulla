PREFIX : <https://knuckles-team.github.io/ontology/core#>
PREFIX swarm: <https://knuckles-team.github.io/ontology/swarm#>
PREFIX dc: <http://purl.org/dc/terms/>
SELECT ?slot ?role ?kind ?min ?max ?source WHERE {
  :tmplXYZ swarm:hasSlot ?slot ; dc:source ?source .
  ?slot swarm:role ?role ; swarm:requiresAgentKind ?kind ;
        swarm:minWidth ?min ; swarm:maxWidth ?max .
}
