@prefix : <https://knuckles-team.github.io/ontology/test/connector-auto-onboard#> .
@prefix cat: <https://knuckles-team.github.io/ontology/catalog#> .
@prefix cp: <https://knuckles-team.github.io/ontology/connector-pack#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

:ontology a owl:Ontology ;
    owl:imports <https://knuckles-team.github.io/ontology/core> .

:ConnectorIncident a owl:Class ;
    rdfs:label "Connector incident" ;
    rdfs:subClassOf <https://knuckles-team.github.io/ontology/core#Ticket> .

:connector a cp:Connector ;
    cp:declaredOwner :owner .

:system-prompt a cat:PromptAsset ;
    cp:ofConnector :connector ;
    :systemPromptFor :incident-triage .

:incident-skill a cat:SkillAsset ;
    cp:ofConnector :connector .

:search-incidents a cat:ToolAsset ;
    cp:ofConnector :connector ;
    cp:servesClass :ConnectorIncident ;
    cat:actionType schema:SearchAction .

:incidents a cat:DataResource ;
    cp:ofConnector :connector ;
    cp:servesClass :ConnectorIncident ;
    cat:hasField :incident-id .

:incident-id a cat:Field ;
    cp:ofConnector :connector ;
    cp:servesProperty :incidentId .

:incident-1 a :ConnectorIncident ;
    cat:fromSource :incidents ;
    :status "open" .
