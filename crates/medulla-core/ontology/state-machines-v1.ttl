:GenerationCycleMachine_G02 a :GenerationCycleTransition ;
    rdfs:label "GenerationCycle G02" ;
    :edgeId "G02" ;
    :fromState :GenerationCycleMachine_Reembedding ;
    :toState :GenerationCycleMachine_Evaluated ;
    :firedBy :GenerationCycleMachine_Event_EvaluationPassed .

:GenerationCycleMachine_G03 a :GenerationCycleTransition ;
    rdfs:label "GenerationCycle G03" ;
    :edgeId "G03" ;
    :fromState :GenerationCycleMachine_Reembedding ;
    :toState :GenerationCycleMachine_Rejected ;
    :firedBy :GenerationCycleMachine_Event_EvaluationFailed .

:GenerationCycleMachine_G04 a :GenerationCycleTransition ;
    rdfs:label "GenerationCycle G04" ;
    :edgeId "G04" ;
    :fromState :GenerationCycleMachine_Evaluated ;
    :toState :GenerationCycleMachine_Activated ;
    :firedBy :GenerationCycleMachine_Event_PointerMoved .

:GenerationCycleMachine_G05 a :GenerationCycleTransition ;
    rdfs:label "GenerationCycle G05" ;
    :edgeId "G05" ;
    :fromState :GenerationCycleMachine_Reembedding ;
    :toState :GenerationCycleMachine_Evaluated ;
    :firedBy :GenerationCycleMachine_Event_Bootstrapped .
# spec: MEDULLA-DECISION-ENGINE-R036.103
# spec: MEDULLA-DECISION-ENGINE-R036.104
# The Reservation machine: the lifecycle of the RBAC read reservation and the Agent Library
# admission. The Rust edge table RESERVATION_MACHINE is the same table.

:ReservationState a owl:Class ;
    rdfs:label "Reservation State" ;
    rdfs:comment "A state of the Reservation machine." ;
    rdfs:subClassOf :State .

:ReservationTerminalState a owl:Class ;
    rdfs:label "Reservation Terminal State" ;
    rdfs:comment "A terminal state of the Reservation machine." ;
    rdfs:subClassOf :TerminalState, :ReservationState .

:ReservationTransition a owl:Class ;
    rdfs:label "Reservation Transition" ;
    rdfs:comment "A transition of the Reservation machine." ;
    rdfs:subClassOf :Transition .

:ReservationEvent a owl:Class ;
    rdfs:label "Reservation Event" ;
    rdfs:comment "An event of the Reservation machine." ;
    rdfs:subClassOf :TransitionEvent .

:ReservationMachine a :StateMachine ;
    rdfs:label "Reservation machine" ;
    :initialState :ReservationMachine_Reserved ;
    :hasState :ReservationMachine_Reserved, :ReservationMachine_Committed, :ReservationMachine_Aborted .

:ReservationMachine_Reserved a :ReservationState ;
    rdfs:label "Reservation Reserved" ;
    :storedForm "reserved" .

:ReservationMachine_Committed a :ReservationTerminalState ;
    rdfs:label "Reservation Committed" ;
    :storedForm "committed" .

:ReservationMachine_Aborted a :ReservationTerminalState ;
    rdfs:label "Reservation Aborted" ;
    :storedForm "aborted" .

:ReservationMachine_Event_Commit a :ReservationEvent ;
    rdfs:label "Reservation Commit" .

:ReservationMachine_Event_Abort a :ReservationEvent ;
    rdfs:label "Reservation Abort" .

:ReservationMachine_R01 a :ReservationTransition ;
    rdfs:label "Reservation R01" ;
    :edgeId "R01" ;
    :fromState :ReservationMachine_Reserved ;
    :toState :ReservationMachine_Committed ;
    :firedBy :ReservationMachine_Event_Commit .

:ReservationMachine_R02 a :ReservationTransition ;
    rdfs:label "Reservation R02" ;
    :edgeId "R02" ;
    :fromState :ReservationMachine_Reserved ;
    :toState :ReservationMachine_Aborted ;
    :firedBy :ReservationMachine_Event_Abort .

# spec: MEDULLA-DECISION-ENGINE-R036.106
# The ProfileGrant machine: the lifecycle of one durable profile-use grant. The Rust edge table
# PROFILE_GRANT_MACHINE is the same table.

:ProfileGrantState a owl:Class ;
    rdfs:label "ProfileGrant State" ;
    rdfs:comment "A state of the ProfileGrant machine." ;
    rdfs:subClassOf :State .

:ProfileGrantTerminalState a owl:Class ;
    rdfs:label "ProfileGrant Terminal State" ;
    rdfs:comment "A terminal state of the ProfileGrant machine." ;
    rdfs:subClassOf :TerminalState, :ProfileGrantState .

:ProfileGrantTransition a owl:Class ;
    rdfs:label "ProfileGrant Transition" ;
    rdfs:comment "A transition of the ProfileGrant machine." ;
    rdfs:subClassOf :Transition .

:ProfileGrantEvent a owl:Class ;
    rdfs:label "ProfileGrant Event" ;
    rdfs:comment "An event of the ProfileGrant machine." ;
    rdfs:subClassOf :TransitionEvent .

:ProfileGrantMachine a :StateMachine ;
    rdfs:label "ProfileGrant machine" ;
    :initialState :ProfileGrantMachine_Active ;
    :hasState :ProfileGrantMachine_Active, :ProfileGrantMachine_Revoked .

:ProfileGrantMachine_Active a :ProfileGrantState ;
    rdfs:label "ProfileGrant Active" ;
    :storedForm "active" .

:ProfileGrantMachine_Revoked a :ProfileGrantTerminalState ;
    rdfs:label "ProfileGrant Revoked" ;
    :storedForm "revoked" .

:ProfileGrantMachine_Event_Revoke a :ProfileGrantEvent ;
    rdfs:label "ProfileGrant Revoke" .

:ProfileGrantMachine_G01 a :ProfileGrantTransition ;
    rdfs:label "ProfileGrant G01" ;
    :edgeId "G01" ;
    :fromState :ProfileGrantMachine_Active ;
    :toState :ProfileGrantMachine_Revoked ;
    :firedBy :ProfileGrantMachine_Event_Revoke .

# spec: MEDULLA-DECISION-ENGINE-R707.1
# The FeatureLedger machine: the status of one feature ledger entry. The Rust edge table
# FEATURE_LEDGER_MACHINE is the same table.

:FeatureLedgerState a owl:Class ;
    rdfs:label "FeatureLedger State" ;
    rdfs:comment "A state of the FeatureLedger machine." ;
