@prefix : <https://knuckles-team.github.io/ontology/core#> .
@prefix cat: <https://knuckles-team.github.io/ontology/catalog#> .
@prefix cp: <https://knuckles-team.github.io/ontology/connector-pack#> .
@prefix bfo: <http://purl.obolibrary.org/obo/BFO_> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix catn: <https://knuckles-team.github.io/ontology/catalog#> .

<https://knuckles-team.github.io/ontology/metadata_catalog> a owl:Ontology ;
    rdfs:label "Metadata Catalog Ontology" ;
    rdfs:comment "The metadata catalog EG keeps for every connected source: catalogued assets (connector tools, prompts, skills, data resources and fields), owners and stewards, lineage, the business glossary and the Agent Library with system-prompt candidacy (MEDULLA-TYPED-PACKS-R106.1, MEDULLA-DECISION-ENGINE-R814.1.1). Aligned to W3C DCAT for the catalog, PROV-O for lineage and attribution, ORG for roles and units, SKOS for the glossary and schema.org Action for tool operations. Every class rolls up to an EG core class." ;
    dcterms:source "W3C DCAT 3, PROV-O, ORG, SKOS; schema.org Action" ;
    owl:imports <https://knuckles-team.github.io/ontology/capability>, <https://knuckles-team.github.io/ontology/orchestration>, <https://knuckles-team.github.io/ontology/service_operations> .

# -- Catalog and assets (DCAT) -----------------------------------------------------------

cat:Catalog a owl:Class ;
    catn:openMetadataType "Glossary" ;
    rdfs:label "Metadata Catalog" ;
    rdfs:comment "The catalog of one graph: every catalogued asset is cat:inCatalog of it." ;
    rdfs:subClassOf cat:Asset, dcat:Catalog .

cat:Asset a owl:Class ;
    rdfs:label "Catalog Asset" ;
    rdfs:comment "Anything the metadata catalog describes: a connector tool, prompt, skill, data resource, field or agent card. BFO:GenericallyDependentContinuant, a dcat:Resource." ;
    rdfs:subClassOf bfo:0000031, dcat:Resource .

cat:DataResource a owl:Class ;
    catn:openMetadataType "DataSet" ;
    rdfs:label "Data Resource" ;
    rdfs:comment "A connector data resource or ingest source (for example servicenow-mcp/incidents) that records of one ontology class come from." ;
    rdfs:subClassOf cat:Asset, :Dataset, dcat:Dataset .

cat:Field a owl:Class ;
    rdfs:label "Field" ;
    rdfs:comment "One field of a data resource, bound to the ontology property it carries." ;
    rdfs:subClassOf cat:Asset .

cat:ToolAsset a owl:Class ;
    rdfs:label "Tool Asset" ;
    rdfs:comment "One connector tool (one API operation). cat:actionType names the schema.org Action subtype it performs." ;
    rdfs:subClassOf cat:Asset .

cat:PromptAsset a owl:Class ;
    rdfs:label "Prompt Asset" ;
    rdfs:comment "One connector or Agent Library prompt." ;
    rdfs:subClassOf cat:Asset, :Prompt .

:PromptCandidate a owl:Class ;
    rdfs:label "Prompt Candidate" ;
    rdfs:comment "A prompt that can act as the system prompt of an agent for the tasks it is :systemPromptFor (MEDULLA-DECISION-ENGINE-R814.1.1). Candidacy is declared by the prompt (role system, systemPromptFor or useCase metadata), never inferred from text." ;
    rdfs:subClassOf cat:PromptAsset .

cat:SkillAsset a owl:Class ;
    rdfs:label "Skill Asset" ;
    rdfs:comment "One skill document (SKILL.md). It is about a :Skill (cat:describesSkill), it is not the skill." ;
    rdfs:subClassOf cat:Asset, :Document .

cat:AgentAsset a owl:Class ;
    rdfs:label "Agent Asset" ;
    rdfs:comment "An Agent Library entry: an agent card or template describing a :Agent (cat:describesAgent)." ;
    rdfs:subClassOf cat:Asset, :Document .

cp:Connector
    rdfs:label "Connector" ;
    rdfs:comment "A connected connector (an MCP server) that serves tools, prompts, skills and data resources. A dcat:DataService." ;
    rdfs:subClassOf :Tool, dcat:DataService .

cat:inCatalog a owl:ObjectProperty ;
    rdfs:label "in catalog" ;
    rdfs:domain cat:Asset ;
    rdfs:range cat:Catalog .

cp:ofConnector a owl:ObjectProperty ;
    rdfs:label "of connector" ;
    rdfs:comment "Links a catalogued asset to the connector that serves it." ;
    rdfs:domain cat:Asset ;
    rdfs:range cp:Connector .

cp:servesClass a owl:ObjectProperty ;
    rdfs:label "serves class" ;
    rdfs:comment "Links an asset to the ontology class whose records it reads, writes or frames." ;
    rdfs:domain cat:Asset ;
    rdfs:range owl:Class .

cp:servesProperty a owl:ObjectProperty ;
    rdfs:label "serves property" ;
    rdfs:domain cat:Field ;
    rdfs:range rdf:Property .

cat:hasField a owl:ObjectProperty ;
    rdfs:label "has field" ;
    rdfs:domain cat:DataResource ;
    rdfs:range cat:Field .

cat:actionType a owl:ObjectProperty ;
    rdfs:label "action type" ;
    rdfs:comment "The schema.org Action subtype a tool performs: schema:SearchAction for a read, schema:CreateAction, schema:UpdateAction or schema:DeleteAction for a write." ;
    rdfs:domain cat:ToolAsset ;
    rdfs:range rdfs:Class .

cat:describes a owl:ObjectProperty ;
    rdfs:label "describes" ;
    rdfs:comment "The entity a catalog asset is about. The asset is a record of its subject, never the subject itself." ;
    rdfs:domain cat:Asset .

cat:describesSkill a owl:ObjectProperty ;
    rdfs:label "describes skill" ;
    rdfs:subPropertyOf cat:describes ;
    rdfs:domain cat:SkillAsset ;
    rdfs:range :Skill .

cat:describesAgent a owl:ObjectProperty ;
    rdfs:label "describes agent" ;
    rdfs:subPropertyOf cat:describes ;
    rdfs:domain cat:AgentAsset ;
    rdfs:range :Agent .

cp:packVersion a owl:DatatypeProperty ;
    rdfs:label "pack version" ;
    rdfs:comment "The connector pack contract version (record id) the asset was catalogued from." ;
    rdfs:domain cat:Asset ;
    rdfs:range xsd:string .

cp:digest a owl:DatatypeProperty ;
    rdfs:label "digest" ;
    rdfs:comment "The sha256 content digest of the asset's served definition." ;
    rdfs:domain cat:Asset ;
    rdfs:range xsd:string .

cp:declaredOwner a owl:ObjectProperty ;
    rdfs:label "declared owner" ;
    rdfs:comment "The owner a connector pack declares for itself and its assets." ;
    rdfs:subPropertyOf :ownedBy ;
    rdfs:domain cp:Connector .

# -- Owners and stewards (PROV qualified attribution, ORG roles) ----------------------------

cat:hasOwner a owl:ObjectProperty ;
    rdfs:label "has owner" ;
    rdfs:comment "The accountable owner of an asset or a record (a person, group or organization)." ;
    rdfs:subPropertyOf :ownedBy, prov:wasAttributedTo .

cat:hasSteward a owl:ObjectProperty ;
    rdfs:label "has steward" ;
    rdfs:comment "The steward that manages or supports an asset or a record day to day (for example a ServiceNow managed-by or assignment group)." ;
    rdfs:subPropertyOf prov:wasAttributedTo ;
    rdfs:range bfo:0000004 .

cat:StewardshipAssignment a owl:Class ;
    rdfs:label "Stewardship Assignment" ;
    rdfs:comment "A role-qualified attribution: principal cat:principal holds role cat:role for the asset cat:assignedTo. A prov:Attribution." ;
    rdfs:subClassOf bfo:0000031, prov:Attribution .

cat:ChangeRequest a owl:Class ;
    rdfs:label "Change Request" ;
    rdfs:comment "A proposed change to a governed asset, moving open to approved or rejected and then applied. It records the target, the proposed digest, the reviewers, each verdict and the before and after digests." ;
    rdfs:subClassOf bfo:0000031, prov:Activity .

cat:Certification a owl:Class ;
    rdfs:label "Certification" ;
    rdfs:comment "A steward's statement that an asset is trusted at a level, until it expires." ;
    rdfs:subClassOf bfo:0000031, prov:Attribution .

cat:target a owl:ObjectProperty ;
    rdfs:label "target" ;
    rdfs:comment "The asset a change request proposes to change." ;
    rdfs:domain cat:ChangeRequest .

cat:proposedDigest a owl:DatatypeProperty ;
    rdfs:label "proposedDigest" ;
    rdfs:comment "The sha256 digest of the proposed asset content." ;
    rdfs:domain cat:ChangeRequest ;
    rdfs:range xsd:string .

cat:state a owl:DatatypeProperty ;
    rdfs:label "state" ;
    rdfs:comment "The change request state: open, approved, rejected or applied." ;
    rdfs:domain cat:ChangeRequest ;
    rdfs:range xsd:string .

cat:certifiedAsset a owl:ObjectProperty ;
    rdfs:label "certifiedAsset" ;
    rdfs:comment "The asset a certification covers." ;
    rdfs:domain cat:Certification .

cat:level a owl:DatatypeProperty ;
    rdfs:label "level" ;
    rdfs:comment "The level at which the asset is certified." ;
    rdfs:domain cat:Certification ;
    rdfs:range xsd:string .

cat:certifiedBy a owl:ObjectProperty ;
    rdfs:label "certifiedBy" ;
    rdfs:comment "The principal that certified the asset." ;
    rdfs:domain cat:Certification .

cat:expiresAt a owl:DatatypeProperty ;
    rdfs:label "expiresAt" ;
    rdfs:comment "Unix seconds after which the certification no longer holds." ;
    rdfs:domain cat:Certification ;
    rdfs:range xsd:nonNegativeInteger .

cat:assignedTo a owl:ObjectProperty ;
    rdfs:label "assigned to" ;
    rdfs:domain cat:StewardshipAssignment ;
    rdfs:range bfo:0000001 .

cat:principal a owl:ObjectProperty ;
    rdfs:label "principal" ;
    rdfs:subPropertyOf prov:agent ;
    rdfs:domain cat:StewardshipAssignment ;
    rdfs:range bfo:0000004 .

cat:role a owl:ObjectProperty ;
    rdfs:label "role" ;
    rdfs:subPropertyOf prov:hadRole ;
    rdfs:domain cat:StewardshipAssignment ;
    rdfs:range cat:StewardshipRole .

cat:StewardshipRole a owl:Class ;
    rdfs:label "Stewardship Role" ;
    rdfs:comment "A catalog role: owner, steward or custodian. An org:Role." ;
    rdfs:subClassOf :Role, org:Role .

cat:owner a cat:StewardshipRole ;
    rdfs:label "owner" .

cat:steward a cat:StewardshipRole ;
    rdfs:label "steward" .

cat:custodian a cat:StewardshipRole ;
    rdfs:label "custodian" .

cat:sourceRecord a owl:DatatypeProperty ;
    rdfs:label "source record" ;
    rdfs:comment "The id of the engine-held record a catalog node describes. The catalog links to the record and copies none of its content (MEDULLA-TYPED-PACKS-R108.2)." ;
    rdfs:domain cat:Asset ;
    rdfs:range xsd:string .

cat:flag a owl:DatatypeProperty ;
    rdfs:label "flag" ;
    rdfs:comment "A catalog quality flag on an asset, for example owner_missing." ;
    rdfs:domain cat:Asset ;
    rdfs:range xsd:string .

:AssignmentGroup rdfs:subClassOf org:OrganizationalUnit .

:memberOfGroup rdfs:subPropertyOf org:memberOf .

# -- Lineage (PROV-O) ---------------------------------------------------------------------

:derivedFrom rdfs:subPropertyOf prov:wasDerivedFrom .

cat:lineageTo a owl:ObjectProperty ;
    rdfs:label "lineage to" ;
    rdfs:comment "Upstream to downstream lineage: the inverse of :derivedFrom (prov:wasDerivedFrom). A property path cat:lineageTo+ walks lineage." ;
    owl:inverseOf :derivedFrom .

cat:LineageEdge a owl:Class ;
    catn:openMetadataType "DataFlow" ;
    rdfs:label "Lineage Edge" ;
    rdfs:comment "A qualified lineage hop from cat:from to cat:to with its hop type. A prov:Derivation." ;
    rdfs:subClassOf bfo:0000031, prov:Derivation .

cat:from a owl:ObjectProperty ;
    rdfs:label "from" ;
    rdfs:domain cat:LineageEdge ;
    rdfs:range bfo:0000001 .

cat:to a owl:ObjectProperty ;
    rdfs:label "to" ;
    rdfs:domain cat:LineageEdge ;
    rdfs:range bfo:0000001 .

cat:hop a owl:DatatypeProperty ;
    rdfs:label "hop" ;
    rdfs:comment "The lineage hop type: connector, operation, resource, field, ingest or transform." ;
    rdfs:domain cat:LineageEdge ;
    rdfs:range xsd:string .

cat:fromSource a owl:ObjectProperty ;
    rdfs:label "from source" ;
    rdfs:comment "Links an ingested record to the data resource it was read from." ;
    rdfs:subPropertyOf :derivedFrom ;
    rdfs:range cat:DataResource .

cat:IngestRun a owl:Class ;
    rdfs:label "Ingest Run" ;
    rdfs:comment "One source synchronisation that generated records (prov:wasGeneratedBy), associated with its connector and the tool it used. A prov:Activity." ;
    rdfs:subClassOf bfo:0000015, prov:Activity .

# -- Glossary (SKOS) ----------------------------------------------------------------------

cat:Glossary a owl:Class ;
    rdfs:label "Business Glossary" ;
    rdfs:subClassOf bfo:0000031, skos:ConceptScheme .

cat:CatalogGlossaryTerm a owl:Class ;
    catn:openMetadataType "GlossaryTerm" ;
    rdfs:label "Catalog Glossary Term" ;
    rdfs:comment "A glossary term the catalog publishes: a core glossary term (skos:prefLabel, skos:altLabel, skos:definition) that names an ontology class and the assets that serve it." ;
    rdfs:subClassOf :GlossaryTerm, skos:Concept .

cat:definesClass a owl:ObjectProperty ;
    rdfs:label "defines class" ;
    rdfs:domain cat:CatalogGlossaryTerm ;
    rdfs:range owl:Class .

:definesAsset a owl:ObjectProperty ;
    rdfs:label "defines asset" ;
    rdfs:comment "Links a glossary term to an asset that serves the class the term names (MEDULLA-TYPED-PACKS-R801.2)." ;
    rdfs:domain cat:CatalogGlossaryTerm ;
    rdfs:range cat:Asset .

# -- Open metadata type mapping (MEDULLA-TYPED-PACKS-R110.1) -------------------------------

catn:openMetadataType a owl:AnnotationProperty ;
    rdfs:label "open metadata type" ;
    rdfs:comment "Names the open metadata type a catalog class stands for, so the ontology drives the type mapping of the open-metadata sync. An open metadata type name with no class carrying this annotation is unmapped." .

cat:externalGuid a owl:DatatypeProperty ;
    rdfs:label "external GUID" ;
    rdfs:comment "The GUID of the open metadata instance a catalog node was synced from (MEDULLA-TYPED-PACKS-R110.3)." ;
    rdfs:range xsd:string .

cat:externalVersion a owl:DatatypeProperty ;
    rdfs:label "external version" ;
    rdfs:comment "The store version of the open metadata instance at the last sync; an outbound write carries it as the expected version." ;
    rdfs:range xsd:nonNegativeInteger .

cat:ConfidentialityClassification a owl:Class ;
    rdfs:label "Confidentiality Classification" ;
    rdfs:comment "A confidentiality marking attached to a catalogued asset." ;
    rdfs:subClassOf :DataClassification ;
    catn:openMetadataType "Confidentiality" .

cat:CriticalityClassification a owl:Class ;
    rdfs:label "Criticality Classification" ;
    rdfs:comment "A business criticality marking attached to a catalogued asset." ;
    rdfs:subClassOf :DataClassification ;
    catn:openMetadataType "Criticality" .

# -- Asset families (MEDULLA-TYPED-PACKS-R108.1) ---------------------------------------------
# Every family class below is a cat:Asset subclass only and rolls up to core through cat:Asset.
# A catalog record about a person, team, agent or workflow is not that entity: a family whose
# subject is a core entity links it with `cat:describes some :<Class>`, never by subclassing it
# (cat:Asset is a BFO generically dependent continuant, disjoint from the subjects it describes).

cat:AgentTemplateAsset a owl:Class ;
    rdfs:label "Agent Template Asset" ;
    rdfs:comment "An Agent Library template catalogued as an asset; it describes a :AgentTemplate." ;
    rdfs:subClassOf cat:Asset ,
        [ a owl:Restriction ; owl:onProperty cat:describes ; owl:someValuesFrom :AgentTemplate ] .

cat:A2AAgentAsset a owl:Class ;
    rdfs:label "A2A Agent Asset" ;
    rdfs:comment "An A2A agent card catalogued as an asset; it describes a :Agent." ;
    rdfs:subClassOf cat:Asset ,
        [ a owl:Restriction ; owl:onProperty cat:describes ; owl:someValuesFrom :Agent ] .

cat:AgentVersion a owl:Class ;
    rdfs:label "Agent Version" ;
    rdfs:comment "One immutable published version of an agent asset." ;
    rdfs:subClassOf cat:Asset ,
        [ a owl:Restriction ; owl:onProperty cat:describes ; owl:someValuesFrom :Agent ] .

cat:OrgUnit a owl:Class ;
    rdfs:label "Organizational Unit" ;
    rdfs:comment "A business unit catalogued as an asset." ;
    rdfs:subClassOf cat:Asset ,
        [ a owl:Restriction ; owl:onProperty cat:describes ; owl:someValuesFrom :Organization ] .

cat:TeamAsset a owl:Class ;
    rdfs:label "Team Asset" ;
    rdfs:comment "A team catalogued as an asset." ;
    rdfs:subClassOf cat:Asset ,
        [ a owl:Restriction ; owl:onProperty cat:describes ; owl:someValuesFrom :Team ] .

cat:PersonAsset a owl:Class ;
    rdfs:label "Person Asset" ;
    rdfs:comment "A person catalogued as an asset (an owner or a steward)." ;
    rdfs:subClassOf cat:Asset ,
        [ a owl:Restriction ; owl:onProperty cat:describes ; owl:someValuesFrom :Person ] .

catn:fieldMarking a owl:AnnotationProperty ;
    rdfs:label "field marking" ;
    rdfs:comment "Names the marking a writer must hold to write this field of a catalog person node (MEDULLA-TYPED-PACKS-R108.4). A field with no marking is open." .

cat:email a owl:DatatypeProperty ;
    rdfs:label "email" ;
    rdfs:comment "The email address of a person asset." ;
    rdfs:domain cat:PersonAsset ;
    rdfs:range xsd:string ;
    catn:fieldMarking "pii" .

cat:phone a owl:DatatypeProperty ;
    rdfs:label "phone" ;
    rdfs:comment "The phone number of a person asset." ;
    rdfs:domain cat:PersonAsset ;
    rdfs:range xsd:string ;
    catn:fieldMarking "pii" .

cat:RoleAsset a owl:Class ;
    rdfs:label "Role Asset" ;
    rdfs:comment "A business role catalogued as an asset." ;
    rdfs:subClassOf cat:Asset ,
        [ a owl:Restriction ; owl:onProperty cat:describes ; owl:someValuesFrom :Role ] .

cat:BusinessDomain a owl:Class ;
    rdfs:label "Business Domain" ;
    rdfs:comment "A business domain that groups assets and owners." ;
    rdfs:subClassOf cat:Asset .

cat:Product a owl:Class ;
    rdfs:label "Product Asset" ;
    rdfs:comment "A business product catalogued as an asset." ;
    rdfs:subClassOf cat:Asset .

cat:ServiceAsset a owl:Class ;
    rdfs:label "Service Asset" ;
    rdfs:comment "A business service catalogued as an asset." ;
    rdfs:subClassOf cat:Asset ,
        [ a owl:Restriction ; owl:onProperty cat:describes ; owl:someValuesFrom :Service ] .

cat:DashboardAsset a owl:Class ;
    rdfs:label "Dashboard Asset" ;
    rdfs:comment "A saved dashboard catalogued as an asset (MEDULLA-TYPED-PACKS-R109.1): its panels, queries, layout and parameters are stored; the data it shows is not. Panels link their data source, query, terms and concepts." ;
    rdfs:subClassOf cat:Asset .

cat:governedBy a owl:ObjectProperty ;
    rdfs:label "governed by" ;
    rdfs:comment "Names, by IRI, the access policy that governs an asset (MEDULLA-TYPED-PACKS-R108.9). The catalog stores the link and never the policy body; masking rules are read from the federated query policy and the admission policy name from the arbora admission policy." ;
    rdfs:domain cat:Asset .

cat:ReportAsset a owl:Class ;
    rdfs:label "Report Asset" ;
    rdfs:comment "A published report catalogued as an asset (MEDULLA-TYPED-PACKS-R108.14). It lists the assets it reads (cat:readsAsset), its owner and its usage; the catalog stores the descriptor and the query text, never the data shown." ;
    rdfs:subClassOf cat:Asset .

cat:ReportTemplate a owl:Class ;
    rdfs:label "Report Template" ;
    rdfs:comment "A report whose query takes named parameters (cat:parameterName)." ;
    rdfs:subClassOf cat:ReportAsset .

cat:readsAsset a owl:ObjectProperty ;
    rdfs:label "reads asset" ;
    rdfs:comment "An asset a report or dashboard reads." ;
    rdfs:domain cat:Asset ;
    rdfs:range cat:Asset .

cat:parameterName a owl:DatatypeProperty ;
    rdfs:label "parameter name" ;
    rdfs:comment "One named parameter of a report template." ;
    rdfs:domain cat:ReportTemplate ;
    rdfs:range xsd:string .

cat:revision a owl:DatatypeProperty ;
    rdfs:label "revision" ;
    rdfs:comment "The revision of a stored asset body; it only increases." ;
    rdfs:range xsd:nonNegativeInteger .

cat:Article a owl:Class ;
    rdfs:label "Article" ;
    rdfs:comment "A curated, versioned article or guide catalogued as an asset (MEDULLA-TYPED-PACKS-R108.13). It has an author, a version and a status on the review lifecycle of a glossary term, attaches to the assets it explains (cat:aboutAsset) and to the business domains it belongs to (cat:inBusinessDomain), and is found by its text and by the asset it describes." ;
    rdfs:subClassOf cat:Asset .

cat:author a owl:DatatypeProperty ;
    rdfs:label "author" ;
    rdfs:comment "The principal that wrote an article." ;
    rdfs:domain cat:Article ;
    rdfs:range xsd:string .

cat:articleVersion a owl:DatatypeProperty ;
    rdfs:label "article version" ;
    rdfs:comment "The version of an article; it only increases." ;
    rdfs:domain cat:Article ;
    rdfs:range xsd:nonNegativeInteger .

cat:articleStatus a owl:DatatypeProperty ;
    rdfs:label "article status" ;
    rdfs:comment "Where the article is on the review lifecycle: draft, in_review, approved or deprecated (MEDULLA-TYPED-PACKS-R801.1)." ;
    rdfs:domain cat:Article ;
    rdfs:range xsd:string .

cat:aboutAsset a owl:ObjectProperty ;
    rdfs:label "about asset" ;
    rdfs:comment "An asset an article explains." ;
    rdfs:domain cat:Article ;
    rdfs:range cat:Asset .

cat:inBusinessDomain a owl:ObjectProperty ;
    rdfs:label "in business domain" ;
    rdfs:comment "A business domain an article belongs to." ;
    rdfs:domain cat:Article ;
    rdfs:range cat:BusinessDomain .

cat:WorkflowDefinitionAsset a owl:Class ;
    rdfs:label "Workflow Definition" ;
    rdfs:comment "A workflow definition catalogued as an asset; it describes a :Workflow." ;
    rdfs:subClassOf cat:Asset ,
        [ a owl:Restriction ; owl:onProperty cat:describes ; owl:someValuesFrom :Workflow ] .

cat:WorkflowRun a owl:Class ;
    rdfs:label "Workflow Run" ;
    rdfs:comment "One run of a workflow definition." ;
    rdfs:subClassOf cat:Asset ,
        [ a owl:Restriction ; owl:onProperty cat:describes ; owl:someValuesFrom :DurableExecutionUnit ] .

cat:WorkflowStepAsset a owl:Class ;
    rdfs:label "Workflow Step" ;
    rdfs:comment "One step of a workflow definition." ;
    rdfs:subClassOf cat:Asset ,
        [ a owl:Restriction ; owl:onProperty cat:describes ; owl:someValuesFrom :WorkflowStep ] .

cat:KnowledgeGraph a owl:Class ;
    rdfs:label "Knowledge Graph Asset" ;
    rdfs:comment "A graph catalogued as an asset, linked to its ontology, contract, source, freshness and steward." ;
    rdfs:subClassOf cat:Asset ,
        [ a owl:Restriction ; owl:onProperty cat:describes ; owl:someValuesFrom :Dataset ] .

cat:SpecialistPackage a owl:Class ;
    rdfs:label "Specialist Package" ;
    rdfs:comment "A specialist package (a distributable bundle of skills and tools) catalogued as an asset. It carries cp:digest." ;
    rdfs:subClassOf cat:Asset .

cat:ProviderAsset a owl:Class ;
    rdfs:label "Provider Asset" ;
    rdfs:comment "A model or service provider catalogued as an asset. It carries cp:digest." ;
    rdfs:subClassOf cat:Asset .

cat:hasOntology a owl:ObjectProperty ;
    rdfs:label "has ontology" ;
    rdfs:comment "The ontology a graph asset is described by." ;
    rdfs:domain cat:KnowledgeGraph .

cat:hasContract a owl:ObjectProperty ;
    rdfs:label "has contract" ;
    rdfs:comment "The contract (pack release) a graph asset serves." ;
    rdfs:domain cat:KnowledgeGraph .

cat:hasSource a owl:ObjectProperty ;
    rdfs:label "has source" ;
    rdfs:comment "A source a graph asset is built from." ;
    rdfs:domain cat:KnowledgeGraph .

cat:hasFreshness a owl:ObjectProperty ;
    rdfs:label "has freshness" ;
    rdfs:comment "The freshness record of a graph asset." ;
    rdfs:domain cat:KnowledgeGraph .
