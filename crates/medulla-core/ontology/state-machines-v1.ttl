# spec: MEDULLA-DURABLE-KERNEL-R874.12
# The Audit machine: an operation-audit event is reserved before its effect and settled once
# into ok, error or denied. The Rust edge table AUDIT_MACHINE is the same table; the ontology
# test asserts equal edge sets.

:AuditState a owl:Class ;
    rdfs:label "Audit State" ;
    rdfs:comment "A state of the Audit machine." ;
    rdfs:subClassOf :State .

:AuditTerminalState a owl:Class ;
    rdfs:label "Audit Terminal State" ;
    rdfs:comment "A terminal state of the Audit machine." ;
    rdfs:subClassOf :TerminalState, :AuditState .

:AuditTransition a owl:Class ;
    rdfs:label "Audit Transition" ;
    rdfs:comment "A transition of the Audit machine." ;
    rdfs:subClassOf :Transition .

:AuditEvent a owl:Class ;
    rdfs:label "Audit Event" ;
    rdfs:comment "An event of the Audit machine." ;
    rdfs:subClassOf :TransitionEvent .

:AuditGuard a owl:Class ;
    rdfs:label "Audit Guard" ;
    rdfs:comment "A guard of the Audit machine; the machine has none." ;
    rdfs:subClassOf :TransitionGuard .

:AuditMachine a :StateMachine ;
    rdfs:label "Audit machine" ;
    :initialState :AuditMachine_Reserved ;
    :hasState :AuditMachine_Reserved, :AuditMachine_Ok, :AuditMachine_Error, :AuditMachine_Denied .

:AuditMachine_Reserved a :AuditState ;
    rdfs:label "Audit Reserved" ;
    :storedForm "reserved" .

:AuditMachine_Ok a :AuditTerminalState ;
    rdfs:label "Audit Ok" ;
    :storedForm "ok" .

:AuditMachine_Error a :AuditTerminalState ;
    rdfs:label "Audit Error" ;
    :storedForm "error" .

:AuditMachine_Denied a :AuditTerminalState ;
    rdfs:label "Audit Denied" ;
    :storedForm "denied" .

:AuditMachine_Event_Succeed a :AuditEvent ;
    rdfs:label "Audit Succeed" .

:AuditMachine_Event_Fail a :AuditEvent ;
    rdfs:label "Audit Fail" .

:AuditMachine_Event_Deny a :AuditEvent ;
    rdfs:label "Audit Deny" .

:AuditMachine_A01 a :AuditTransition ;
    rdfs:label "Audit A01" ;
    :edgeId "A01" ;
    :fromState :AuditMachine_Reserved ;
    :toState :AuditMachine_Ok ;
    :firedBy :AuditMachine_Event_Succeed .

:AuditMachine_A02 a :AuditTransition ;
    rdfs:label "Audit A02" ;
    :edgeId "A02" ;
    :fromState :AuditMachine_Reserved ;
    :toState :AuditMachine_Error ;
    :firedBy :AuditMachine_Event_Fail .

:AuditMachine_A03 a :AuditTransition ;
    rdfs:label "Audit A03" ;
    :edgeId "A03" ;
    :fromState :AuditMachine_Reserved ;
    :toState :AuditMachine_Denied ;
    :firedBy :AuditMachine_Event_Deny .
# spec: MEDULLA-DECISION-ENGINE-R830.5
# The Gap machine. The Rust edge table GAP_MACHINE is the same table; the ontology test asserts equal edge sets.

:GapState a owl:Class ;
    rdfs:label "Gap State" ;
    rdfs:comment "A state of the Gap machine." ;
    rdfs:subClassOf :State .

:GapTerminalState a owl:Class ;
    rdfs:label "Gap Terminal State" ;
    rdfs:comment "A terminal state of the Gap machine." ;
    rdfs:subClassOf :TerminalState, :GapState .

:GapTransition a owl:Class ;
    rdfs:label "Gap Transition" ;
    rdfs:comment "A transition of the Gap machine." ;
    rdfs:subClassOf :Transition .

:GapEvent a owl:Class ;
    rdfs:label "Gap Event" ;
    rdfs:comment "An event of the Gap machine." ;
    rdfs:subClassOf :TransitionEvent .

:GapGuard a owl:Class ;
    rdfs:label "Gap Guard" ;
    rdfs:comment "A guard of the Gap machine; the machine has none." ;
    rdfs:subClassOf :TransitionGuard .

:GapMachine a :StateMachine ;
    rdfs:label "Gap machine" ;
    :initialState :GapMachine_Open ;
    :hasState :GapMachine_Open, :GapMachine_Offered, :GapMachine_Settled .

:GapMachine_Open a :GapState ;
    rdfs:label "Gap Open" ;
    :storedForm "open" .

:GapMachine_Offered a :GapState ;
    rdfs:label "Gap Offered" ;
    :storedForm "offered" .

:GapMachine_Settled a :GapTerminalState ;
    rdfs:label "Gap Settled" ;
    :storedForm "settled" .

:GapMachine_Event_Offer a :GapEvent ;
    rdfs:label "Gap Offer" .

:GapMachine_Event_Settle a :GapEvent ;
    rdfs:label "Gap Settle" .

:GapMachine_G01 a :GapTransition ;
    rdfs:label "Gap G01" ;
    :edgeId "G01" ;
    :fromState :GapMachine_Open ;
    :toState :GapMachine_Offered ;
    :firedBy :GapMachine_Event_Offer .

:GapMachine_G02 a :GapTransition ;
    rdfs:label "Gap G02" ;
    :edgeId "G02" ;
    :fromState :GapMachine_Offered ;
    :toState :GapMachine_Settled ;
    :firedBy :GapMachine_Event_Settle .

# spec: MEDULLA-DECISION-ENGINE-R830.6
# The Loop machine. The durable loop statechart (`loop_statechart_def()` in medulla-store) is the same
# table; the ontology test asserts the Turtle transitions equal the chart transitions, in order.

:LoopState a owl:Class ;
    rdfs:label "Loop State" ;
    rdfs:comment "A state of the Loop machine." ;
    rdfs:subClassOf :State .

:LoopTerminalState a owl:Class ;
    rdfs:label "Loop Terminal State" ;
    rdfs:comment "A terminal state of the Loop machine." ;
    rdfs:subClassOf :TerminalState, :LoopState .

:LoopTransition a owl:Class ;
    rdfs:label "Loop Transition" ;
    rdfs:comment "A transition of the Loop machine." ;
    rdfs:subClassOf :Transition .

:LoopEvent a owl:Class ;
    rdfs:label "Loop Event" ;
    rdfs:comment "An event of the Loop machine." ;
    rdfs:subClassOf :TransitionEvent .

:LoopGuard a owl:Class ;
    rdfs:label "Loop Guard" ;
    rdfs:comment "A guard of the Loop machine; the chart evaluates its guards on the event payload." ;
    rdfs:subClassOf :TransitionGuard .

:LoopMachine a :StateMachine ;
    rdfs:label "Loop machine" ;
    :initialState :LoopMachine_Submitted ;
    :hasState :LoopMachine_Submitted, :LoopMachine_Running, :LoopMachine_Pending, :LoopMachine_Validating, :LoopMachine_Paused, :LoopMachine_Orphaned, :LoopMachine_Completed, :LoopMachine_Failed, :LoopMachine_Cancelled, :LoopMachine_Rejected, :LoopMachine_MaxIterationsExceeded, :LoopMachine_BudgetExceeded, :LoopMachine_WallClockExceeded, :LoopMachine_Stalled, :LoopMachine_ErrorThresholdExceeded, :LoopMachine_ExternalEventSatisfied .

:LoopMachine_Submitted a :LoopState ;
    rdfs:label "Loop Submitted" ;
    :storedForm "submitted" .

