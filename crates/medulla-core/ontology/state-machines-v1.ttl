:AnalyticsJobMachine_J09 a :AnalyticsJobTransition ;
    rdfs:label "AnalyticsJob J09" ;
    :edgeId "J09" ;
    :fromState :AnalyticsJobMachine_Submitted ;
    :toState :AnalyticsJobMachine_Cancelled ;
