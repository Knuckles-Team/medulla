    :fromState :AdmissionMachine_Applying ;
    :toState :AdmissionMachine_Applying ;
    :guardedBy :AdmissionMachine_Guard_BatchMatchesOwnerClosed ;
    :firedBy :AdmissionMachine_Event_OpenOwner .

:AdmissionMachine_A05 a :AdmissionTransition ;
    rdfs:label "Admission A05" ;
    :edgeId "A05" ;
