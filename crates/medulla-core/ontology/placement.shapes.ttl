# Deployment-placement shapes (MEDULLA-PLACEMENT-R001.5).
#
# SHACL Core only, beside core:placement@1. Every placement:Target declares
# all four facts, exactly once each: the placement decision refuses a target
# with absent facts (PlacementReason::NoFacts) rather than guessing, so a
# target that fails these shapes is one the decision cannot use.

@prefix placement: <http://knuckles.team/kg/placement#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

placement:TargetShape a sh:NodeShape ;
    sh:targetClass placement:Target ;
    sh:property [
        sh:path placement:supportsHa ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path placement:supportsVolumes ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:path placement:maxReplicas ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0
    ] ;
    sh:property [
        sh:path placement:relativeCost ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0
    ] .
