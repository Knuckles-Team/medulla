    rdfs:label "ShardDrain CommitShrink" .

:ShardDrainMachine_Event_Complete a :ShardDrainEvent ;
    rdfs:label "ShardDrain Complete" .

:ShardDrainMachine_Event_ReportPostShrinkFailure a :ShardDrainEvent ;
    rdfs:label "ShardDrain ReportPostShrinkFailure" .

:ShardDrainMachine_Event_CommitRollback a :ShardDrainEvent ;
    rdfs:label "ShardDrain CommitRollback" .

:ShardDrainMachine_Event_Restart a :ShardDrainEvent ;
    rdfs:label "ShardDrain Restart" .

:ShardDrainMachine_Guard_AdmissionNotAccepting a :ShardDrainGuard ;
    rdfs:label "ShardDrain AdmissionNotAccepting" ;
    rdfs:comment "Guard: the shard no longer accepts writes." .

:ShardDrainMachine_Guard_DrainSafe a :ShardDrainGuard ;
    rdfs:label "ShardDrain DrainSafe" ;
    rdfs:comment "Guard: admission is stopped, no work is outstanding, the writer is the planned authoritative writer and healthy voters reach the planned minimum." .

:ShardDrainMachine_Guard_VoterObservationValid a :ShardDrainGuard ;
    rdfs:label "ShardDrain VoterObservationValid" ;
    rdfs:comment "Guard: the observed voters, writer and healthy voters validate against the plan." .

:ShardDrainMachine_Guard_RollbackSafe a :ShardDrainGuard ;
    rdfs:label "ShardDrain RollbackSafe" ;
    rdfs:comment "Guard: the restored voters equal the original voters, keep the planned writer, reach quorum and the healthy-voter minimum." .

:ShardDrainMachine_DR01 a :ShardDrainTransition ;
    rdfs:label "ShardDrain DR01" ;
    :edgeId "DR01" ;
    :fromState :ShardDrainMachine_Proposed ;
    :toState :ShardDrainMachine_AdmissionStopRequested ;
    :firedBy :ShardDrainMachine_Event_RequestAdmissionStop .

:ShardDrainMachine_DR02 a :ShardDrainTransition ;
    rdfs:label "ShardDrain DR02" ;
    :edgeId "DR02" ;
    :fromState :ShardDrainMachine_AdmissionStopRequested ;
    :toState :ShardDrainMachine_AdmissionStopped ;
    :guardedBy :ShardDrainMachine_Guard_AdmissionNotAccepting ;
    :firedBy :ShardDrainMachine_Event_ConfirmAdmissionStopped .

:ShardDrainMachine_DR03 a :ShardDrainTransition ;
