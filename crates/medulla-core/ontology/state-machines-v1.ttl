:ShardDrainMachine_DR08 a :ShardDrainTransition ;
    rdfs:label "ShardDrain DR08" ;
    :edgeId "DR08" ;
    :fromState :ShardDrainMachine_RollbackRequired ;
    :toState :ShardDrainMachine_RolledBack ;
    :guardedBy :ShardDrainMachine_Guard_RollbackSafe ;
    :firedBy :ShardDrainMachine_Event_CommitRollback .

:ShardDrainMachine_DR09 a :ShardDrainTransition ;
    rdfs:label "ShardDrain DR09" ;
    :edgeId "DR09" ;
    :fromState :ShardDrainMachine_ShrinkCommitted ;
