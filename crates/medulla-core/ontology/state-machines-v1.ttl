# spec: MEDULLA-IDENTITY-R720.2
# The GovernedChange machine. The Rust edge table GOVERNED_CHANGE_MACHINE is the same table; the ontology
# test asserts equal edge sets.

:GovernedChangeState a owl:Class ;
    rdfs:label "GovernedChange State" ;
    rdfs:comment "A state of the GovernedChange machine." ;
    rdfs:subClassOf :State .

:GovernedChangeTerminalState a owl:Class ;
    rdfs:label "GovernedChange Terminal State" ;
    rdfs:comment "A terminal state of the GovernedChange machine." ;
    rdfs:subClassOf :TerminalState, :GovernedChangeState .

:GovernedChangeTransition a owl:Class ;
    rdfs:label "GovernedChange Transition" ;
    rdfs:comment "A transition of the GovernedChange machine." ;
    rdfs:subClassOf :Transition .

:GovernedChangeEvent a owl:Class ;
    rdfs:label "GovernedChange Event" ;
    rdfs:comment "A event of the GovernedChange machine." ;
    rdfs:subClassOf :TransitionEvent .

:GovernedChangeGuard a owl:Class ;
    rdfs:label "GovernedChange Guard" ;
    rdfs:comment "A guard of the GovernedChange machine." ;
    rdfs:subClassOf :TransitionGuard .

:GovernedChangeMachine a :StateMachine ;
    rdfs:label "GovernedChange machine" ;
    :initialState :GovernedChangeMachine_Proposed ;
    :hasState :GovernedChangeMachine_Proposed, :GovernedChangeMachine_Approved, :GovernedChangeMachine_Consumed, :GovernedChangeMachine_Revoked, :GovernedChangeMachine_Expired .

:GovernedChangeMachine_Proposed a :GovernedChangeState ;
    rdfs:label "GovernedChange Proposed" ;
    :storedForm "proposed" .

:GovernedChangeMachine_Approved a :GovernedChangeState ;
    rdfs:label "GovernedChange Approved" ;
    :storedForm "approved" .

:GovernedChangeMachine_Consumed a :GovernedChangeTerminalState ;
    rdfs:label "GovernedChange Consumed" ;
    :storedForm "consumed" .

:GovernedChangeMachine_Revoked a :GovernedChangeTerminalState ;
    rdfs:label "GovernedChange Revoked" ;
    :storedForm "revoked" .

:GovernedChangeMachine_Expired a :GovernedChangeTerminalState ;
    rdfs:label "GovernedChange Expired" ;
    :storedForm "expired" .

:GovernedChangeMachine_Event_Approve a :GovernedChangeEvent ;
    rdfs:label "GovernedChange Approve" .

:GovernedChangeMachine_Event_Revoke a :GovernedChangeEvent ;
    rdfs:label "GovernedChange Revoke" .

:GovernedChangeMachine_Event_Lapse a :GovernedChangeEvent ;
    rdfs:label "GovernedChange Lapse" .

:GovernedChangeMachine_Event_Consume a :GovernedChangeEvent ;
    rdfs:label "GovernedChange Consume" .

:GovernedChangeMachine_Guard_DigestMatchesApproverAuthorized a :GovernedChangeGuard ;
    rdfs:label "GovernedChange DigestMatchesApproverAuthorized" ;
    rdfs:comment "Guard: the digest matches and the approver is authorized." .

:GovernedChangeMachine_Guard_ActorAuthorized a :GovernedChangeGuard ;
    rdfs:label "GovernedChange ActorAuthorized" ;
    rdfs:comment "Guard: the actor is authorized." .

:GovernedChangeMachine_Guard_WindowElapsed a :GovernedChangeGuard ;
    rdfs:label "GovernedChange WindowElapsed" ;
    rdfs:comment "Guard: the window has elapsed." .

:GovernedChangeMachine_Guard_DigestMatchesWindowLive a :GovernedChangeGuard ;
    rdfs:label "GovernedChange DigestMatchesWindowLive" ;
    rdfs:comment "Guard: the digest matches and the approval window is live." .

:GovernedChangeMachine_G01 a :GovernedChangeTransition ;
    rdfs:label "GovernedChange G01" ;
    :edgeId "G01" ;
    :fromState :GovernedChangeMachine_Proposed ;
    :toState :GovernedChangeMachine_Approved ;
    :guardedBy :GovernedChangeMachine_Guard_DigestMatchesApproverAuthorized ;
    :firedBy :GovernedChangeMachine_Event_Approve .

:GovernedChangeMachine_G02 a :GovernedChangeTransition ;
    rdfs:label "GovernedChange G02" ;
    :edgeId "G02" ;
    :fromState :GovernedChangeMachine_Proposed ;
    :toState :GovernedChangeMachine_Revoked ;
    :guardedBy :GovernedChangeMachine_Guard_ActorAuthorized ;
    :firedBy :GovernedChangeMachine_Event_Revoke .

:GovernedChangeMachine_G03 a :GovernedChangeTransition ;
    rdfs:label "GovernedChange G03" ;
    :edgeId "G03" ;
    :fromState :GovernedChangeMachine_Proposed ;
    :toState :GovernedChangeMachine_Expired ;
    :guardedBy :GovernedChangeMachine_Guard_WindowElapsed ;
    :firedBy :GovernedChangeMachine_Event_Lapse .

:GovernedChangeMachine_G04 a :GovernedChangeTransition ;
    rdfs:label "GovernedChange G04" ;
    :edgeId "G04" ;
    :fromState :GovernedChangeMachine_Approved ;
    :toState :GovernedChangeMachine_Consumed ;
    :guardedBy :GovernedChangeMachine_Guard_DigestMatchesWindowLive ;
    :firedBy :GovernedChangeMachine_Event_Consume .

:GovernedChangeMachine_G05 a :GovernedChangeTransition ;
    rdfs:label "GovernedChange G05" ;
    :edgeId "G05" ;
    :fromState :GovernedChangeMachine_Approved ;
    :toState :GovernedChangeMachine_Revoked ;
    :guardedBy :GovernedChangeMachine_Guard_ActorAuthorized ;
    :firedBy :GovernedChangeMachine_Event_Revoke .

:GovernedChangeMachine_G06 a :GovernedChangeTransition ;
    rdfs:label "GovernedChange G06" ;
    :edgeId "G06" ;
    :fromState :GovernedChangeMachine_Approved ;
    :toState :GovernedChangeMachine_Expired ;
    :guardedBy :GovernedChangeMachine_Guard_WindowElapsed ;
    :firedBy :GovernedChangeMachine_Event_Lapse .

# spec: MEDULLA-IDENTITY-R721.2
# The UserStatus machine. The Rust edge table USER_STATUS_MACHINE is the same table; the ontology
# test asserts equal edge sets.

:UserStatusState a owl:Class ;
    rdfs:label "UserStatus State" ;
    rdfs:comment "A state of the UserStatus machine." ;
    rdfs:subClassOf :State .

:UserStatusTerminalState a owl:Class ;
    rdfs:label "UserStatus Terminal State" ;
    rdfs:comment "A terminal state of the UserStatus machine." ;
    rdfs:subClassOf :TerminalState, :UserStatusState .

:UserStatusTransition a owl:Class ;
    rdfs:label "UserStatus Transition" ;
    rdfs:comment "A transition of the UserStatus machine." ;
    rdfs:subClassOf :Transition .

:UserStatusEvent a owl:Class ;
    rdfs:label "UserStatus Event" ;
    rdfs:comment "A event of the UserStatus machine." ;
    rdfs:subClassOf :TransitionEvent .

:UserStatusGuard a owl:Class ;
    rdfs:label "UserStatus Guard" ;
    rdfs:comment "A guard of the UserStatus machine." ;
    rdfs:subClassOf :TransitionGuard .

:UserStatusMachine a :StateMachine ;
    rdfs:label "UserStatus machine" ;
    :initialState :UserStatusMachine_Active ;
    :hasState :UserStatusMachine_Active, :UserStatusMachine_Disabled, :UserStatusMachine_PendingReset, :UserStatusMachine_PendingVerification, :UserStatusMachine_Deprovisioned .

:UserStatusMachine_Active a :UserStatusState ;
    rdfs:label "UserStatus Active" ;
    :storedForm "active" .

:UserStatusMachine_Disabled a :UserStatusState ;
    rdfs:label "UserStatus Disabled" ;
    :storedForm "disabled" .

:UserStatusMachine_PendingReset a :UserStatusState ;
    rdfs:label "UserStatus PendingReset" ;
    :storedForm "pending_reset" .

:UserStatusMachine_PendingVerification a :UserStatusState ;
    rdfs:label "UserStatus PendingVerification" ;
    :storedForm "pending_verification" .

:UserStatusMachine_Deprovisioned a :UserStatusState ;
    rdfs:label "UserStatus Deprovisioned" ;
    :storedForm "deprovisioned" .

:UserStatusMachine_Event_Disable a :UserStatusEvent ;
    rdfs:label "UserStatus Disable" .

:UserStatusMachine_Event_Enable a :UserStatusEvent ;
    rdfs:label "UserStatus Enable" .

:UserStatusMachine_Event_RequireReset a :UserStatusEvent ;
    rdfs:label "UserStatus RequireReset" .

:UserStatusMachine_Event_CompleteReset a :UserStatusEvent ;
    rdfs:label "UserStatus CompleteReset" .

:UserStatusMachine_Event_Verify a :UserStatusEvent ;
    rdfs:label "UserStatus Verify" .

:UserStatusMachine_Event_Deprovision a :UserStatusEvent ;
    rdfs:label "UserStatus Deprovision" .

:UserStatusMachine_Event_Reprovision a :UserStatusEvent ;
    rdfs:label "UserStatus Reprovision" .

:UserStatusMachine_Guard_NotLastActiveAdministrator a :UserStatusGuard ;
    rdfs:label "UserStatus NotLastActiveAdministrator" ;
    rdfs:comment "Guard: the principal is not the last active administrator." .

:UserStatusMachine_Guard_NewCredentialSet a :UserStatusGuard ;
