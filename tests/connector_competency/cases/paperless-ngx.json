      "sources": [
        "paperless-ngx-mcp"
      ],
      "optional_sources": [],
      "source_kinds": {
        "paperless-ngx-mcp": "mcp_tool"
      },
      "columns": [
        "document",
        "missing_correspondent",
        "missing_due_date"
      ],
      "min_rows": 1,
      "recordings": [
        "paperless-ngx-mcp/single.json"
      ]
    },
    {
      "id": "paperless-ngx.q2",
      "kind": "cross",
