@prefix : <https://knuckles-team.github.io/ontology/core#> .
@prefix cat: <https://knuckles-team.github.io/ontology/catalog#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix cp: <https://knuckles-team.github.io/ontology/connector-pack#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Connector-backed catalog assets name exactly one connector (MEDULLA-TYPED-PACKS-R106.1).
# AgentAsset is an Agent Library asset governed by R108 and is intentionally
# outside this connector requirement.
cat:ConnectorAssetShape a sh:NodeShape ;
    sh:targetClass cat:ToolAsset, cat:PromptAsset, cat:SkillAsset, cat:DataResource, cat:Field ;
    sh:property [ sh:path cp:ofConnector ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ],
    [ sh:path cp:digest ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] .

# A data resource serves exactly one ontology class.
cat:DataResourceShape a sh:NodeShape ;
    sh:targetClass cat:DataResource ;
    sh:property [ sh:path cp:servesClass ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

# A data resource without its connector is refused as RESOURCE_UNOWNED (MEDULLA-TYPED-PACKS-R106.4).
cat:ResourceConnectorShape a sh:NodeShape ;
    sh:targetClass cat:DataResource ;
    sh:property [ sh:path cp:ofConnector ; sh:minCount 1 ] .

# The class a resource serves exists in the pack ontology or the parent graph; one that does not
# is refused as UNRESOLVED_REFERENCE (MEDULLA-TYPED-PACKS-R106.4).
cat:ServesClassShape a sh:NodeShape ;
    sh:targetClass cat:DataResource ;
    sh:property [ sh:path cp:servesClass ; sh:class <http://www.w3.org/2002/07/owl#Class> ] .

# A field names exactly one ontology property.
cat:FieldShape a sh:NodeShape ;
    sh:targetClass cat:Field ;
    sh:property [ sh:path cp:servesProperty ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

# A system-prompt candidate names at least one task it frames (MEDULLA-DECISION-ENGINE-R814.4).
:PromptCandidateShape a sh:NodeShape ;
    sh:targetClass :PromptCandidate ;
    sh:property [ sh:path :systemPromptFor ; sh:minCount 1 ; sh:nodeKind sh:IRI ] .

# A stewardship assignment names one asset, one principal and one catalog role.
cat:StewardshipAssignmentShape a sh:NodeShape ;
    sh:targetClass cat:StewardshipAssignment ;
    sh:property [ sh:path cat:assignedTo ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ],
    [ sh:path cat:principal ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ],
    [ sh:path cat:role ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( cat:owner cat:steward cat:custodian ) ] .

# A change request names its target, the proposed digest and its state.
cat:ChangeRequestShape a sh:NodeShape ;
    sh:targetClass cat:ChangeRequest ;
    sh:property [ sh:path cat:target ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ],
    [ sh:path cat:proposedDigest ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ],
    [ sh:path cat:state ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "open" "approved" "rejected" "applied" ) ] .

# A certification names the asset, its level, the certifier and its expiry.
cat:CertificationShape a sh:NodeShape ;
    sh:targetClass cat:Certification ;
    sh:property [ sh:path cat:certifiedAsset ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ],
    [ sh:path cat:level ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ],
    [ sh:path cat:certifiedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ],
    [ sh:path cat:expiresAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:nonNegativeInteger ] .

# A lineage edge names both ends and a closed hop type.
cat:LineageEdgeShape a sh:NodeShape ;
    sh:targetClass cat:LineageEdge ;
    sh:property [ sh:path cat:from ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ],
    [ sh:path cat:to ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ],
    [ sh:path cat:hop ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
      sh:in ( "connector" "operation" "resource" "field" "ingest" "transform" ) ] .

# Each lineage edge node is paired with the direct cat:lineageTo edge between its ends
# (MEDULLA-TYPED-PACKS-R106.2). The unpaired edge is refused as LINEAGE_EDGE_UNPAIRED (R106.4).
# The paired edge is looked up with OPTIONAL: the constraint dialect declines EXISTS.
cat:LineageEdgePairShape a sh:NodeShape ;
    sh:targetClass cat:LineageEdge ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A lineage edge needs the direct cat:lineageTo edge from its cat:from to its cat:to." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://knuckles-team.github.io/ontology/catalog#from> ?from ;
                      <https://knuckles-team.github.io/ontology/catalog#to> ?to .
                OPTIONAL {
                    ?from <https://knuckles-team.github.io/ontology/catalog#lineageTo> ?to .
                    ?from <https://knuckles-team.github.io/ontology/catalog#lineageTo> ?paired .
                }
                FILTER(!BOUND(?paired))
            }
        """ ;
    ] .

# Each connector-backed asset has a stewardship assignment or carries the owner_missing flag
# (MEDULLA-TYPED-PACKS-R106.2). A pack with no declared owner imports flagged, never refused.
cat:ConnectorAssetOwnerShape a sh:NodeShape ;
    sh:targetClass cat:ToolAsset, cat:PromptAsset, cat:SkillAsset, cat:DataResource, cat:Field ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A connector asset needs a cat:StewardshipAssignment or the owner_missing flag." ;
        sh:select """
            SELECT $this WHERE {
                OPTIONAL { ?assignment <https://knuckles-team.github.io/ontology/catalog#assignedTo> $this . }
                OPTIONAL {
                    $this <https://knuckles-team.github.io/ontology/catalog#flag> "owner_missing" .
                    $this <https://knuckles-team.github.io/ontology/catalog#flag> ?flagged .
                }
                FILTER(!BOUND(?assignment) && !BOUND(?flagged))
            }
        """ ;
    ] .

# A glossary term has one preferred label and names at least one class.
cat:GlossaryTermShape a sh:NodeShape ;
    sh:targetClass cat:CatalogGlossaryTerm ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:maxCount 1 ],
    [ sh:path cat:definesClass ; sh:nodeKind sh:IRI ],
    [ sh:path :definesAsset ; sh:nodeKind sh:IRI ],
    [ sh:path dct:isReplacedBy ; sh:nodeKind sh:IRI ] ;
    # A term defines a class or an asset (MEDULLA-TYPED-PACKS-R801.1).
    sh:or ( [ sh:path cat:definesClass ; sh:minCount 1 ] [ sh:path :definesAsset ; sh:minCount 1 ] ) .

# The asset flag vocabulary is closed.
cat:AssetFlagShape a sh:NodeShape ;
    sh:targetClass cat:ToolAsset, cat:PromptAsset, cat:SkillAsset, cat:DataResource, cat:Field,
        cat:SchemaAsset, cat:KeyAsset, cat:IndexAsset ;
    sh:property [ sh:path cat:flag ; sh:datatype xsd:string ; sh:in ( "owner_missing" "deprecated" "field_unmapped" ) ] .

# A key is primary, foreign or unique, and covers at least one field of one resource
# (MEDULLA-TYPED-PACKS-R108.7).
cat:KeyAssetShape a sh:NodeShape ;
    sh:targetClass cat:KeyAsset ;
    sh:property [ sh:path cat:keyKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "primary" "foreign" "unique" ) ],
    [ sh:path cat:keyOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ],
    [ sh:path cat:keyField ; sh:minCount 1 ; sh:nodeKind sh:IRI ] .

# An index covers at least one field of one resource (MEDULLA-TYPED-PACKS-R108.7).
cat:IndexAssetShape a sh:NodeShape ;
    sh:targetClass cat:IndexAsset ;
    sh:property [ sh:path cat:indexOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ],
    [ sh:path cat:indexField ; sh:minCount 1 ; sh:nodeKind sh:IRI ] .

# Each family asset names one owner or carries the owner_missing flag
# (MEDULLA-TYPED-PACKS-R108.1).
cat:FamilyAssetOwnerShape a sh:NodeShape ;
    sh:targetClass cat:AgentTemplateAsset, cat:A2AAgentAsset, cat:AgentVersion, cat:OrgUnit,
        cat:TeamAsset, cat:PersonAsset, cat:RoleAsset, cat:BusinessDomain, cat:Product, cat:ServiceAsset,
        cat:WorkflowDefinitionAsset, cat:WorkflowRun, cat:WorkflowStepAsset, cat:KnowledgeGraph,
        cat:SpecialistPackage, cat:ProviderAsset, cat:DashboardAsset, cat:ReportAsset, cat:Article ;
    sh:property [ sh:path cat:flag ; sh:datatype xsd:string ; sh:in ( "owner_missing" "deprecated" "field_unmapped" ) ],
    [ sh:path cat:hasOwner ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:or ( [ sh:path cat:hasOwner ; sh:minCount 1 ]
            [ sh:path cat:flag ; sh:hasValue "owner_missing" ] ) .

# Specialist packages and providers carry a SHA-256 digest.
cat:DigestedAssetShape a sh:NodeShape ;
    sh:targetClass cat:SpecialistPackage, cat:ProviderAsset ;
    sh:property [ sh:path cp:digest ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^[0-9a-f]{64}$" ] .

# A dashboard asset carries one revision number (MEDULLA-TYPED-PACKS-R109.1).
cat:DashboardAssetShape a sh:NodeShape ;
    sh:targetClass cat:DashboardAsset ;
    sh:property [ sh:path cat:revision ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:nonNegativeInteger ] .

# A report template names at least one parameter (MEDULLA-TYPED-PACKS-R108.14).
cat:ReportTemplateShape a sh:NodeShape ;
    sh:targetClass cat:ReportTemplate ;
    sh:property [ sh:path cat:parameterName ; sh:minCount 1 ; sh:datatype xsd:string ] .

# A model asset has one registry reference, at most one input and one output schema of at most
# 65536 bytes, evaluation results of at most 4096 bytes and at most one model profile
# (MEDULLA-TYPED-PACKS-R108.15).
cat:ModelAssetShape a sh:NodeShape ;
    sh:targetClass cat:ModelAsset ;
    sh:property [ sh:path cat:modelRegistryRef ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:anyURI ],
    [ sh:path cat:modelInputSchema ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:maxLength 65536 ],
    [ sh:path cat:modelOutputSchema ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:maxLength 65536 ],
    [ sh:path cat:trainedOn ; sh:class cat:DataResource ],
    [ sh:path cat:evaluationResult ; sh:datatype xsd:string ; sh:maxLength 4096 ],
    [ sh:path cat:hasModelProfile ; sh:maxCount 1 ; sh:class :ModelProfile ] .

# An article has one author, one version and one status of the review lifecycle
# (MEDULLA-TYPED-PACKS-R108.13).
cat:ArticleShape a sh:NodeShape ;
    sh:targetClass cat:Article ;
    sh:property [ sh:path cat:author ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ],
    [ sh:path cat:articleVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:nonNegativeInteger ],
    [ sh:path cat:articleStatus ; sh:minCount 1 ; sh:maxCount 1 ;
      sh:in ( "draft" "in_review" "approved" "deprecated" ) ],
    [ sh:path cat:aboutAsset ; sh:nodeKind sh:IRI ],
    [ sh:path cat:inBusinessDomain ; sh:nodeKind sh:IRI ] .

# An annotation attaches to one asset and has an author, a time and a revision; a rating is an
# integer from 1 to 5 (MEDULLA-TYPED-PACKS-R108.12).
cat:AnnotationShape a sh:NodeShape ;
    sh:targetClass cat:Annotation ;
    sh:property [ sh:path cat:annotates ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ],
    [ sh:path cat:annotationKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( "comment" "tag" "rating" ) ],
    [ sh:path cat:annotationAuthor ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ],
    [ sh:path cat:annotatedAtMs ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:nonNegativeInteger ],
    [ sh:path cat:annotationRevision ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:nonNegativeInteger ],
    [ sh:path cat:rating ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:maxInclusive 5 ],
    [ sh:path cat:inReplyTo ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

# A metric has one non-blank name and unit, one business domain and one formula of at most
# 4096 bytes (MEDULLA-TYPED-PACKS-R108.11). Term resolution is the catalog write guard's.
cat:MetricShape a sh:NodeShape ;
    sh:targetClass cat:Metric ;
    sh:property [ sh:path cat:metricName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "\\S" ],
    [ sh:path cat:metricDomain ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ],
    [ sh:path cat:metricFormula ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
      sh:maxLength 4096 ],
    [ sh:path cat:metricUnit ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
      sh:pattern "\\S" ] .
