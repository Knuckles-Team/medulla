    rdfs:comment "A guard of the IndexRef machine; this machine has none." ;
    rdfs:subClassOf :TransitionGuard .

:IndexRefMachine a :StateMachine ;
    rdfs:label "IndexRef machine" ;
    :initialState :IndexRefMachine_Live ;
    :hasState :IndexRefMachine_Live, :IndexRefMachine_Deleted .

:IndexRefMachine_Live a :IndexRefState ;
    rdfs:label "IndexRef Live" ;
    :storedForm "live" .

:IndexRefMachine_Deleted a :IndexRefTerminalState ;
    rdfs:label "IndexRef Deleted" ;
    :storedForm "deleted" .

:IndexRefMachine_Event_Delete a :IndexRefEvent ;
    rdfs:label "IndexRef Delete" .

:IndexRefMachine_R01 a :IndexRefTransition ;
    rdfs:label "IndexRef R01" ;
    :edgeId "R01" ;
    :fromState :IndexRefMachine_Live ;
    :toState :IndexRefMachine_Deleted ;
    :firedBy :IndexRefMachine_Event_Delete .

