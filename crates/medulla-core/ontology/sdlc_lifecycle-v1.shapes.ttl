@prefix : <https://knuckles-team.github.io/ontology/core#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# SDLC-lifecycle ABox shapes: the records the gitlab/github/repository-manager
# connectors write under the sdlc_lifecycle module. Closed vocabularies are
# sh:in lists so a typo is a violation, not a new state (precedent:
# finance-v1.shapes.ttl).

:CodeChangeProposalShape a sh:NodeShape ;
    sh:description "A code change proposal carries at most one state from the closed open/merged/closed vocabulary." ;
    sh:name "Code Change Proposal Shape" ;
    sh:property [ sh:in ( "open" "merged" "closed" ) ;
            sh:maxCount 1 ;
            sh:message "proposalState is open, merged or closed." ;
            sh:path :proposalState ] ;
    sh:targetClass :CodeChangeProposal .

:WorktreeShape a sh:NodeShape ;
    sh:description "A worktree carries at most one state from the closed active/stale/dangling/merged vocabulary." ;
    sh:name "Worktree Shape" ;
    sh:property [ sh:in ( "active" "stale" "dangling" "merged" ) ;
            sh:maxCount 1 ;
            sh:message "worktreeState is active, stale, dangling or merged." ;
            sh:path :worktreeState ] ;
    sh:targetClass :Worktree .

:IterationCycleShape a sh:NodeShape ;
    sh:description "An iteration cycle carries at most one state from the closed active/upcoming/completed vocabulary." ;
    sh:name "Iteration Cycle Shape" ;
    sh:property [ sh:in ( "active" "upcoming" "completed" ) ;
            sh:maxCount 1 ;
            sh:message "cycleState is active, upcoming or completed." ;
            sh:path :cycleState ] ;
    sh:targetClass :IterationCycle .

:PipelineRunShape a sh:NodeShape ;
    sh:description "A pipeline run carries at most one latest status from the closed success/failed/running/cancelled vocabulary." ;
    sh:name "Pipeline Run Shape" ;
    sh:property [ sh:in ( "success" "failed" "running" "cancelled" ) ;
            sh:maxCount 1 ;
            sh:message "pipelineStatus is success, failed, running or cancelled." ;
            sh:path :pipelineStatus ] ;
    sh:targetClass :PipelineRun .
