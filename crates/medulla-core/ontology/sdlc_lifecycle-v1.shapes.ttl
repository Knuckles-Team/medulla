@prefix : <https://knuckles-team.github.io/ontology/core#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# SDLC-lifecycle ABox shapes: the records the gitlab/github/repository-manager
# connectors write under the sdlc_lifecycle module. Closed vocabularies are
# sh:in lists so a typo is a violation, not a new state (precedent:
# finance-v1.shapes.ttl).

:CodeChangeProposalShape a sh:NodeShape ;
    sh:description "A code change proposal carries at most one state from the closed open/merged/closed vocabulary." ;
    sh:name "Code Change Proposal Shape" ;
    sh:property [ sh:in ( "open" "merged" "closed" ) ;
            sh:maxCount 1 ;
            sh:message "proposalState is open, merged or closed." ;
            sh:path :proposalState ] ;
    sh:targetClass :CodeChangeProposal .

:WorktreeShape a sh:NodeShape ;
    sh:description "A worktree carries at most one state from the closed active/stale/dangling/merged vocabulary." ;
    sh:name "Worktree Shape" ;
    sh:property [ sh:in ( "active" "stale" "dangling" "merged" ) ;
            sh:maxCount 1 ;
            sh:message "worktreeState is active, stale, dangling or merged." ;
            sh:path :worktreeState ] ;
    sh:targetClass :Worktree .

:IterationCycleShape a sh:NodeShape ;
    sh:description "An iteration cycle carries at most one state from the closed active/upcoming/completed vocabulary." ;
    sh:name "Iteration Cycle Shape" ;
    sh:property [ sh:in ( "active" "upcoming" "completed" ) ;
            sh:maxCount 1 ;
            sh:message "cycleState is active, upcoming or completed." ;
            sh:path :cycleState ] ;
    sh:targetClass :IterationCycle .

:PipelineRunShape a sh:NodeShape ;
    sh:description "A pipeline run carries at most one latest status from the closed success/failed/running/cancelled vocabulary." ;
    sh:name "Pipeline Run Shape" ;
    sh:property [ sh:in ( "success" "failed" "running" "cancelled" ) ;
            sh:maxCount 1 ;
            sh:message "pipelineStatus is success, failed, running or cancelled." ;
            sh:path :pipelineStatus ] ;
    sh:targetClass :PipelineRun .

# MEDULLA-SDLC-R019.1: one shape per delivery class; each constrains only the
# types of the delivery vocabulary properties.

:DeliveryShape a sh:NodeShape ;
    sh:description "A Delivery carries only well-typed delivery properties." ;
    sh:name "Delivery Shape" ;
    sh:property [ sh:path :deliversRequirement ;
            sh:class :Requirement ;
            sh:message "deliversRequirement is a requirement." ] ,
        [ sh:path :opensProposal ;
            sh:class :CodeChangeProposal ;
            sh:message "opensProposal is a code change proposal." ] ,
        [ sh:path :followsProposal ;
            sh:class :CodeChangeProposal ;
            sh:message "followsProposal is a code change proposal." ] ,
        [ sh:path :deliveryOutcome ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "deliveryOutcome is at most one string." ] ;
    sh:targetClass :Delivery .

:DeliveryAssignmentShape a sh:NodeShape ;
    sh:description "A DeliveryAssignment carries only well-typed delivery properties." ;
    sh:name "DeliveryAssignment Shape" ;
    sh:property [ sh:path :assignedRun ;
            sh:class :RunTrace ;
            sh:message "assignedRun is a run trace." ] ,
        [ sh:path :assignmentOf ;
            sh:nodeKind sh:IRI ;
            sh:maxCount 1 ;
            sh:message "assignmentOf is at most one IRI." ] ;
    sh:targetClass :DeliveryAssignment .

:FeedbackEventShape a sh:NodeShape ;
    sh:description "A FeedbackEvent carries only well-typed delivery properties." ;
    sh:name "FeedbackEvent Shape" ;
    sh:property [ sh:path :feedbackKind ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "feedbackKind is at most one string." ] ,
        [ sh:path :feedbackFor ;
            sh:nodeKind sh:IRI ;
            sh:message "feedbackFor is an IRI." ] ,
        [ sh:path :feedbackOn ;
            sh:nodeKind sh:IRI ;
            sh:message "feedbackOn is an IRI." ] ;
    sh:targetClass :FeedbackEvent .

:ReviewShape a sh:NodeShape ;
    sh:description "A Review carries only well-typed delivery properties." ;
    sh:name "Review Shape" ;
    sh:property [ sh:path :reviewerKind ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "reviewerKind is at most one string." ] ,
        [ sh:path :reviewOf ;
            sh:nodeKind sh:IRI ;
            sh:message "reviewOf is an IRI." ] ;
    sh:targetClass :Review .

:MergeArmingShape a sh:NodeShape ;
    sh:description "A MergeArming carries only well-typed delivery properties." ;
    sh:name "MergeArming Shape" ;
    sh:property [ sh:path :armedAtHead ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "armedAtHead is at most one string." ] ,
        [ sh:path :armingOf ;
            sh:nodeKind sh:IRI ;
            sh:message "armingOf is an IRI." ] ;
    sh:targetClass :MergeArming .

:DeliveryReportShape a sh:NodeShape ;
    sh:description "A DeliveryReport carries only well-typed delivery properties." ;
    sh:name "DeliveryReport Shape" ;
    sh:property [ sh:path :reportState ;
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "reportState is at most one string." ] ,
        [ sh:path :reportOf ;
            sh:nodeKind sh:IRI ;
            sh:message "reportOf is an IRI." ] ;
    sh:targetClass :DeliveryReport .

:DeliveryMandateShape a sh:NodeShape ;
    sh:description "A DeliveryMandate carries only well-typed delivery properties." ;
    sh:name "DeliveryMandate Shape" ;
    sh:property [ sh:path :mandateOf ;
            sh:nodeKind sh:IRI ;
            sh:message "mandateOf is an IRI." ] ;
    sh:targetClass :DeliveryMandate .

:ReviewThreadShape a sh:NodeShape ;
    sh:description "A ReviewThread carries only well-typed delivery properties." ;
    sh:name "ReviewThread Shape" ;
    sh:property [ sh:path :threadOf ;
            sh:nodeKind sh:IRI ;
            sh:message "threadOf is an IRI." ] ;
    sh:targetClass :ReviewThread .
