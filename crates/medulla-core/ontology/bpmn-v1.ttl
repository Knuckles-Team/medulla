@prefix : <https://knuckles-team.github.io/ontology/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# BPMN 2.0 flow-node classes (MEDULLA-ORCH-VOCAB-R014.2) and the canonical
# step kind and gate each one carries (MEDULLA-ORCH-VOCAB-R014.9,
# MEDULLA-CQ-ORCH-R701.7). Process compilation reads :dagNodeKind and
# :canonicalGateKind from here; no class name is mapped in code. A complex
# gateway carries no :dagNodeKind and is refused as unmapped.

<https://knuckles-team.github.io/ontology/bpmn> a owl:Ontology ;
    rdfs:label "BPMN 2.0 element classes" .

# spec: MEDULLA-TYPED-PACKS-R105.10.1 — the abstract BPMN 2.0 element classes, so every
# flow-node class reaches the BFO root. They carry no :dagNodeKind, so process
# compilation maps none of them.
:BpmnFlowElement a owl:Class ;
    rdfs:label "BPMN FlowElement" ;
    rdfs:comment "An element of a BPMN 2.0 process definition: a flow node or a sequence flow." ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000031> .

:BpmnFlowNode a owl:Class ;
    rdfs:label "BPMN FlowNode" ;
    rdfs:comment "A BPMN 2.0 flow element that sequence flows connect: an activity, an event or a gateway." ;
    rdfs:subClassOf :BpmnFlowElement, :TaskStep .

:BpmnActivity a owl:Class ;
    rdfs:label "BPMN Activity" ;
    rdfs:comment "A BPMN 2.0 flow node that performs work: a task, a sub-process or a call activity." ;
    rdfs:subClassOf :BpmnFlowNode, :ProcessStep .

:BpmnTask a owl:Class ;
    rdfs:label "BPMN Task" ;
    :dagNodeKind "agent" ;
    rdfs:subClassOf :BpmnActivity .

:BpmnUserTask a owl:Class ;
    rdfs:label "BPMN UserTask" ;
    rdfs:subClassOf :BpmnTask ;
    :dagNodeKind "human" .

:BpmnManualTask a owl:Class ;
    rdfs:label "BPMN ManualTask" ;
    rdfs:subClassOf :BpmnTask ;
    :dagNodeKind "human" .

:BpmnServiceTask a owl:Class ;
    rdfs:label "BPMN ServiceTask" ;
    rdfs:subClassOf :BpmnTask ;
    :dagNodeKind "agent" .

:BpmnScriptTask a owl:Class ;
    rdfs:label "BPMN ScriptTask" ;
    rdfs:subClassOf :BpmnTask ;
    :dagNodeKind "agent" .

:BpmnSendTask a owl:Class ;
    rdfs:label "BPMN SendTask" ;
    rdfs:subClassOf :BpmnTask ;
    :dagNodeKind "agent" .

:BpmnReceiveTask a owl:Class ;
    rdfs:label "BPMN ReceiveTask" ;
    rdfs:subClassOf :BpmnTask ;
    :dagNodeKind "wait" .

:BpmnBusinessRuleTask a owl:Class ;
    rdfs:label "BPMN BusinessRuleTask" ;
    rdfs:subClassOf :BpmnTask ;
    :dagNodeKind "decision" .

:BpmnSubProcess a owl:Class ;
    rdfs:label "BPMN SubProcess" ;
    :dagNodeKind "call" ;
    rdfs:subClassOf :BpmnActivity .

:BpmnCallActivity a owl:Class ;
    rdfs:label "BPMN CallActivity" ;
    :dagNodeKind "call" ;
    rdfs:subClassOf :BpmnActivity .

:BpmnGateway a owl:Class ;
    rdfs:label "BPMN Gateway" ;
    rdfs:subClassOf :BpmnFlowNode, :ProcessGate .

:BpmnExclusiveGateway a owl:Class ;
    rdfs:label "BPMN ExclusiveGateway" ;
    rdfs:subClassOf :BpmnGateway ;
    :dagNodeKind "branch" ;
    :canonicalGateKind "xor" .

:BpmnParallelGateway a owl:Class ;
    rdfs:label "BPMN ParallelGateway" ;
    rdfs:subClassOf :BpmnGateway ;
    :dagNodeKind "fork" ;
    :canonicalGateKind "and" .

:BpmnInclusiveGateway a owl:Class ;
    rdfs:label "BPMN InclusiveGateway" ;
    rdfs:subClassOf :BpmnGateway ;
    :dagNodeKind "fork" ;
    :canonicalGateKind "or" .

:BpmnEventBasedGateway a owl:Class ;
    rdfs:label "BPMN EventBasedGateway" ;
    rdfs:subClassOf :BpmnGateway ;
    :dagNodeKind "wait" ;
    :canonicalGateKind "xor" .

:BpmnComplexGateway a owl:Class ;
    rdfs:label "BPMN ComplexGateway" ;
    rdfs:subClassOf :BpmnGateway .

:BpmnEvent a owl:Class ;
    rdfs:label "BPMN Event" ;
    rdfs:subClassOf :BpmnFlowNode, :ProcessEventNode .

:BpmnStartEvent a owl:Class ;
    rdfs:label "BPMN StartEvent" ;
    rdfs:subClassOf :BpmnEvent ;
    :dagNodeKind "start" .

:BpmnEndEvent a owl:Class ;
    rdfs:label "BPMN EndEvent" ;
    rdfs:subClassOf :BpmnEvent ;
    :dagNodeKind "end" .

:BpmnIntermediateCatchEvent a owl:Class ;
    rdfs:label "BPMN IntermediateCatchEvent" ;
    rdfs:subClassOf :BpmnEvent ;
    :dagNodeKind "wait" .

:BpmnIntermediateThrowEvent a owl:Class ;
    rdfs:label "BPMN IntermediateThrowEvent" ;
    rdfs:subClassOf :BpmnEvent ;
    :dagNodeKind "agent" .

:BpmnBoundaryEvent a owl:Class ;
    rdfs:label "BPMN BoundaryEvent" ;
    rdfs:subClassOf :BpmnEvent ;
    :dagNodeKind "boundary" .

# MEDULLA-ORCH-VOCAB-R014.2: the flow, lane, model and event definition classes, each
# under one core process term of orchestration-v1.ttl, and the properties that keep
# the source id and the fragments the graph does not model.
:BpmnSequenceFlow a owl:Class ;
    rdfs:label "BPMN SequenceFlow" ;
    rdfs:comment "A BPMN 2.0 sequence flow between two flow nodes." ;
    rdfs:subClassOf :ProcessSequenceFlow .

:BpmnLane a owl:Class ;
    rdfs:label "BPMN Lane" ;
    rdfs:comment "A BPMN 2.0 lane: the role or agent kind that performs its flow nodes." ;
    rdfs:subClassOf :ProcessLane .

:BpmnProcess a owl:Class ;
    rdfs:label "BPMN Process" ;
    rdfs:comment "A BPMN 2.0 process: its flow nodes, flows and lanes." ;
    rdfs:subClassOf :ProcessModel .

:BpmnDefinitions a owl:Class ;
    rdfs:label "BPMN Definitions" ;
    rdfs:comment "One BPMN 2.0 document: the definitions root that holds processes." ;
    rdfs:subClassOf :ProcessModel .

:BpmnEventDefinition a owl:Class ;
    rdfs:label "BPMN EventDefinition" ;
    rdfs:comment "The trigger or effect of a BPMN 2.0 event, linked by :hasEventDefinition." ;
    rdfs:subClassOf :Concept .
:BpmnTimerEventDefinition a owl:Class ;
    rdfs:label "BPMN TimerEventDefinition" ;
    rdfs:subClassOf :BpmnEventDefinition .

:BpmnMessageEventDefinition a owl:Class ;
    rdfs:label "BPMN MessageEventDefinition" ;
    rdfs:subClassOf :BpmnEventDefinition .

:BpmnSignalEventDefinition a owl:Class ;
    rdfs:label "BPMN SignalEventDefinition" ;
    rdfs:subClassOf :BpmnEventDefinition .

:BpmnErrorEventDefinition a owl:Class ;
    rdfs:label "BPMN ErrorEventDefinition" ;
    rdfs:subClassOf :BpmnEventDefinition .

:BpmnEscalationEventDefinition a owl:Class ;
    rdfs:label "BPMN EscalationEventDefinition" ;
    rdfs:subClassOf :BpmnEventDefinition .

:BpmnConditionalEventDefinition a owl:Class ;
    rdfs:label "BPMN ConditionalEventDefinition" ;
    rdfs:subClassOf :BpmnEventDefinition .

:BpmnCompensateEventDefinition a owl:Class ;
    rdfs:label "BPMN CompensateEventDefinition" ;
    rdfs:subClassOf :BpmnEventDefinition .

:BpmnTerminateEventDefinition a owl:Class ;
    rdfs:label "BPMN TerminateEventDefinition" ;
    rdfs:subClassOf :BpmnEventDefinition .

:hasEventDefinition a owl:ObjectProperty ;
    rdfs:label "hasEventDefinition" ;
    rdfs:comment "A BPMN event names its trigger or effect." ;
    rdfs:domain :BpmnEvent ;
    rdfs:range :BpmnEventDefinition .

:bpmnElementId a owl:DatatypeProperty ;
    rdfs:label "bpmnElementId" ;
    rdfs:comment "The id the source BPMN 2.0 document gave the element. Unique within its :ProcessModel." ;
    rdfs:range xsd:string .

:bpmnPreservedXml a owl:DatatypeProperty ;
    rdfs:label "bpmnPreservedXml" ;
    rdfs:comment "The canonical XML of an extension or diagram fragment the graph does not model, kept on its owner node." ;
    rdfs:range xsd:string .
