@prefix fibo-fi: <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/> .
@prefix fibo-org: <https://spec.edmcouncil.org/fibo/ontology/FND/Organizations/Organizations/> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix : <http://knuckles.team/kg#> .
@prefix bfo: <http://purl.obolibrary.org/obo/BFO_> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:acceptedBy a owl:ObjectProperty ;
    rdfs:label "accepted by" ;
    rdfs:comment "Links AcceptanceCriteria to the Requirement it validates." ;
    rdfs:domain :AcceptanceCriteria ;
    rdfs:range :Requirement .

:apiVersion a owl:DatatypeProperty ;
    rdfs:label "API version" ;
    rdfs:comment "Semantic version of the API contract." ;
    rdfs:domain :APIContract ;
    rdfs:range xsd:string .

:approach a owl:DatatypeProperty ;
    rdfs:label "approach" ;
    rdfs:comment "Detailed engineering approach or strategy defined by this plan." ;
    rdfs:domain :ImplementationPlan ;
    rdfs:range xsd:string .

:assignedAgent a owl:ObjectProperty ;
    rdfs:label "assigned agent" ;
    rdfs:comment "Links a Specification/Task to the A2AAgentCard agent assigned to it." ;
    rdfs:range :A2AAgentCard .

:chatSessionId a owl:DatatypeProperty ;
    rdfs:label "chat session ID" ;
    rdfs:comment "Unique identifier of the chat session where this plan version was created." ;
    rdfs:domain :ImplementationPlan ;
    rdfs:range xsd:string .

:constrainedBy a owl:ObjectProperty ;
    rdfs:label "constrained by" ;
    rdfs:comment "Links a SoftwareFeature to ComplianceConstraints it must satisfy." ;
    rdfs:domain :SoftwareFeature ;
    rdfs:range :ComplianceConstraint .

:derivedFrom a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "derived from" ;
    rdfs:comment "Transitive: traces Requirement lineage back through Specifications. The shared kg:derivedFrom's domain and range are owned by the core foundation; an SDD-local rdfs:domain/rdfs:range here would retype every derivedFrom edge in the graph as Requirement -> Specification." .

:exposesAPI a owl:ObjectProperty ;
    rdfs:label "exposes API" ;
    rdfs:comment "Links a SoftwareComponent to the API Contract(s) it exposes." ;
    rdfs:domain :SoftwareComponent ;
    rdfs:range :APIContract .

:guidelineFor a owl:ObjectProperty ;
    rdfs:label "guideline for" ;
    rdfs:comment "Links a DesignGuideline to the domain or layer it governs." ;
    rdfs:domain :DesignGuideline .

:implementedBy a owl:ObjectProperty ;
    rdfs:label "implemented by" ;
    rdfs:comment "Links a SoftwareFeature to the SoftwareComponent(s) that deliver it." ;
    rdfs:domain :SoftwareFeature ;
    rdfs:range :SoftwareComponent .

:planForFeature a owl:ObjectProperty ;
    rdfs:label "plan for feature" ;
    rdfs:comment "Links an ImplementationPlan to the SoftwareFeature it is designed to deliver." ;
    rdfs:domain :ImplementationPlan ;
    rdfs:range :SoftwareFeature .

:planHash a owl:DatatypeProperty ;
    rdfs:label "plan hash" ;
    rdfs:comment "MD5 or SHA-256 hash of the plan content to uniquely identify changes." ;
    rdfs:domain :ImplementationPlan ;
    rdfs:range xsd:string .

:priority a owl:DatatypeProperty ;
    rdfs:label "priority" ;
    rdfs:comment "Priority of a requirement (critical, high, medium, low) or of a work item such as an incident (for example P1)." ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Requirement :WorkItem ) ] ;
    rdfs:range xsd:string .

:realizes a owl:ObjectProperty ;
    rdfs:label "realizes" ;
    rdfs:comment """Links an SDD artifact to the ArchiMate element it realizes.
Example: SoftwareFeature realizes ApplicationFunction.""" .

:specifies a owl:ObjectProperty ;
    rdfs:label "specifies" ;
    rdfs:comment "Links a Specification to the SoftwareFeature(s) it defines." .

:storyPoints a owl:DatatypeProperty ;
    rdfs:label "story points" ;
    rdfs:comment "Effort estimation in story points." ;
    rdfs:domain :UserStory ;
    rdfs:range xsd:integer .

:supersedesPlan a owl:ObjectProperty ;
    rdfs:label "supersedes plan" ;
    rdfs:comment "Links an ImplementationPlan to the previous version it supersedes." ;
    rdfs:domain :ImplementationPlan ;
    rdfs:range :ImplementationPlan .

:testStatus a owl:DatatypeProperty ;
    rdfs:label "test status" ;
    rdfs:comment "Test execution status: passed, failed, skipped, pending." ;
    rdfs:domain :TestCase ;
    rdfs:range xsd:string .

:testedBy a owl:ObjectProperty ;
    rdfs:label "tested by" ;
    rdfs:comment "Links a Requirement to the TestCase(s) that verify it." ;
    rdfs:domain :Requirement ;
    rdfs:range :TestCase .

:trackedBy a owl:DatatypeProperty ;
    rdfs:label "tracked by" ;
    rdfs:comment """The external tracker id a Specification/SoftwareFeature is tracked
by (e.g. a Jira issue key or Plane work-item id), formatted '<tool>:<id>'. Written by
the spec↔ticket link flow (CONCEPT:KG-2.9).""" ;
    rdfs:domain :Specification ;
    rdfs:range xsd:string .

:version a owl:DatatypeProperty ;
    rdfs:label "version" ;
    rdfs:comment "Version iteration number of the implementation plan or task list." ;
    rdfs:domain :ImplementationPlan ;
    rdfs:range xsd:integer .

<http://knuckles.team/kg/sdd> a owl:Ontology ;
    rdfs:label "Spec-Driven Development Ontology" ;
    rdfs:comment """SDD-specific extensions for software specification, feature
    management, requirements engineering, and quality assurance.
    Maps to ArchiMate 3.2 for enterprise architecture governance.

    CONCEPT:KG-2.7 — Context Graph Architecture (SDD Layer)""" .

:AcceptanceCriteria a owl:Class ;
    rdfs:label "Acceptance Criteria" ;
    rdfs:comment """Testable conditions that define when a Requirement is met.
    Subclass of Specification. ArchiMate: Motivation → Requirement.
    Links to TestCases for automated verification.""" ;
    rdfs:subClassOf :Specification .

:ComplianceConstraint a owl:Class ;
    rdfs:label "Compliance Constraint" ;
    rdfs:comment """A regulatory or policy constraint on software development.
    Subclass of Regulation. ArchiMate: Motivation → Constraint.
    May be enforced via SHACL shapes for automated validation.""" ;
    rdfs:subClassOf :Regulation .

:DesignGuideline a owl:Class ;
    rdfs:label "Design Guideline" ;
    rdfs:comment """An enterprise design standard or coding guideline.
    Subclass of Principle. ArchiMate: Motivation → Principle.
    Inherited from the enterprise core ontology, overridable by domains.""" ;
    rdfs:subClassOf :Principle .

:UserStory a owl:Class ;
    rdfs:label "User Story" ;
    rdfs:comment """A user-facing requirement in 'As a… I want… So that…' format.
    Subclass of Requirement. ArchiMate: Motivation → Requirement.
    Bridges business intent to technical implementation.""" ;
    rdfs:subClassOf :Requirement .

:APIContract a owl:Class ;
    rdfs:label "API Contract" ;
    rdfs:comment """A formal API interface contract (OpenAPI, GraphQL, gRPC).
    BFO:GenericallyDependentContinuant. ArchiMate: Application → ApplicationInterface.
    Specifies the boundary between SoftwareComponents.""" ;
    rdfs:subClassOf bfo:0000031 .

:SoftwareComponent a owl:Class ;
    rdfs:label "Software Component" ;
    rdfs:comment """A modular, deployable unit of software.
    BFO:GenericallyDependentContinuant. ArchiMate: Application → ApplicationComponent.
    May be a microservice, library, module, or package.""" ;
    rdfs:subClassOf bfo:0000031 .

:TestCase a owl:Class ;
    rdfs:label "Test Case" ;
    rdfs:comment """An executable test verifying a Requirement or AcceptanceCriteria.
    BFO:Process (an activity that produces a pass/fail result).
    ArchiMate: Application → ApplicationFunction.""" ;
    rdfs:subClassOf bfo:0000015 .

:SoftwareFeature a owl:Class ;
    rdfs:label "Software Feature" ;
    rdfs:comment """A discrete, deliverable software capability.
    BFO:GenericallyDependentContinuant. ArchiMate: Application → ApplicationFunction.
    Realized via SoftwareComponents and traced to Requirements.""" ;
    rdfs:subClassOf bfo:0000031 .

:Requirement a owl:Class ;
    rdfs:label "Requirement" ;
    rdfs:comment """A functional or non-functional requirement derived from a Specification.
    Subclass of Specification. ArchiMate: Motivation → Requirement.
    Must be testable and linked to AcceptanceCriteria.""" ;
    rdfs:subClassOf :Specification .

:Specification a owl:Class ;
    rdfs:label "Specification" ;
    rdfs:comment """A formal specification document describing expected system behavior.
    BFO:GenericallyDependentContinuant. ArchiMate: Strategy → Capability.
    Central artifact in spec-driven development — all requirements,
    user stories, and acceptance criteria trace back to a Specification.""" ;
    rdfs:subClassOf bfo:0000031 .

:ImplementationPlan a owl:Class ;
    rdfs:label "Implementation Plan" ;
    rdfs:comment """A detailed engineering implementation plan that defines how to implement a SoftwareFeature.
    BFO:GenericallyDependentContinuant. ArchiMate: Strategy → Capability.
    Allows recording different historical versions of the plan within a single chat session or across workspace edits.""" ;
    rdfs:subClassOf :Specification .

:sddSpecifies a owl:ObjectProperty ;
    rdfs:label "specifies (sdd)" ;
    rdfs:comment "The sdd module's meaning of the shared kg:specifies: it carries this module's domain and range so that the shared property carries none (a module must not constrain a shared property)." ;
    rdfs:subPropertyOf :specifies ;
    rdfs:domain :Specification ;
    rdfs:range :SoftwareFeature .

:SourceContainer a owl:Class ;
    rdfs:label "Source Container" ;
    rdfs:comment "A provider-owned container in a source's hierarchy, such as a space, folder or channel. Containers nest through containedIn; source records link to their container through inContainer." ;
    rdfs:subClassOf bfo:0000031 .

:containedIn a owl:ObjectProperty ;
    rdfs:label "contained in" ;
    rdfs:comment "Links a SourceContainer to its parent SourceContainer." ;
    rdfs:domain :SourceContainer ;
    rdfs:range :SourceContainer .

:inContainer a owl:ObjectProperty ;
    rdfs:label "in container" ;
    rdfs:comment "Links a SourceRecord to the SourceContainer that holds it." ;
    rdfs:domain :SourceRecord ;
    rdfs:range :SourceContainer .

# Row-level vocabulary of the spec standard. A spec row is a :Requirement.
# Every class below extends a class that already rolls up to the core.

:RowStatus a owl:Class ;
    rdfs:label "Row status" ;
    rdfs:comment "One of the three computed states of a row: SPECIFIED, LANDED or VERIFIED. Computed from commits and bound tests, never written by an author." ;
    rdfs:subClassOf bfo:0000031 .

:SpecifiedStatus a owl:Class ; rdfs:label "Specified status" ; rdfs:subClassOf :RowStatus .
:LandedStatus a owl:Class ; rdfs:label "Landed status" ; rdfs:subClassOf :RowStatus .
:VerifiedStatus a owl:Class ; rdfs:label "Verified status" ; rdfs:subClassOf :RowStatus .

:BoundTest a owl:Class ;
    rdfs:label "Bound test" ;
    rdfs:comment "A test named by a row. It binds to the row ID and proves it." ;
    rdfs:subClassOf :TestCase .

:SeamSide a owl:Class ;
    rdfs:label "Seam side" ;
    rdfs:comment "One end of a cross-repository seam: the repository and the row that provide or consume it. A seam has a provider side and a consumer side." ;
    rdfs:subClassOf :Specification .

:RefusalCode a owl:Class ;
    rdfs:label "Refusal code" ;
    rdfs:comment "A typed code that a row names for a refused request." ;
    rdfs:subClassOf :GlossaryTerm .

:ShapeStatement a owl:Class ;
    rdfs:label "Shape statement" ;
    rdfs:comment "The Shape sentence of a row: the files, types and helpers the row reuses." ;
    rdfs:subClassOf :Specification .

:rowStatus a owl:ObjectProperty ;
    rdfs:label "row status" ;
    rdfs:comment "Links a Requirement to its computed RowStatus." ;
    rdfs:domain :Requirement ;
    rdfs:range :RowStatus .

:rowId a owl:DatatypeProperty ;
    rdfs:label "row ID" ;
    rdfs:comment "The stable row identifier, for example MEDULLA-SDLC-R014.10." ;
    rdfs:domain :Requirement ;
    rdfs:range xsd:string .

:dependsOnRow a owl:ObjectProperty ;
    rdfs:label "depends on row" ;
    rdfs:comment "Links a Requirement to a Requirement named in its Depends on line." ;
    rdfs:domain :Requirement ;
    rdfs:range :Requirement .

:seamProvider a owl:ObjectProperty ;
    rdfs:label "seam provider" ;
    rdfs:comment "Links a Requirement to the provider SeamSide of a seam it crosses." ;
    rdfs:domain :Requirement ;
    rdfs:range :SeamSide .

:seamConsumer a owl:ObjectProperty ;
    rdfs:label "seam consumer" ;
    rdfs:comment "Links a Requirement to the consumer SeamSide of a seam it crosses." ;
    rdfs:domain :Requirement ;
    rdfs:range :SeamSide .

:boundTest a owl:ObjectProperty ;
    rdfs:label "bound test" ;
    rdfs:comment "Links a Requirement to a test bound to its ID." ;
    rdfs:domain :Requirement ;
    rdfs:range :BoundTest .

:verifiedBy a owl:ObjectProperty ;
    rdfs:label "verified by" ;
    rdfs:comment """Links a Requirement to the test that verifies it: the row-level
    BoundTest whose file exists on the default branch, or the TestCase the
    verified.binding rule derives (MEDULLA-SDLC-R001.1).""" ;
    rdfs:domain :Requirement ;
    rdfs:range :TestCase .

:refusesWith a owl:ObjectProperty ;
    rdfs:label "refuses with" ;
    rdfs:comment "Links a Requirement to a RefusalCode it names." ;
    rdfs:domain :Requirement ;
    rdfs:range :RefusalCode .

:statedBy a owl:ObjectProperty ;
    rdfs:label "stated by" ;
    rdfs:comment "Links a Requirement to its ShapeStatement." ;
    rdfs:domain :Requirement ;
    rdfs:range :ShapeStatement .

:usesTerm a owl:ObjectProperty ;
    rdfs:label "uses term" ;
    rdfs:comment "Links a Requirement to a GlossaryTerm its text uses." ;
    rdfs:domain :Requirement ;
    rdfs:range :GlossaryTerm .

:commitHash a owl:DatatypeProperty ;
    rdfs:label "commit hash" ;
    rdfs:comment "The full hash of a Commit carrying a Spec trailer." ;
    rdfs:domain :Commit ;
    rdfs:range xsd:string .

:implementedByCommit a owl:ObjectProperty ;
    rdfs:label "implemented by commit" ;
    rdfs:comment "Links a Requirement to each Commit whose Spec trailer names it. The shared implementedBy keeps its SoftwareFeature domain, so this row-grain link is separate." ;
    rdfs:domain :Requirement ;
    rdfs:range :Commit .

# Lifecycle record kinds and edges (MEDULLA-SDLC-R001.1). Release, Deployment and
# Defect are append-only fact histories: they have no challenger, so they are not
# revision subjects. The endpoint classes keep their owners — :Requirement here,
# :Changeset and :GateVerdict in MEDULLA-SCM, :CodeSymbol and :TestCase in the
# MEDULLA-REPO-INGEST-R600 entities, :RunTrace in the orchestration module, and
# :Incident in the core foundation — and are referenced, never redeclared.
# Every class below extends a class that rolls up to the core.

:Release a owl:Class ;
    rdfs:label "Release" ;
    rdfs:comment """A published release of one repository: version, ref, changeset head
    and artifact digests. It contains the changesets after the previous release head
    up to and including its own head. BFO:GenericallyDependentContinuant.""" ;
    rdfs:subClassOf bfo:0000031 .

:Deployment a owl:Class ;
    rdfs:label "Deployment" ;
    rdfs:comment """One rollout of an image to an environment. It deploys the release
    whose artifact digest it names; a digest no release names stays unattributed and
    is never guessed. BFO:Process.""" ;
    rdfs:subClassOf bfo:0000015 .

:Defect a owl:Class ;
    rdfs:label "Defect" ;
    rdfs:comment """A code fault, deduplicated by the digest of its normalized symptom.
    A defect is not an incident: an incident may raise a defect.
    BFO:GenericallyDependentContinuant.""" ;
    rdfs:subClassOf bfo:0000031 .

:implements a owl:ObjectProperty ;
    rdfs:label "implements" ;
    rdfs:comment """Lifecycle facet (MEDULLA-SDLC-R001.1): links a CodeSymbol to the
    Requirement(s) its changeset cites on the default branch. The sdlc_lifecycle
    module keeps its Spec to CodeChange facet on the shared name; this module
    carries no rdfs:domain or rdfs:range of its own.""" .

:changes a owl:ObjectProperty ;
    rdfs:label "changes" ;
    rdfs:comment "Links a Changeset to each CodeSymbol whose path span it touches." ;
    rdfs:domain :Changeset ;
    rdfs:range :CodeSymbol .

:citesRequirement a owl:ObjectProperty ;
    rdfs:label "cites requirement" ;
    rdfs:comment "Links a Changeset to each Requirement named in its structured spec_ids." ;
    rdfs:domain :Changeset ;
    rdfs:range :Requirement .

:exercises a owl:ObjectProperty ;
    rdfs:label "exercises" ;
    rdfs:comment "Links a TestCase to each CodeSymbol it calls." ;
    rdfs:domain :TestCase ;
    rdfs:range :CodeSymbol .

:judges a owl:ObjectProperty ;
    rdfs:label "judges" ;
    rdfs:comment "Links a GateVerdict to the Changeset it judges." ;
    rdfs:domain :GateVerdict ;
    rdfs:range :Changeset .

:producedBy a owl:ObjectProperty ;
    rdfs:label "produced by" ;
    rdfs:comment """Lifecycle facet (MEDULLA-SDLC-R001.1): links a Changeset to the
    RunTrace that produced it. The orchestration module keeps its RunTrace to
    DurableExecutionUnit facet on the shared name; this module carries no
    rdfs:domain or rdfs:range of its own.""" .

:affects a owl:ObjectProperty ;
    rdfs:label "affects" ;
    rdfs:comment """Lifecycle facet (MEDULLA-SDLC-R001.1): links a Defect to each
    CodeSymbol it affects. The service-operations module keeps its incident facet
    on the shared name; this module carries no rdfs:domain or rdfs:range of its
    own.""" .

:introducedBy a owl:ObjectProperty ;
    rdfs:label "introduced by" ;
    rdfs:comment "Links a Defect to the Changeset the bisect names as its culprit." ;
    rdfs:domain :Defect ;
    rdfs:range :Changeset .

:fixedBy a owl:ObjectProperty ;
    rdfs:label "fixed by" ;
    rdfs:comment "Links a Defect to each Changeset whose structured fixes names it." ;
    rdfs:domain :Defect ;
    rdfs:range :Changeset .

:contains a owl:ObjectProperty ;
    rdfs:label "contains" ;
    rdfs:comment """Lifecycle facet (MEDULLA-SDLC-R001.1): links a Release to each
    Changeset after the previous release head up to and including its own head. The
    core foundation keeps its spatial facet on the shared name; this module carries
    no rdfs:domain or rdfs:range of its own.""" .

:deploys a owl:ObjectProperty ;
    rdfs:label "deploys" ;
    rdfs:comment """Lifecycle facet (MEDULLA-SDLC-R001.1): links a Deployment to the
    Release whose artifact digest it names. The sdlc_lifecycle module keeps its
    container-image facet on the shared name; this module carries no rdfs:domain or
    rdfs:range of its own.""" .

:observedIn a owl:ObjectProperty ;
    rdfs:label "observed in" ;
    rdfs:comment "Links an Incident to the Deployment in which it was observed." ;
    rdfs:domain :Incident ;
    rdfs:range :Deployment .

:raises a owl:ObjectProperty ;
    rdfs:label "raises" ;
    rdfs:comment "Links an Incident to the Defect it raises." ;
    rdfs:domain :Incident ;
    rdfs:range :Defect .
