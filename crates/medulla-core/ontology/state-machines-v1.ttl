    :firedBy :AnalyticsJobMachine_Event_Fail .

:AnalyticsJobMachine_J07 a :AnalyticsJobTransition ;
    rdfs:label "AnalyticsJob J07" ;
    :edgeId "J07" ;
    :fromState :AnalyticsJobMachine_Publishing ;
    :toState :AnalyticsJobMachine_Backoff ;
    :guardedBy :AnalyticsJobMachine_Guard_AttemptsBelowMax ;
    :firedBy :AnalyticsJobMachine_Event_Fail .

:AnalyticsJobMachine_J08 a :AnalyticsJobTransition ;
    rdfs:label "AnalyticsJob J08" ;
    :edgeId "J08" ;
    :fromState :AnalyticsJobMachine_Publishing ;
    :toState :AnalyticsJobMachine_Failed ;
    :guardedBy :AnalyticsJobMachine_Guard_AttemptsReachedMax ;
