    :guardedBy :WorkItemMachine_Guard_LeaseExpiredAttemptsSpent ;
    :firedBy :WorkItemMachine_Event_LeaseExpire .

:WorkItemMachine_W26 a :WorkItemTransition ;
    rdfs:label "WorkItem W26" ;
    :edgeId "W26" ;
    :fromState :WorkItemMachine_Running ;
    :toState :WorkItemMachine_DeadLetter ;
    :guardedBy :WorkItemMachine_Guard_LeaseExpiredAttemptsSpent ;
    :firedBy :WorkItemMachine_Event_LeaseExpire .
