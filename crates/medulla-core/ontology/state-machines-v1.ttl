    rdfs:label "AnalyticsJob WorkerTakesLease" ;
    rdfs:comment "Guard: a worker takes a lease." .

:AnalyticsJobMachine_Guard_NotBeforePassedWorkerTakesLease a :AnalyticsJobGuard ;
    rdfs:label "AnalyticsJob NotBeforePassedWorkerTakesLease" ;
    rdfs:comment "Guard: not_before has passed and a worker takes a lease." .

:AnalyticsJobMachine_Guard_LeaseOwnerMatchesLeaseLive a :AnalyticsJobGuard ;
    rdfs:label "AnalyticsJob LeaseOwnerMatchesLeaseLive" ;
    rdfs:comment "Guard: the lease owner matches and the lease is live." .

