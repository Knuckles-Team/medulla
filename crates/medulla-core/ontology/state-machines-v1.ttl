:ShardDrainMachine_Guard_DrainSafe a :ShardDrainGuard ;
    rdfs:label "ShardDrain DrainSafe" ;
    rdfs:comment "Guard: admission is stopped, no work is outstanding, the writer is the planned authoritative writer and healthy voters reach the planned minimum." .

:ShardDrainMachine_Guard_VoterObservationValid a :ShardDrainGuard ;
    rdfs:label "ShardDrain VoterObservationValid" ;
    rdfs:comment "Guard: the observed voters, writer and healthy voters validate against the plan." .

:ShardDrainMachine_Guard_RollbackSafe a :ShardDrainGuard ;
    rdfs:label "ShardDrain RollbackSafe" ;
    rdfs:comment "Guard: the restored voters equal the original voters, keep the planned writer, reach quorum and the healthy-voter minimum." .

