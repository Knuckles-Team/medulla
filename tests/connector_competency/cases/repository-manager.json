{
  "connector": "repository-manager",
  "rollup": "MEDULLA-CQ-CONN-R052",
  "vocabulary_module": "sdlc_lifecycle-v1.ttl",
  "terms": [
    "CodeChangeProposal",
    "Worktree",
    "proposalBranch",
    "proposalState",
    "tracksBranch",
    "worktreeState"
  ],
  "questions": [
    {
      "id": "repository-manager.q1",
      "kind": "single",
      "question": "Which worktrees are stale or dangling relative to their base branch?",
      "uql": "FOREIGN SCAN 'repository-manager'",
      "sources": [
        "repository-manager"
      ],
      "optional_sources": [],
      "source_kinds": {
        "repository-manager": "mcp_tool"
      },
      "columns": [
        "worktree",
        "state",
        "branch"
      ],
      "min_rows": 1,
      "recordings": [
        "repository-manager/single.json"
      ]
    },
    {
      "id": "repository-manager.q2",
      "kind": "cross",
      "question": "Which local worktrees track a branch whose pull request has already been merged on GitHub or GitLab?",
      "uql": "LET s0 = FOREIGN SCAN 'repository-manager'; LET s1 = FOREIGN SCAN 'github-agent'; LET s2 = FOREIGN SCAN 'gitlab_api'; JOIN s0, s1, s2",
      "sources": [
        "repository-manager",
        "github-agent",
        "gitlab_api"
      ],
      "optional_sources": [],
      "source_kinds": {
        "repository-manager": "mcp_tool",
        "github-agent": "mcp_tool",
        "gitlab_api": "http_endpoint"
      },
      "columns": [
        "worktree",
        "branch",
        "proposal"
      ],
      "min_rows": 1,
      "recordings": [
        "repository-manager/cross_repository-manager.json",
        "github-agent/cross_repository-manager.json",
        "repository-manager/cross_repository-manager.json",
        "gitlab_api/cross_repository-manager.json"
      ]
    }
  ]
}
