# Connector-pack surface shapes (MEDULLA-TYPED-PACKS-R102.1).
#
# SHACL Core only (DECIDE §4.8): the connector-pack module ships its shapes in
# the same core source as its ontology (the connector-pack CoreSpec shapes
# field), the pattern every other shapes companion follows. The surface shapes
# guard the connector-surface vocabulary of core:connector-pack@1 — one
# component id per tool, a domain link per tool, and a realised-by member per
# feature. The contract shapes (MEDULLA-TYPED-PACKS-R101.2) land beside these,
# never replacing them.

@prefix cp:  <http://knuckles.team/kg/connector-pack#> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cp:ToolShape a sh:NodeShape ;
    sh:targetClass cp:Tool ;
    sh:property [
        sh:path cp:componentId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "A tool names exactly one component id."
    ] ;
    sh:or (
        [ sh:property [ sh:path cp:operatesOn ; sh:minCount 1 ;
            sh:message "A tool operates on at least one domain class." ] ]
        [ sh:property [ sh:path cp:providesCapability ; sh:minCount 1 ;
            sh:message "A tool provides at least one capability." ] ]
    ) ;
    sh:message "A tool names one component id and at least one operatesOn or providesCapability domain link." .

cp:FeatureShape a sh:NodeShape ;
    sh:targetClass cp:Feature ;
    sh:property [
        sh:path cp:realizedBy ; sh:minCount 1 ;
        sh:message "A feature is realised by at least one tool, prompt or skill."
    ] ;
    sh:message "A feature names at least one realised-by member." .

# --- Contract shapes (MEDULLA-TYPED-PACKS-R101.2) --------------------------------
# One node shape per contract class. The data graph is built by `contract_graph`
# (medulla-h-admin, import/contract_rdf.rs): a missing required key leaves its
# triple out, and the shape below refuses it.

cp:IngestContractShape a sh:NodeShape ;
    sh:targetClass cp:IngestContract ;
    sh:property [ sh:path cp:contractOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "A contract names exactly one connector." ] ;
    sh:property [ sh:path cp:contractVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "A contract names exactly one version." ] ;
    sh:property [ sh:path cp:contractDigest ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "A contract names exactly one digest." ] ;
    sh:property [ sh:path cp:hasCursorPolicy ; sh:maxCount 1 ;
        sh:message "A contract names at most one cursor policy." ] ;
    sh:property [ sh:path cp:hasAccessPolicy ; sh:maxCount 1 ;
        sh:message "A contract names at most one access policy." ] ;
    sh:property [ sh:path cp:requiresProvenance ; sh:maxCount 1 ;
        sh:message "A contract names at most one provenance requirement." ] ;
    sh:property [ sh:path cp:privacyClass ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "public" "internal" "personal" "secret" ) ;
        sh:message "cp:privacyClass is one of public, internal, personal, secret." ] .

cp:SourceObjectShape a sh:NodeShape ;
    sh:targetClass cp:SourceObject ;
    sh:property [ sh:path cp:objectName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "A source object names its object." ] ;
    sh:property [ sh:path cp:ontologyClass ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "A source object names exactly one ontology class." ] ;
    sh:property [ sh:path cp:hasKeyRule ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A source object names exactly one key rule." ] .

cp:KeyRuleShape a sh:NodeShape ;
    sh:targetClass cp:KeyRule ;
    sh:property [ sh:path cp:keyField ; sh:minCount 1 ; sh:datatype xsd:string ;
        sh:message "A key rule names at least one key field." ] .

cp:FieldMappingShape a sh:NodeShape ;
    sh:targetClass cp:FieldMapping ;
    sh:property [ sh:path cp:sourceField ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "A field mapping names exactly one source field." ] ;
    sh:property [ sh:path cp:mapsPredicate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "A field mapping names exactly one predicate." ] .

cp:CursorPolicyShape a sh:NodeShape ;
    sh:targetClass cp:CursorPolicy ;
    sh:property [ sh:path cp:cursorKind ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "opaque" "timestamp" "commit" "offset" "page_token" ) ;
        sh:message "cp:cursorKind is one of opaque, timestamp, commit, offset, page_token." ] .

cp:AccessPolicyShape a sh:NodeShape ;
    sh:targetClass cp:AccessPolicy ;
    sh:property [ sh:path cp:defaultAcl ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "quarantine" "inherit" "public" ) ;
        sh:message "cp:defaultAcl is one of quarantine, inherit, public." ] .

cp:ProvenanceRequirementShape a sh:NodeShape ;
    sh:targetClass cp:ProvenanceRequirement ;
    sh:property [ sh:path cp:requiredField ; sh:minCount 1 ; sh:datatype xsd:string ;
        sh:message "A provenance requirement names at least one required field." ] .
