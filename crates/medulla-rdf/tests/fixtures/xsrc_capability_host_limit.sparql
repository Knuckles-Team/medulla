# Which business capabilities depend on a host that is over its temperature
# limit? Classes only (MEDULLA-CQ-XSRC-R008.2.3): the limit is stated as data on
# the host, never hard-coded, and no source, endpoint or connector is named
# here. The service-to-capability link is :supportsCapability (plan.md
# decision D6).
PREFIX : <https://knuckles-team.github.io/ontology/core#>
PREFIX infra: <https://knuckles-team.github.io/ontology/infrastructure#>

SELECT ?capability ?service ?workload ?host ?reading ?limit WHERE {
  ?capability a :BusinessCapability .
  ?workload a infra:Workload .
  ?host a infra:Host ;
        infra:temperatureCelsius ?reading ;
        infra:temperatureLimitCelsius ?limit .
  ?service :supportsCapability ?capability ;
           :deployedAs ?workload .
  ?workload infra:runsOn ?host .
  FILTER(?reading > ?limit)
}
