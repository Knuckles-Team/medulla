@prefix bfo: <http://purl.obolibrary.org/obo/BFO_> .
@prefix fibo-fi: <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/> .
@prefix fibo-org: <https://spec.edmcouncil.org/fibo/ontology/FND/Organizations/Organizations/> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix : <https://knuckles-team.github.io/ontology/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:TaskStep a owl:Class ;
    rdfs:label "Task Step" ;
    rdfs:comment "An ordered step in a task, compatible with the shared precedes relation." ;
    rdfs:subClassOf bfo:0000001 .

:AnalyticsJob a owl:Class ;
    rdfs:label "AnalyticsJob" ;
    rdfs:comment """CONCEPT:AU-ORCH.scheduling.analytics-job-mirror — mirrors one
    `medulla-jobs::AnalyticsJob`: a durable async job with fenced-lease checkpointing
    (`Checkpoint{progress,label,state_blob}`), cron/interval/manual triggers
    (`JobIntent::Trigger`), and a `JobState` lifecycle (`Submitted` ->
    `Running`/`Publishing` -> `Succeeded`|`Failed`|`Cancelled`). :backendRef is the
    `JobId`; :durableStatus mirrors `JobState::label()`; :leaseEpoch mirrors
    `lease_epoch`; :checkpointRef mirrors the active `Checkpoint`'s label/progress.""" ;
    rdfs:subClassOf :DurableExecutionUnit .

:BusTopicCursor a owl:Class ;
    rdfs:label "BusTopicCursor" ;
    rdfs:comment """CONCEPT:ECO-4.91 — a per-(BusAgent, Topic) replay cursor for store-and-forward
    topic messages: a dedicated node (never a property on the shared Topic, which the backend's
    upsert would clobber) so each agent reads each stored topic message at most once.""" .

:DurableRun a owl:Class ;
    rdfs:label "DurableRun" ;
    rdfs:comment """CONCEPT:AU-ORCH.runvcs.durable-run-mirror — mirrors one
    agent-utilities `DurableExecutionManager`/`DurableRun` checkpoint sequence
    (the meristem harness): a SQLite- or Postgres-backed
    (CONCEPT:AU-OS.state.unified-durable-state-externalization), named-step resumable run keyed by
    `(session_id, node_id)`, with an idempotency key per critical action and
    skip-completed-steps-on-resume via `DurableRun.step()`. :backendRef is the
    `(session_id, node_id)` pair; :durableStatus mirrors the checkpoint's `status`
    (`PENDING`|`COMPLETED`); :idempotencyKey mirrors the row's `idempotency_key`. Ours is
    named-step granularity by design (typed, KG-attributable) rather than restate's
    automatic-any-`await`-point replay — DE3 narrows the ergonomics gap without copying
    restate's bytecode/coroutine mechanism (durable-execution-native.md Part 1 row 1/5).""" ;
    rdfs:subClassOf :DurableExecutionUnit .

:RunCut a owl:Class ;
    rdfs:label "RunCut" ;
    rdfs:comment """CONCEPT:AU-ORCH.runvcs.event-kernel — an immutable frontier over a run's
    event log ('the run through ordinal N', shepherd Cut); the causal prefix a fork/revert
    restores to.""" .

:SkillWorkflowProposal a owl:Class ;
    rdfs:label "Skill Workflow Proposal" ;
    rdfs:comment "CONCEPT:KG-2.90 — a propose-only skill-workflow candidate (composes atomic Skills) distilled from a flowsTo-chain of business tasks." ;
    rdfs:subClassOf :Workflow .

:StatechartInstance a owl:Class ;
    rdfs:label "StatechartInstance" ;
    rdfs:comment """CONCEPT:AU-KG.storage.statechart-instance-mirror — mirrors one
    `medulla-statechart::MachineInstance`: a keyed, OCC-versioned (`version`), rehydratable durable
    state-machine row (`configuration`/`context`/`status`/`tenant`/`actor`). :backendRef is
    the instance's `InstanceId`; :durableStatus mirrors `InstanceStatus`
    (`active`|`final`); :checkpointRef mirrors the OCC `version`. Single-node OCC-correct
    today — cross-cluster ordered fairness for one key is `medulla-statechart`'s own documented
    deferred item (`lib.rs:54-57`), tracked by DE4, not reopened here.""" ;
    rdfs:subClassOf :DurableExecutionUnit .

:attempts a owl:DatatypeProperty ;
    rdfs:label "attempts" ;
    rdfs:comment "CONCEPT:KG-2.113 — native WorkItem attempt count; exhaustion transitions status to dead_letter." ;
    rdfs:domain :WorkItem ;
    rdfs:range xsd:integer .

:automates a owl:ObjectProperty ;
    rdfs:label "automates" ;
    rdfs:comment """CONCEPT:KG-2.91 — a synthesized Skill / SkillWorkflow (or its
    proposal) AUTOMATES the BusinessProcess / Capability it would carry out. The
    connector→skill bridge: the background distiller writes it process→skill so
    reasoning relates an automation candidate to the descriptive process it
    addresses across any connected system.""" ;
    rdfs:range :BusinessProcess .

:awaits a owl:ObjectProperty ;
    rdfs:label "awaits" ;
    rdfs:comment """CONCEPT:AU-KG.storage.durable-execution-unit — DurableExecutionUnit
    -[:AWAITS]-> DurableExecutionUnit: a Call-style dependency between two durably executing
    units (e.g. a DurableRun step awaiting an AnalyticsJob's result, or a StatechartInstance
    transition gated on a SagaCoordination's commit) — the graph-edge replacement for
    restate's opaque cross-service await wire state (see `durable-execution-native.md` Part 3;
    schema reserved at DE0, populated by DE1 mirror-on-write).""" ;
    rdfs:domain :DurableExecutionUnit ;
    rdfs:range :DurableExecutionUnit .

:backendRef a owl:DatatypeProperty ;
    rdfs:label "backend ref" ;
    rdfs:comment """CONCEPT:AU-KG.storage.durable-execution-unit — the opaque foreign-key-shaped
    reference from a :DurableExecutionUnit mirror node back to its authoritative row in the
    OWNING backend's own durable store (medulla-statechart's `MachineInstance.instance_id`,
    medulla-jobs' `AnalyticsJob.job_id`, medulla-mutation-store's `MutationBatchRecord.batch_id`, or
    agent-utilities' `DurableExecutionManager` `(session_id, node_id)` pair). The
    :DurableExecutionUnit node is a PROVENANCE MIRROR, never a second store — this is the
    pointer back to the single source of truth.""" ;
    rdfs:domain :DurableExecutionUnit ;
    rdfs:range xsd:string .

:canKG a owl:DatatypeProperty ;
    rdfs:domain :Model ;
    rdfs:range xsd:boolean .

:canRoute a owl:DatatypeProperty ;
    rdfs:domain :Model ;
    rdfs:range xsd:boolean .

:causedByEvent a owl:ObjectProperty ;
    rdfs:label "caused by event" ;
    rdfs:comment "CONCEPT:AU-ORCH.runvcs.event-kernel — RunEvent -[:CAUSED_BY]-> RunEvent: the causality edge threading the content-addressed event DAG." ;
    rdfs:domain :RunEvent ;
    rdfs:range :RunEvent .

:checkpointRef a owl:DatatypeProperty ;
    rdfs:label "checkpoint ref" ;
    rdfs:comment """CONCEPT:AU-KG.storage.durable-execution-unit — mirrors a pointer to a
    :DurableExecutionUnit's most recent durable checkpoint (medulla-jobs' `Checkpoint`
    stage/progress digest, medulla-statechart's OCC `version`, DurableExecutionManager's
    idempotency-keyed checkpoint row, or medulla-mutation-store's committed
    `MutationBatchRecord` id) — never the checkpoint payload itself, which stays in the
    owning backend's own store.""" ;
    rdfs:domain :DurableExecutionUnit ;
    rdfs:range xsd:string .

:childWorkItemOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "child work item of" ;
    rdfs:comment "CONCEPT:KG-2.113 — a WorkItem spawned by a Loop stage (transitive across a fan-out tree)." ;
    rdfs:domain :WorkItem ;
    rdfs:range :Loop .

:commitId a owl:DatatypeProperty ;
    rdfs:label "commit id" ;
    rdfs:comment "CONCEPT:AU-ORCH.runvcs.run-commit — a RunCommit's content-addressed id (digest of checkpoint+fs-snapshot+cut)." ;
    rdfs:domain :RunCommit ;
    rdfs:range xsd:string .

:composes a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "composes" ;
    rdfs:comment """CONCEPT:KG-2.91 — a SkillWorkflowProposal COMPOSES the atomic
    Skills (or SkillProposals) it sequences as steps. Transitive so a workflow of
    workflows resolves to its leaf atomic skills under reasoning.""" ;
    rdfs:range :Skill .

:consentBasis a owl:DatatypeProperty ;
    rdfs:label "consent basis" ;
    rdfs:comment """CONCEPT:AU-ORCH.dispatch.workitem-consent-gate (D-25-3) — the legal/policy
    basis under which a WorkItem's gated consent was granted, e.g. 'explicit' |
    'contract' | 'legitimate_interest'. Empty when consentRequired is false.""" ;
    rdfs:domain :WorkItem ;
    rdfs:range xsd:string .

:consentExpiresAt a owl:DatatypeProperty ;
    rdfs:label "consent expires at" ;
    rdfs:comment """CONCEPT:AU-ORCH.dispatch.workitem-consent-gate (D-25-3) — Unix timestamp
    after which a granted consent LAPSES (the consent's explicit lifetime). Absent with
    consentGrantedAt present = a perpetual grant, a deliberate choice by the granter.""" ;
    rdfs:domain :WorkItem ;
    rdfs:range xsd:double .

:consentGrantedAt a owl:DatatypeProperty ;
    rdfs:label "consent granted at" ;
    rdfs:comment """CONCEPT:AU-ORCH.dispatch.workitem-consent-gate (D-25-3) — Unix timestamp a
    WorkItem's gated consent was granted. Absent (no triple) is the ABSENT consent
    state, DISTINCT from a granted consent past consentExpiresAt (LAPSED) — the
    claim/renewal gate (knowledge_graph.core.work_durability) denies both but reports them as
    different states.""" ;
    rdfs:domain :WorkItem ;
    rdfs:range xsd:double .

:consentPurpose a owl:DatatypeProperty ;
    rdfs:label "consent purpose" ;
    rdfs:comment """CONCEPT:AU-ORCH.dispatch.workitem-consent-gate (D-25-3) — what the subject
    consented to (purpose/scope), e.g. 'data_processing:analytics'. A distinct property
    from :consentScope (domain :ConsentRecord, the medical-consent module) — the two are
    unrelated domains and must not share one property IRI under RDFS domain semantics.""" ;
    rdfs:domain :WorkItem ;
    rdfs:range xsd:string .

:consentRequired a owl:DatatypeProperty ;
    rdfs:label "consent required" ;
    rdfs:comment """CONCEPT:AU-ORCH.dispatch.workitem-consent-gate (D-25-3) — opt-in per
    WorkItem: true when claim/renewal is gated on a recorded, unlapsed consent. False
    (the default, and the state of every pre-existing WorkItem predating this field) for
    ordinary operational/infra work — the D-25-3 migration decision.""" ;
    rdfs:domain :WorkItem ;
    rdfs:range xsd:boolean .

:consentSubject a owl:DatatypeProperty ;
    rdfs:label "consent subject" ;
    rdfs:comment """CONCEPT:AU-ORCH.dispatch.workitem-consent-gate (D-25-3) — opaque reference
    to WHOM a WorkItem's gated consent pertains (the data subject) — distinct from
    :tenant (the owning org) and the WorkItem's worker assignment.""" ;
    rdfs:domain :WorkItem ;
    rdfs:range xsd:string .

:contextWindow a owl:DatatypeProperty ;
    rdfs:domain :Model ;
    rdfs:range xsd:integer .

:coordinatedBy a owl:ObjectProperty ;
    rdfs:label "coordinated by" ;
    rdfs:comment """CONCEPT:AU-KG.txn.saga-coordination-mirror — DurableExecutionUnit
    -[:COORDINATED_BY]-> SagaCoordination: any unit whose multi-store atomic step is governed
    by medulla-mutation-store's real, generic, crash-recoverable `prepare_saga`/`commit_saga`
    coordinator — a capability restate itself does not have (durable-execution-native.md
    Part 1 row 6).""" ;
    rdfs:domain :DurableExecutionUnit ;
    rdfs:range :SagaCoordination .

:deadLetters a owl:ObjectProperty ;
    rdfs:label "dead-letters" ;
    rdfs:comment "CONCEPT:KG-2.113 — links the unified queue to a WorkItem whose native status is dead_letter." ;
    rdfs:range :WorkItem .

:definitionVersion a owl:DatatypeProperty ;
    rdfs:label "definition version" ;
    rdfs:comment """CONCEPT:AU-KG.storage.durable-execution-unit — the definition/deployment
    version a :DurableExecutionUnit started under. Schema reserved here at DE0; DE5 adds
    resume-time ENFORCEMENT — an in-flight unit resuming under an incompatible definition
    version fails loud instead of silently replaying under mismatched semantics, closing the
    one gap restate is genuinely ahead on today (durable-execution-native.md Part 1 row 9,
    'real gap, nothing exists today'). Unset/empty until DE5 lands enforcement.""" ;
    rdfs:domain :DurableExecutionUnit ;
    rdfs:range xsd:string .

:delegatesTo a owl:ObjectProperty ;
    rdfs:comment "Agent delegates to an external A2A agent." .

:derives a owl:ObjectProperty ;
    rdfs:label "derives" ;
    rdfs:comment "CONCEPT:KG-2.91 — inverse of :derivedFrom (source node → the proposal distilled from it)." ;
    owl:inverseOf :derivedFrom .

:diagnoses a owl:ObjectProperty ;
    rdfs:label "diagnoses" ;
    rdfs:comment """CONCEPT:AU-KG.audit.durable-error-detail — ErrorDetail -[:DIAGNOSES]-> RunTrace:
    a durable, sanitized failure record links to the RunTrace of the operation that raised it, when
    the failure occurred inside a correlated run (the ambient run-wide correlation id was active).
    Best-effort: most failures occur outside an orchestrated run, so an ErrorDetail node with no
    outgoing :DIAGNOSES edge is normal, not an error.""" ;
    rdfs:domain :ErrorDetail ;
    rdfs:range :RunTrace .

:dueAt a owl:DatatypeProperty ;
    rdfs:label "due at" ;
    rdfs:comment """CONCEPT:KG-2.113 — the earliest time a delayed/retrying WorkItem becomes
    runnable (eta). A NEW datatype property, deliberately distinct from the object-property
    :scheduledFor (CalendarEvent→Person) which must not be overloaded.""" ;
    rdfs:domain :WorkItem ;
    rdfs:range xsd:dateTime .

:durableStatus a owl:DatatypeProperty ;
    rdfs:label "durable status" ;
    rdfs:comment """CONCEPT:AU-KG.storage.durable-execution-unit — the mirrored lifecycle
    status of a :DurableExecutionUnit, kept in the OWNING backend's own vocabulary
    (medulla-statechart `active`|`final`; medulla-jobs `submitted`|`running`|`publishing`|`succeeded`|
    `failed`|`cancelled`; medulla-mutation-store saga `prepared`|`committed`|`aborted`;
    DurableExecutionManager `PENDING`|`COMPLETED`) — deliberately NOT normalized into one
    invented enum, so the mirror can never drift from what the backend itself reports.""" ;
    rdfs:domain :DurableExecutionUnit ;
    rdfs:range xsd:string .

:enqueues a owl:ObjectProperty ;
    rdfs:label "enqueues" ;
    rdfs:comment "CONCEPT:KG-2.113 — a Schedule or Loop ENQUEUES a WorkItem onto the unified queue." ;
    rdfs:range :WorkItem ;
    owl:inverseOf :enqueuedBy .

:eventOrdinal a owl:DatatypeProperty ;
    rdfs:label "event ordinal" ;
    rdfs:comment "CONCEPT:AU-ORCH.runvcs.event-kernel — a RunEvent's append position in its run's path (view metadata, not identity)." ;
    rdfs:domain :RunEvent ;
    rdfs:range xsd:integer .

:evolvedFrom a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:comment "Prompt lineage from evolution." ;
    rdfs:domain :Prompt ;
    rdfs:range :Prompt .

:executedProcess a owl:ObjectProperty ;
    rdfs:label "executedProcess" ;
    rdfs:comment """CONCEPT:ORCH-1.43 — a RunTrace (one workflow run) EXECUTED the
    descriptive BusinessProcess its workflow realizes (EXECUTED_PROCESS in the
    LPG; written by the workflow runner's lineage close-out when a REALIZES
    workflow completes). Closes the provenance loop opened by
    :realizesProcess.""" ;
    rdfs:range :BusinessProcess .

:forkedFrom a owl:ObjectProperty ;
    rdfs:label "forked from" ;
    rdfs:comment "CONCEPT:AU-ORCH.runvcs.fork-revert — a child RunTrace -[:FORKED_FROM]-> the RunCommit it branched off (lineage of a live-run fork)." ;
    rdfs:domain :RunTrace ;
    rdfs:range :RunCommit .

:goalText a owl:DatatypeProperty ;
    rdfs:range xsd:string .

:hasBusMessage a owl:ObjectProperty ;
    rdfs:label "hasBusMessage" ;
    rdfs:comment "CONCEPT:KG-2.141 — BusAgent -[:HAS_BUS_MESSAGE]-> BusMessage: a participant's durable bus inbox edge (ECO-4.84)." ;
    rdfs:domain :BusAgent ;
    rdfs:range :BusMessage .

:hasCommit a owl:ObjectProperty ;
    rdfs:label "has commit" ;
    rdfs:comment "CONCEPT:AU-ORCH.runvcs.run-commit — RunTrace -[:HAS_COMMIT]-> RunCommit (a run's commit history)." ;
    rdfs:domain :RunTrace ;
    rdfs:range :RunCommit .

:hasContext a owl:ObjectProperty ;
    rdfs:label "hasContext" ;
    rdfs:comment "CONCEPT:ORCH-1.39 — links a RunTrace (a spawned run) to the ContextBlob it consumed (provenance)." ;
    rdfs:range :ContextBlob .

:hasContextAnchor a owl:ObjectProperty ;
    rdfs:label "hasContext (anchor)" ;
    rdfs:comment "CONCEPT:ORCH-1.40 — Session -[:HAS_CONTEXT]-> ContextBlob anchor edge." ;
    rdfs:domain :Session ;
    rdfs:range :ContextBlob .

:hasEvent a owl:ObjectProperty ;
    rdfs:label "has event" ;
    rdfs:comment "CONCEPT:AU-ORCH.runvcs.event-kernel — RunTrace -[:HAS_EVENT]-> RunEvent (a run owns its ordered event path)." ;
    rdfs:domain :RunTrace ;
    rdfs:range :RunEvent .

:Span a owl:Class ;
    rdfs:label "Span" ;
    rdfs:comment "MEDULLA-ORCH-VOCAB-R009.100 -- one timed section of a run, exported by the harness and hung from its :RunTrace." ;
    rdfs:seeAlso prov:Activity .

:ToolCall a owl:Class ;
    rdfs:label "ToolCall" ;
    rdfs:comment "MEDULLA-ORCH-VOCAB-R009.100 -- one tool invocation of a run, hung from its :RunTrace." ;
    rdfs:seeAlso prov:Activity .

:hasChildRun a owl:ObjectProperty ;
    rdfs:label "hasChildRun" ;
    rdfs:comment "MEDULLA-ORCH-VOCAB-R009.100 -- RunTrace -[:hasChildRun]-> RunTrace: the run a parent run delegated to a child agent. A declared child edge of the correlated trace export." ;
    rdfs:domain :RunTrace ;
    rdfs:range :RunTrace .

:hasSpan a owl:ObjectProperty ;
    rdfs:label "hasSpan" ;
    rdfs:comment "MEDULLA-ORCH-VOCAB-R009.100 -- RunTrace -[:hasSpan]-> Span. A declared child edge of the correlated trace export." ;
    rdfs:domain :RunTrace ;
    rdfs:range :Span .

:hasToolCall a owl:ObjectProperty ;
    rdfs:label "hasToolCall" ;
    rdfs:comment "MEDULLA-ORCH-VOCAB-R009.100 -- RunTrace -[:hasToolCall]-> ToolCall. A declared child edge of the correlated trace export." ;
    rdfs:domain :RunTrace ;
    rdfs:range :ToolCall .

:declaredSpans a owl:DatatypeProperty ;
    rdfs:label "declaredSpans" ;
    rdfs:comment "MEDULLA-ORCH-VOCAB-R009.100 -- the span node ids a run declared it produced, as a JSON array of strings. The export is complete only when each one is present." ;
    rdfs:domain :RunTrace ;
    rdfs:range xsd:string .

:hasMessage a owl:ObjectProperty ;
    rdfs:label "hasMessage" ;
    rdfs:comment "CONCEPT:ORCH-1.40 — Session -[:HAS_MESSAGE]-> AgentMessage durable-history edge." ;
    rdfs:domain :Session ;
    rdfs:range :AgentMessage .

:hasPrompt a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Agent :ProcessStep ) ] ;
    rdfs:range :Prompt .

:hasRun a owl:ObjectProperty ;
    rdfs:label "hasRun" ;
    rdfs:comment "CONCEPT:ORCH-1.40 — Session -[:HAS_RUN]-> RunTrace edge (spawned runs anchored to their session)." ;
    rdfs:domain :Session .

:hasSkill a owl:ObjectProperty ;
    rdfs:domain :Agent ;
    rdfs:range :Skill .

:idempotencyKey a owl:DatatypeProperty ;
    rdfs:label "idempotency key" ;
    rdfs:comment """CONCEPT:AU-KG.storage.durable-execution-unit — mirrors the owning
    backend's real idempotency key (medulla-mutation-store's `MutationBatch.idempotency_key`
    ledger entry, medulla-jobs' `claim_idempotency`/`result_ref` hash, or
    DurableExecutionManager's per-action key). Exactly-once dedup already exists in all four
    backends today (durable-execution-native.md Part 1 row 3, 'not a gap') — this property
    only makes the existing key KG-visible, it does not add a new dedup mechanism.""" ;
    rdfs:domain :DurableExecutionUnit ;
    rdfs:range xsd:string .

:intelligenceLevel a owl:DatatypeProperty ;
    rdfs:domain :Model ;
    rdfs:range xsd:string .

:lastSeen a owl:DatatypeProperty ;
    rdfs:label "last seen" ;
    rdfs:comment "CONCEPT:KG-2.141 — unix timestamp of a BusAgent's most recent heartbeat on the bus (ECO-4.84)." ;
    rdfs:domain :BusAgent ;
    rdfs:range xsd:double .

:leaseEpoch a owl:DatatypeProperty ;
    rdfs:label "lease epoch" ;
    rdfs:comment """CONCEPT:AU-KG.storage.durable-execution-unit — mirrors medulla-jobs' monotonic
    fencing epoch (`AnalyticsJob.lease_epoch`, bumped by `claim_next`/`renew_lease` so a
    reclaimed lease can never be honored by a stale worker). Present only on units whose
    owning backend has fenced leases (medulla-jobs today); absent on medulla-statechart/DurableRun/saga
    mirrors, which have no lease concept.""" ;
    rdfs:domain :DurableExecutionUnit ;
    rdfs:range xsd:integer .

:maxAttempts a owl:DatatypeProperty ;
    rdfs:label "max attempts" ;
    rdfs:domain :WorkItem ;
    rdfs:range xsd:integer .

:memberOfTeam a owl:ObjectProperty ;
    rdfs:domain :Agent ;
    rdfs:range :Team .

:orchestrates a owl:ObjectProperty ;
    rdfs:comment "Workflow → the agents/skills it orchestrates." ;
    rdfs:domain :Workflow .

:presenceStatus a owl:DatatypeProperty ;
    rdfs:label "presence status" ;
    rdfs:comment "CONCEPT:KG-2.141 — a BusAgent's bus presence (online|offline), computed from lastSeen vs a staleness window (ECO-4.84)." ;
    rdfs:domain :BusAgent ;
    rdfs:range xsd:string .

:prioBucket a owl:DatatypeProperty ;
    rdfs:label "priority bucket" ;
    rdfs:comment "CONCEPT:KG-2.113 — discrete claim/intake priority 0 (critical) .. 3 (background) for a WorkItem, Schedule, or Loop." ;
    rdfs:range xsd:integer .

:produced a owl:ObjectProperty ;
    rdfs:label "produced" ;
    rdfs:comment """CONCEPT:AU-KG.storage.durable-execution-unit — DurableExecutionUnit
    -[:PRODUCED]-> RunTrace: the durable unit that backs (or was invoked from) one agent
    run, completing RunTrace's existing but one-directional durability linkage
    (`graph_checkpoint_ids`/`graph_resume_supported`, CONCEPT:AU-KG.temporal.message-history-read)
    with the reverse edge from the unit itself, per `durable-execution-native.md` Part 3's
    ontology model. DE0 reserves the schema; DE1 populates it on mirror-write.""" ;
    owl:inverseOf :producedBy .

:proposesCommit a owl:ObjectProperty ;
    rdfs:label "proposes commit" ;
    rdfs:comment "CONCEPT:AU-ORCH.runvcs.retained-output-gate — RetainedRunProposal -[:PROPOSES_COMMIT]-> the RunCommit it would materialize on accept." ;
    rdfs:domain :RetainedRunProposal ;
    rdfs:range :RunCommit .

:realizesProcess a owl:ObjectProperty ;
    rdfs:label "realizesProcess" ;
    rdfs:comment """CONCEPT:ORCH-1.41 — a compiled executable Workflow REALIZES the
    descriptive BusinessProcess it was derived from (REALIZES in the LPG;
    written by the ProcessPlanCompiler). The bridge between the harvested
    process world (Camunda/Egeria/ArchiMate) and the executable workflow
    world, traversed by lineage close-out and provenance queries.""" ;
    rdfs:domain :Workflow ;
    rdfs:range :BusinessProcess .

:recordDigest a owl:DatatypeProperty ;
    rdfs:label "record digest" ;
    rdfs:comment "CONCEPT:AU-ORCH.runvcs.event-kernel — the content hash that is a RunEvent's identity (record_id == digest)." ;
    rdfs:domain :RunEvent ;
    rdfs:range xsd:string .

:recordMode a owl:DatatypeProperty ;
    rdfs:label "record mode" ;
    rdfs:comment "CONCEPT:AU-ORCH.runvcs.trace-replay — a RunEvent's mode: 'declaration' (intent) or 'capture' (observed outcome); the split that makes a recorded exchange stand in for the model on replay." ;
    rdfs:domain :RunEvent ;
    rdfs:range xsd:string .

:reportsTo a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:comment "Team reporting hierarchy (transitive)." .

:schedules a owl:ObjectProperty ;
    rdfs:label "schedules" ;
    rdfs:comment "CONCEPT:OS-5.44 — a Schedule SCHEDULES the WorkItem it enqueues when due." ;
    rdfs:domain :Schedule ;
    rdfs:range :WorkItem ;
    owl:inverseOf :scheduledBy .

:snapshotId a owl:DatatypeProperty ;
    rdfs:label "snapshot id" ;
    rdfs:comment "CONCEPT:AU-ORCH.runvcs.run-commit — an FsSnapshot's content-addressed id (digest of its file manifest)." ;
    rdfs:domain :FsSnapshot ;
    rdfs:range xsd:string .

:snapshots a owl:ObjectProperty ;
    rdfs:label "snapshots" ;
    rdfs:comment "CONCEPT:AU-ORCH.runvcs.run-commit — RunCommit -[:SNAPSHOTS]-> FsSnapshot (the filesystem captured by a commit)." ;
    rdfs:domain :RunCommit ;
    rdfs:range :FsSnapshot .

:solves a owl:ObjectProperty ;
    rdfs:comment "An Agent or Team that addresses a Goal." ;
    rdfs:range :Goal .

:subscribesToTopic a owl:ObjectProperty ;
    rdfs:label "subscribesToTopic" ;
    rdfs:comment "CONCEPT:KG-2.141 — BusSubscription -> the Topic it subscribes a BusAgent to (ECO-4.84)." ;
    rdfs:domain :BusSubscription ;
    rdfs:range :Topic .

:systemPrompt a owl:DatatypeProperty ;
    rdfs:domain :Agent ;
    rdfs:range xsd:string .

:usesModel a owl:ObjectProperty ;
    rdfs:comment "The model an agent runs on, chosen by capability/complexity." ;
    rdfs:domain :Agent ;
    rdfs:range :Model .

:usesTool a owl:ObjectProperty .

<https://knuckles-team.github.io/ontology/orchestration> a owl:Ontology ;
    rdfs:label "Agent Intelligence Graph — Orchestration Module" ;
    rdfs:comment "Orchestration domain extension (skill proposals, workflow/process distillation). Imported by the canonical <https://knuckles-team.github.io/ontology/core> ontology; resolved to ontology_orchestration.ttl by the local loader convention." .

:AgentMessage a owl:Class ;
    rdfs:label "AgentMessage" ;
    rdfs:comment "CONCEPT:ORCH-1.40 — a durable, replayable record of one message exchanged on an invoker↔spawned-agent channel (the live channel is in-RAM; this node is the durable record)." .

:BusMessage a owl:Class ;
    rdfs:label "BusMessage" ;
    rdfs:comment """CONCEPT:KG-2.141 — a durable agent-to-agent bus message delivered to one
    recipient Agent (the AgentBus mailbox record, ECO-4.84). A topic fan-out writes one
    BusMessage per recipient sharing a msg_group, so a federation relay can dedup across hubs.
    Store-and-forward (CONCEPT:ECO-4.91) also writes a topic-log variant (recipient="",
    kind="topic", expires_at) replayed to late subscribers via a BusTopicCursor.""" .

:BusSubscription a owl:Class ;
    rdfs:label "BusSubscription" ;
    rdfs:comment """CONCEPT:KG-2.141 — a BusAgent's subscription to a Topic, modeled as a node
    (not an edge) so membership resolves in one hop on every backend (ECO-4.84).""" .

:ErrorDetail a owl:Class ;
    rdfs:label "ErrorDetail" ;
    rdfs:comment """CONCEPT:AU-KG.audit.durable-error-detail — the durable backend behind
    a public failure envelope's opaque `error.detail_ref` (D-24): a sanitized, tenant-scoped
    error_class/failing_layer/traceback bundle, keyed by the same correlation id already
    logged and returned to the caller, so the ref stays resolvable past this process's
    lifetime and across replicas (`GraphErrorDetailSink`,
    in the meristem harness). Never carries the raw exception
    message — only what the meristem harness
    already sanitized through the persistence-privacy gate before handing it to the sink.""" ;
    rdfs:seeAlso prov:Entity .

:Goal
    rdfs:label "Goal" .

:Loop a owl:Class ;
    rdfs:label "Loop" ;
    rdfs:comment """CONCEPT:KG-2.78 — a long-running objective (research|develop|skill)
    the LoopController advances through one hot path; carries a priority bucket and may
    enqueue prioritized child WorkItems.""" ;
    rdfs:seeAlso prov:Activity .

:RetainedRunProposal a owl:Class ;
    rdfs:label "Retained Run Proposal" ;
    rdfs:comment """CONCEPT:AU-ORCH.runvcs.retained-output-gate — a completed run's world delta
    (its final :RunCommit + any KG edits) HELD as a proposal, materialized into the real world
    only when the run.select action-policy gate accepts; discard leaves the world untouched.""" ;
    rdfs:subClassOf :SkillProposal .

:SagaCoordination a owl:Class ;
    rdfs:label "SagaCoordination" ;
    rdfs:comment """CONCEPT:AU-KG.txn.saga-coordination-mirror — mirrors one
    `medulla-mutation-store` saga (`SagaBegin::{Execute,Resume,Committed}`, coordinated by the
    real, generic, crash-recoverable `prepare_saga`/`commit_saga` functions with encrypted
    private recovery payloads) — a compensation/rollback primitive restate itself does not
    ship (durable-execution-native.md Part 1 row 6, 'we are ahead here'). :backendRef is the
    coordinator's `batch_id`; :durableStatus mirrors `MutationBatchStatus`
    (`Prepared`|`Committed`|`Aborted`); :idempotencyKey mirrors the batch's own
    `idempotency_key` ledger entry.""" ;
    rdfs:subClassOf :DurableExecutionUnit .

:SkillProposal a owl:Class ;
    rdfs:label "Skill Proposal" ;
    rdfs:comment "CONCEPT:KG-2.90 — a propose-only atomic-skill candidate the background distiller synthesizes from a mapped process/task of any connected system; reviewed+approved by a human before it materializes." .

:Team
    rdfs:label "Team" ;
    rdfs:comment "A hierarchical group of specialized agents for a goal." .

:Tool
    rdfs:label "Tool" .

:Topic
    rdfs:label "Topic" ;
    rdfs:comment "CONCEPT:KG-2.141 — a named pub/sub channel on the AgentBus that BusAgents subscribe to (ECO-4.84)." .

:derivedFrom a owl:ObjectProperty ;
    rdfs:label "derived from" ;
    rdfs:comment """CONCEPT:KG-2.91 — provenance: a SkillProposal / SkillWorkflow
    proposal DERIVED_FROM the source system node (egeria/leanix/aris/camunda
    process or task) it was distilled from. Inverse of :derives so reasoning can
    walk source→proposal and proposal→source.""" .

:enqueuedBy a owl:ObjectProperty ;
    rdfs:label "enqueued by" ;
    rdfs:domain :WorkItem .

:producedBy a owl:ObjectProperty ;
    rdfs:label "produced by" ;
    rdfs:comment "CONCEPT:AU-KG.storage.durable-execution-unit — inverse of :produced (RunTrace -> the DurableExecutionUnit that backs it)." ;
    rdfs:domain :RunTrace ;
    rdfs:range :DurableExecutionUnit .

:scheduledBy a owl:ObjectProperty ;
    rdfs:label "scheduled by" ;
    rdfs:domain :WorkItem ;
    rdfs:range :Schedule .

:ContextBlob a owl:Class ;
    rdfs:label "ContextBlob" ;
    rdfs:comment "CONCEPT:ORCH-1.39 — curated context an invoking agent persists for a spawned agent to reference (session-scoped, optionally TTL'd)." .

:FsSnapshot a owl:Class ;
    rdfs:label "FsSnapshot" ;
    rdfs:comment """CONCEPT:AU-ORCH.runvcs.run-commit — a content-addressed copy-on-write
    snapshot of a run's workspace filesystem (overlayfs/fuse-overlayfs accelerated, blob-store
    fallback); the fs half of a :RunCommit's exact-world restore.""" .

:Schedule a owl:Class ;
    rdfs:label "Schedule" ;
    rdfs:comment """CONCEPT:OS-5.44 — a durable recurring-job specification
    (cron | interval | adaptive) the ONE unified scheduler evaluates; when due it
    enqueues a scheduled_job WorkItem onto the native priority+scheduled queue.""" ;
    rdfs:seeAlso prov:Activity .

:Skill
    rdfs:label "Skill" .

:BusAgent a owl:Class ;
    rdfs:label "BusAgent" ;
    rdfs:comment """CONCEPT:KG-2.141 — a participant on the AgentBus (a session: Claude/other-LLM/
    any provider, any host), with presence + capabilities (ECO-4.84). A dedicated class (not the
    typed orchestration :Agent) so bus props land in the generic node store across backends.""" .

:Prompt a owl:Class ;
    rdfs:label "Prompt" .

:Session a owl:Class ;
    rdfs:label "Session" ;
    rdfs:comment "CONCEPT:ORCH-1.40 — id-addressable anchor (session:{sid}) for a session's collections; lets 'list by session' be a reliable single-hop traversal on a property-index-free engine." .

:Workflow a owl:Class ;
    rdfs:label "Workflow" ;
    rdfs:comment "An orchestration flow (skill-workflow) over agents/skills." .

:Model a owl:Class ;
    rdfs:label "Model" ;
    rdfs:comment "An LLM/embedding model the deployment serves, with capabilities (from config.json) used to choose the right model per task." .

:RunCommit a owl:Class ;
    rdfs:label "RunCommit" ;
    rdfs:comment """CONCEPT:AU-ORCH.runvcs.run-commit — ONE content-addressed commit binding a
    message checkpoint + an :FsSnapshot + a :RunCut (the process/event frontier) so a run's
    conversation, files, and effects revert together as one exact world.""" ;
    rdfs:seeAlso prov:Entity .

:RunEvent a owl:Class ;
    rdfs:label "RunEvent" ;
    rdfs:comment """CONCEPT:AU-ORCH.runvcs.event-kernel — one typed, content-addressed run event
    (shepherd Fact shape). Its :recordDigest IS its identity (record_id == digest over
    schema_ref+mode+payload+causality), so identical events dedup and replay is reproducible.
    :recordMode is a declaration (intent) or a capture (observed outcome).""" ;
    rdfs:seeAlso prov:Entity .

:RunObservationWindow a owl:Class ;
    rdfs:label "RunObservationWindow" ;
    rdfs:subClassOf bfo:0000001 ;
    rdfs:comment "One measured-or-unknown observation window of a :RunTrace (MEDULLA-ORCH-VOCAB-R009.18.1)." .

:DurableUnit a owl:Class ;
    rdfs:label "DurableUnit" ;
    rdfs:subClassOf :DurableExecutionUnit ;
    rdfs:comment "One durable run unit mirrored as a node linked to its :RunTrace (MEDULLA-ORCH-VOCAB-R009.700)." .

:RunTrace a owl:Class ;
    rdfs:label "RunTrace" ;
    rdfs:comment """CONCEPT:AU-ORCH.runvcs.event-kernel — one agent run, now the root of a
    content-addressed, typed run-event log (not just an observe-only action chain). Owns an
    ordered :RunEvent path plus the :RunCommit history a fork/revert branches from.""" ;
    rdfs:seeAlso prov:Activity .

:EvolutionProgress a owl:Class ;
    rdfs:label "EvolutionProgress" ;
    rdfs:comment """MEDULLA-ORCH-VOCAB-R010.100 -- the harness's progress record of one evolution
    proposal: the proposal and prompt it tests, the metric window it measures and the ordered
    run ids of its source traces. A :RunTrace joins by its node id, which equals a listed run id.""" ;
    rdfs:subClassOf prov:Entity .

:proposalId a owl:DatatypeProperty ;
    rdfs:label "proposalId" ;
    rdfs:domain :EvolutionProgress ;
    rdfs:range xsd:string .

:proposalRevision a owl:DatatypeProperty ;
    rdfs:label "proposalRevision" ;
    rdfs:domain :EvolutionProgress ;
    rdfs:range xsd:integer .

:promptVersionId a owl:DatatypeProperty ;
    rdfs:label "promptVersionId" ;
    rdfs:domain :EvolutionProgress ;
    rdfs:range xsd:string .

:promptRevision a owl:DatatypeProperty ;
    rdfs:label "promptRevision" ;
    rdfs:domain :EvolutionProgress ;
    rdfs:range xsd:integer .

:metricWindowId a owl:DatatypeProperty ;
    rdfs:label "metricWindowId" ;
    rdfs:domain :EvolutionProgress ;
    rdfs:range xsd:string .

:metricWindowRevision a owl:DatatypeProperty ;
    rdfs:label "metricWindowRevision" ;
    rdfs:domain :EvolutionProgress ;
    rdfs:range xsd:integer .

:sourceRunIds a owl:DatatypeProperty ;
    rdfs:label "sourceRunIds" ;
    rdfs:comment "A JSON array of the source run ids, in run order." ;
    rdfs:domain :EvolutionProgress ;
    rdfs:range xsd:string .

:observedAtMs a owl:DatatypeProperty ;
    rdfs:label "observedAtMs" ;
    rdfs:domain :EvolutionProgress ;
    rdfs:range xsd:integer .

:CompiledProgram a owl:Class ;
    rdfs:label "CompiledProgram" ;
    rdfs:comment """MEDULLA-DECISION-ENGINE-R135.5 — the stored state-machine program a
    successful run compiled into, keyed by task signature. The node `DecisionLog` writes for a
    committed program carries this class as its typed label and links to its source :RunTrace
    with :compiledFrom.""" ;
    rdfs:subClassOf :Procedure .

:compiledFrom a owl:ObjectProperty ;
    rdfs:label "compiled from" ;
    rdfs:comment "MEDULLA-DECISION-ENGINE-R135.5 — CompiledProgram -[:compiledFrom]-> the engine-recorded RunTrace it was compiled from." ;
    rdfs:domain :CompiledProgram ;
    rdfs:range :RunTrace .

:ProgramPhrasing a owl:Class ;
    rdfs:label "ProgramPhrasing" ;
    rdfs:subClassOf bfo:0000001 ;
    rdfs:comment "MEDULLA-DECISION-ENGINE-R135.16.3 — one wording of the request a CompiledProgram answers, embedded so a lookup finds the program by meaning." .

:phrasingOf a owl:ObjectProperty ;
    rdfs:label "phrasing of" ;
    rdfs:comment "MEDULLA-DECISION-ENGINE-R135.16.3 — ProgramPhrasing -[:phrasingOf]-> the CompiledProgram it words." ;
    rdfs:domain :ProgramPhrasing ;
    rdfs:range :CompiledProgram .

:WorkflowPattern a owl:Class ;
    rdfs:label "WorkflowPattern" ;
    rdfs:subClassOf bfo:0000001 ;
    rdfs:comment "The stored, versioned canonical workflow written by the served process compile and process import (MEDULLA-CQ-ORCH-R700.3)." .

:compiledFromProcess a owl:ObjectProperty ;
    rdfs:label "compiled from process" ;
    rdfs:comment "MEDULLA-CQ-ORCH-R700.5 — WorkflowPattern -[:compiledFromProcess]-> the process model it was compiled from. The edge carries processRevision, compilerId and workflowDigest. Distinct from :compiledFrom, which links a CompiledProgram to its RunTrace." ;
    rdfs:domain :WorkflowPattern ;
    rdfs:range :ProcessModel .

:RecursiveTraceNode a owl:Class ;
    rdfs:label "RecursiveTraceNode" ;
    rdfs:subClassOf :RunTrace ;
    rdfs:comment "One code run, sub-call or intermediate of a recursive reasoning run, stored at terminal commit and linked to its parent node by :child_of (MEDULLA-DECISION-ENGINE-R133.7)." .

:Agent
    rdfs:label "Agent" ;
    rdfs:comment "A synthesized or registered agent (prompt + tools + skills)." .

:DurableExecutionUnit a owl:Class ;
    rdfs:label "DurableExecutionUnit" ;
    rdfs:comment """CONCEPT:AU-KG.storage.durable-execution-unit — the abstract KG-queryable
    concept family unifying durable execution across `medulla-statechart`, `medulla-jobs`,
    `medulla-mutation-store`'s saga coordinator, and agent-utilities' `DurableExecutionManager`/
    `DurableRun` (register `D-DE-1`, plan `plans/au-medulla-program/program/durable-execution-native.md`).
    A :DurableExecutionUnit node is a PROVENANCE MIRROR, not a second store — see :backendRef;
    the authoritative state always stays in the owning backend's own durable store (redb
    `MachineInstance`, redb `AnalyticsJob`, `medulla-mutation-store`'s `MutationBatchRecord`, or the
    SQLite-/Postgres-backed `DurableExecutionManager` checkpoint row). Mirroring these
    mirrored properties onto this node is what makes 'what is durably in flight, for whom,
    waiting on what' answerable as ONE KG query across all four subsystems, without the
    caller already knowing any of their names — the actual gap this program closes (the
    mechanisms themselves already exist and are not reimplemented here). Populated
    mirror-on-next-write (DE1), never a bulk migration — the same pattern this ontology's own
    RunTrace checkpoint linkage already uses. Concrete subclasses: :StatechartInstance,
    :AnalyticsJob, :SagaCoordination, :DurableRun.""" ;
    rdfs:seeAlso prov:Entity .

:orchestrationDelegatesTo a owl:ObjectProperty ;
    rdfs:label "delegatesTo (orchestration)" ;
    rdfs:comment "The orchestration module's meaning of the shared kg:delegatesTo: it carries this module's domain and range so that the shared property carries none (a module must not constrain a shared property)." ;
    rdfs:subPropertyOf :delegatesTo ;
    rdfs:domain :Agent .

:orchestrationProduced a owl:ObjectProperty ;
    rdfs:label "produced (orchestration)" ;
    rdfs:comment "The orchestration module's meaning of the shared kg:produced: it carries this module's domain and range so that the shared property carries none (a module must not constrain a shared property)." ;
    rdfs:subPropertyOf :produced ;
    rdfs:domain :DurableExecutionUnit ;
    rdfs:range :RunTrace .

:orchestrationReportsTo a owl:ObjectProperty ;
    rdfs:label "reportsTo (orchestration)" ;
    rdfs:comment "The orchestration module's meaning of the shared kg:reportsTo: it carries this module's domain and range so that the shared property carries none (a module must not constrain a shared property)." ;
    rdfs:subPropertyOf :reportsTo ;
    rdfs:domain :Agent ;
    rdfs:range :Agent .

:orchestrationUsesTool a owl:ObjectProperty ;
    rdfs:label "usesTool (orchestration)" ;
    rdfs:comment "The orchestration module's meaning of the shared kg:usesTool: it carries this module's domain and range so that the shared property carries none (a module must not constrain a shared property)." ;
    rdfs:subPropertyOf :usesTool ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Agent :ProcessStep ) ] ;
    rdfs:range :Tool .

# MEDULLA-ORCH-VOCAB-R009.1 through R009.8: measured harness run properties.

:terminationReason a owl:DatatypeProperty ;
    rdfs:label "terminationReason" ;
    rdfs:domain :RunTrace ;
    rdfs:range xsd:string .

:peakContextTokens a owl:DatatypeProperty ;
    rdfs:label "peakContextTokens" ;
    rdfs:domain :RunTrace ;
    rdfs:range xsd:integer .

:contextBudgetTokens a owl:DatatypeProperty ;
    rdfs:label "contextBudgetTokens" ;
    rdfs:domain :RunTrace ;
    rdfs:range xsd:integer .

:elisionCount a owl:DatatypeProperty ;
    rdfs:label "elisionCount" ;
    rdfs:domain :RunTrace ;
    rdfs:range xsd:integer .

:summarizationCount a owl:DatatypeProperty ;
    rdfs:label "summarizationCount" ;
    rdfs:domain :RunTrace ;
    rdfs:range xsd:integer .

:turnCount a owl:DatatypeProperty ;
    rdfs:label "turnCount" ;
    rdfs:domain :RunTrace ;
    rdfs:range xsd:integer .

:toolCallCount a owl:DatatypeProperty ;
    rdfs:label "toolCallCount" ;
    rdfs:domain :RunTrace ;
    rdfs:range xsd:integer .

:costUsd a owl:DatatypeProperty ;
    rdfs:label "costUsd" ;
    rdfs:domain :RunTrace ;
    rdfs:range xsd:decimal .

# MEDULLA-ORCH-VOCAB-R010.101: usage attribution and the four disjoint token
# counters of an immutable trace, read by the `run_trace_usage` statement.
:projectId a owl:DatatypeProperty ;
    rdfs:label "projectId" ;
    rdfs:comment "The project a run is attributed to (MEDULLA-ORCH-VOCAB-R010.101)." ;
    rdfs:domain :RunTrace ;
    rdfs:range xsd:string .

:agentId a owl:DatatypeProperty ;
    rdfs:label "agentId" ;
    rdfs:comment "The agent a run is attributed to (MEDULLA-ORCH-VOCAB-R010.101)." ;
    rdfs:domain :RunTrace ;
    rdfs:range xsd:string .

:accountingRevision a owl:DatatypeProperty ;
    rdfs:label "accountingRevision" ;
    rdfs:comment "The usage accounting revision a run's counters were measured under (MEDULLA-ORCH-VOCAB-R010.101)." ;
    rdfs:domain :RunTrace ;
    rdfs:range xsd:string .

:completedAtMs a owl:DatatypeProperty ;
    rdfs:label "completedAtMs" ;
    rdfs:comment "When a run completed, in Unix milliseconds; the usage window reads it (MEDULLA-ORCH-VOCAB-R010.101)." ;
    rdfs:domain :RunTrace ;
    rdfs:range xsd:integer .

:uncachedInputTokens a owl:DatatypeProperty ;
    rdfs:label "uncachedInputTokens" ;
    rdfs:domain :RunTrace ;
    rdfs:range xsd:integer .

:cachedInputTokens a owl:DatatypeProperty ;
    rdfs:label "cachedInputTokens" ;
    rdfs:domain :RunTrace ;
    rdfs:range xsd:integer .

:outputTokens a owl:DatatypeProperty ;
    rdfs:label "outputTokens" ;
    rdfs:domain :RunTrace ;
    rdfs:range xsd:integer .

:reasoningOutputTokens a owl:DatatypeProperty ;
    rdfs:label "reasoningOutputTokens" ;
    rdfs:domain :RunTrace ;
    rdfs:range xsd:integer .

:PriceTable a owl:Class ;
    rdfs:label "PriceTable" ;
    rdfs:subClassOf prov:Entity, bfo:0000031 ;
    rdfs:comment """One governed revision of model token prices (MEDULLA-ORCH-VOCAB-R010.101): an
    integer minor-unit numerator per one million tokens, keyed by model and token category, in one
    currency. A revision is a GovernedSet revision (MEDULLA-DECISION-ENGINE-R805.10).""" .

# MEDULLA-ORCH-VOCAB-R013.5: each stored step of a trace carries its order and
# the verified principal that wrote it; steps stay properties of the trace node.
:stepIndex a owl:DatatypeProperty ;
    rdfs:label "stepIndex" ;
    rdfs:domain :RunTrace ;
    rdfs:range xsd:integer .

:recordedBy a owl:DatatypeProperty ;
    rdfs:label "recordedBy" ;
    rdfs:domain :RunTrace ;
    rdfs:range xsd:string .

# MEDULLA-ORCH-VOCAB-R001 through R006: task steps, agent kinds, library membership,
# per-step bindings and hand-off. Step order reuses the core :precedes.

:hasStep a owl:ObjectProperty ;
    rdfs:label "hasStep" ;
    rdfs:comment "A task has an ordered step. No domain: a task is any class-typed IRI. Step order is the core :precedes." ;
    rdfs:range :TaskStep .

:AgentKind a owl:Class ;
    rdfs:label "Agent Kind" ;
    rdfs:comment "The kind of work a slot needs and an agent does. Kinds are named individuals, so a slot constraint is a value; a tenant adds kinds under its own schema key." .

:agentKindSupervisor a :AgentKind ; rdfs:label "supervisor" .
:agentKindWorker a :AgentKind ; rdfs:label "worker" .
:agentKindVerifier a :AgentKind ; rdfs:label "verifier" .
:agentKindAggregator a :AgentKind ; rdfs:label "aggregator" .
:agentKindPlanner a :AgentKind ; rdfs:label "planner" .
:agentKindResearcher a :AgentKind ; rdfs:label "researcher" .
:agentKindExecutor a :AgentKind ; rdfs:label "executor" .

:hasAgentKind a owl:ObjectProperty ;
    rdfs:label "hasAgentKind" ;
    rdfs:comment "The kind an agent fills, or the kind of agent a process lane names (MEDULLA-ORCH-VOCAB-R014.4)." ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Agent :ProcessLane ) ] ;
    rdfs:range :AgentKind .

:AgentTemplate a owl:Class ;
    rdfs:label "Agent Template" ;
    rdfs:comment "A parameterized agent stored in the Agent Library. It is an agent: every agent property applies. It is not a swarm topology template." ;
    rdfs:subClassOf :Agent .

:AgentLibrary a owl:Class ;
    rdfs:label "Agent Library" ;
    rdfs:comment "The set of agents, agent templates and A2A agent cards an assembly may use." .

:memberOfLibrary a owl:ObjectProperty ;
    rdfs:label "memberOfLibrary" ;
    rdfs:comment "An agent, agent template or A2A agent card belongs to an Agent Library. No domain: members come from three classes." ;
    rdfs:range :AgentLibrary .

:instanceOfTemplate a owl:ObjectProperty ;
    rdfs:label "instanceOfTemplate" ;
    rdfs:comment "An agent instantiates an agent template." ;
    rdfs:domain :Agent ;
    rdfs:range :AgentTemplate .

:ModelProfile a owl:Class ;
    rdfs:label "Model Profile" ;
    rdfs:comment "A model with its measured or declared profile; :usesModel and :contextWindow apply." ;
    rdfs:subClassOf :Model .

:needsSkill a owl:ObjectProperty ;
    rdfs:label "needsSkill" ;
    rdfs:comment "A task step needs a skill." ;
    rdfs:domain :TaskStep ;
    rdfs:range :Skill .

:stepAssignedAgent a owl:ObjectProperty ;
    rdfs:label "stepAssignedAgent" ;
    rdfs:comment "The agent or A2A agent card assigned to a task step. No range: :assignedAgent is range-restricted to an A2A card and is left alone." ;
    rdfs:domain :TaskStep .

:handsOffTo a owl:ObjectProperty ;
    rdfs:label "handsOffTo" ;
    rdfs:comment "A step hands its output directly to the next step. A direct hand-off implies precedence." ;
    rdfs:subPropertyOf :precedes ;
    rdfs:domain :TaskStep ;
    rdfs:range :TaskStep .

# MEDULLA-CQ-ORCH-R700.2: a property of a :handsOffTo edge, not of a node.
:loopGate a owl:DatatypeProperty ;
    rdfs:label "loopGate" ;
    rdfs:comment "Set to true on a :handsOffTo edge that closes a cycle on purpose. A cycle of hand-offs compiles only when one of its edges carries it." ;
    rdfs:range xsd:boolean .

# MEDULLA-ORCH-VOCAB-R009.9 through R009.11: what a harness run applied and ran on.

:TaskClass a owl:Class ;
    rdfs:label "Task Class" ;
    rdfs:comment "A class of task a harness run belongs to." .

:appliedHarnessConfig a owl:ObjectProperty ;
    rdfs:label "appliedHarnessConfig" ;
    rdfs:comment "The committed HarnessConfig decision a run applied." ;
    rdfs:domain :RunTrace ;
    rdfs:range :Decision .

:runModel a owl:ObjectProperty ;
    rdfs:label "runModel" ;
    rdfs:comment "The model profile a run used. :usesModel has an agent domain, so per-model run queries use this property." ;
    rdfs:domain :RunTrace ;
    rdfs:range :ModelProfile .

:runTaskClass a owl:ObjectProperty ;
    rdfs:label "runTaskClass" ;
    rdfs:comment "The task class a run belongs to." ;
    rdfs:domain :RunTrace ;
    rdfs:range :TaskClass .

# MEDULLA-DECISION-ENGINE-R133.3: the per-class run quota overrides a task class holds.

:defaultWallTimeMs a owl:DatatypeProperty ;
    rdfs:label "defaultWallTimeMs" ;
    rdfs:comment "The wall time in milliseconds a run of this task class gets by default, clamped to the fixed ceiling." ;
    rdfs:domain :TaskClass ;
    rdfs:range xsd:integer .

:defaultMemoryBytes a owl:DatatypeProperty ;
    rdfs:label "defaultMemoryBytes" ;
    rdfs:comment "The memory in bytes a run of this task class gets by default, clamped to the fixed ceiling." ;
    rdfs:domain :TaskClass ;
    rdfs:range xsd:integer .

:defaultProcessCount a owl:DatatypeProperty ;
    rdfs:label "defaultProcessCount" ;
    rdfs:comment "The process count a run of this task class gets by default, clamped to the fixed ceiling." ;
    rdfs:domain :TaskClass ;
    rdfs:range xsd:integer .

:defaultGraceMs a owl:DatatypeProperty ;
    rdfs:label "defaultGraceMs" ;
    rdfs:comment "The grace period in milliseconds before a run of this task class is killed, clamped to the fixed ceiling." ;
    rdfs:domain :TaskClass ;
    rdfs:range xsd:integer .

# MEDULLA-ORCH-VOCAB-R011.1 through R011.5: measured model facts from evaluation.

:EvaluationRun a owl:Class ;
    rdfs:label "Evaluation Run" ;
    rdfs:comment "One matched ablation run. Its traces link through :hasEvent or :produced." ;
    rdfs:subClassOf :RunTrace .

:MeasuredModelFact a owl:Class ;
    rdfs:label "Measured Model Fact" ;
    rdfs:comment "One measured value of one property of one model profile, cited to the evaluation run that measured it." .

:factOfModel a owl:ObjectProperty ;
    rdfs:label "factOfModel" ;
    rdfs:comment "The model profile a measured fact describes." ;
    rdfs:domain :MeasuredModelFact ;
    rdfs:range :ModelProfile .

:measuredProperty a owl:DatatypeProperty ;
    rdfs:label "measuredProperty" ;
    rdfs:comment "The model property a measured fact records: shellProficiency, stoppingBehaviour or contextWindowTokens." ;
    rdfs:domain :MeasuredModelFact ;
    rdfs:range xsd:string .

:measuredValue a owl:DatatypeProperty ;
    rdfs:label "measuredValue" ;
    rdfs:comment "The measured value. Its value set depends on :measuredProperty." ;
    rdfs:domain :MeasuredModelFact .

:evidencedByRun a owl:ObjectProperty ;
    rdfs:label "evidencedByRun" ;
    rdfs:comment "The evaluation run that measured a fact." ;
    rdfs:domain :MeasuredModelFact ;
    rdfs:range :EvaluationRun .

:measuredSupersedes a owl:ObjectProperty ;
    rdfs:label "measuredSupersedes" ;
    rdfs:comment "A newer measurement replaces an older one by this edge, never by deletion." ;
    rdfs:domain :MeasuredModelFact ;
    rdfs:range :MeasuredModelFact .

# MEDULLA-CQ-CONN-R079.2 through R079.5: the langfuse trace/prompt measurements the
# connector maps its records onto (prompt versioning, token cost, prompt linkage
# and evaluation scores).

:promptVersion a owl:DatatypeProperty ;
    rdfs:label "promptVersion" ;
    rdfs:comment "The integer version of the :Prompt a trace ran against; versioned prompts keep traces comparable across edits." ;
    rdfs:domain :Prompt ;
    rdfs:range xsd:integer .

:tokenCost a owl:DatatypeProperty ;
    rdfs:label "tokenCost" ;
    rdfs:comment "Token cost recorded for one :RunTrace (the usage total the trace's provider reported). An optional measurement; a recorded zero is valid." ;
    rdfs:domain :RunTrace ;
    rdfs:range xsd:decimal .

:tracePrompt a owl:ObjectProperty ;
    rdfs:label "tracePrompt" ;
    rdfs:comment "Links a :RunTrace to the :Prompt it ran (the prompt whose content the trace's model inputs came from)." ;
    rdfs:domain :RunTrace ;
    rdfs:range :Prompt .

:evaluationScore a owl:DatatypeProperty ;
    rdfs:label "evaluationScore" ;
    rdfs:comment "An evaluation score attached to a :RunTrace or to the :Prompt a trace used (a quality measurement on the 0..1 scale by convention)." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :RunTrace :Prompt ) ] ;
    rdfs:range xsd:decimal .

# ── Core rooting (MEDULLA-TYPED-PACKS-R071.2) ───────────────────────────────────
# Every class of this module above reaches the core class bfo:Entity (BFO_0000001) through rdfs:subClassOf: the module mixes continuants, processes and information entities, so no narrower core parent is consistent with the BFO disjointness axioms.
<https://knuckles-team.github.io/ontology/core#AgentKind> rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .
<https://knuckles-team.github.io/ontology/core#AgentLibrary> rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .
<https://knuckles-team.github.io/ontology/core#AgentMessage> rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .
<https://knuckles-team.github.io/ontology/core#AnalyticsJob> rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .
<https://knuckles-team.github.io/ontology/core#BusAgent> rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .
<https://knuckles-team.github.io/ontology/core#BusMessage> rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .
<https://knuckles-team.github.io/ontology/core#BusSubscription> rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .
<https://knuckles-team.github.io/ontology/core#BusTopicCursor> rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .
<https://knuckles-team.github.io/ontology/core#ContextBlob> rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .
<https://knuckles-team.github.io/ontology/core#DurableExecutionUnit> rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .
<https://knuckles-team.github.io/ontology/core#DurableRun> rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .
<https://knuckles-team.github.io/ontology/core#DurableUnit> rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .
<https://knuckles-team.github.io/ontology/core#ErrorDetail> rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .
<https://knuckles-team.github.io/ontology/core#EvaluationRun> rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .
<https://knuckles-team.github.io/ontology/core#FsSnapshot> rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .
<https://knuckles-team.github.io/ontology/core#Loop> rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .
<https://knuckles-team.github.io/ontology/core#MeasuredModelFact> rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .
<https://knuckles-team.github.io/ontology/core#Model> rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .
<https://knuckles-team.github.io/ontology/core#ModelProfile> rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .
<https://knuckles-team.github.io/ontology/core#RetainedRunProposal> rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .
<https://knuckles-team.github.io/ontology/core#RunCommit> rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .
<https://knuckles-team.github.io/ontology/core#RunCut> rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .
<https://knuckles-team.github.io/ontology/core#RunEvent> rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .
<https://knuckles-team.github.io/ontology/core#RunTrace> rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .
<https://knuckles-team.github.io/ontology/core#SagaCoordination> rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .
<https://knuckles-team.github.io/ontology/core#Schedule> rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .
<https://knuckles-team.github.io/ontology/core#Session> rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .
<https://knuckles-team.github.io/ontology/core#SkillProposal> rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .
<https://knuckles-team.github.io/ontology/core#SkillWorkflowProposal> rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .
<https://knuckles-team.github.io/ontology/core#StatechartInstance> rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .
<https://knuckles-team.github.io/ontology/core#TaskClass> rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .
<https://knuckles-team.github.io/ontology/core#Workflow> rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> .

# MEDULLA-ORCH-VOCAB-R014.9: what a source class's nodes become in the
# canonical workflow. Values: start, end, human, agent, decision, branch,
# fork, join, wait, call, boundary; graph and the source-only state never
# reach a canonical step. :canonicalGateKind is and, or or xor.
:dagNodeKind a owl:AnnotationProperty ;
    rdfs:label "DAG node kind" ;
    rdfs:comment "The canonical step kind the nodes of a source class become." .

:canonicalGateKind a owl:AnnotationProperty ;
    rdfs:label "canonical gate kind" ;
    rdfs:comment "The gate (and, or, xor) of a split, a join or an event-based wait." .

# MEDULLA-DECISION-ENGINE-R038.3: the facts held-item admission reads from a
# stored run program or run output proposal. Each term names the node row key
# the served `held_item_admission` question reads (snake_case in the row).
:HeldItem a owl:Class ;
    rdfs:label "Held item" ;
    rdfs:comment "A stored run program or run output proposal that waits for admission. Row key held_item_kind: stored_run_program or run_output_proposal." ;
    rdfs:subClassOf bfo:0000001 .

:heldItemContentDigest a owl:DatatypeProperty ;
    rdfs:label "held item content digest" ;
    rdfs:comment "Row key content_digest: the 64-hex digest of the stored item." ;
    rdfs:domain :HeldItem ;
    rdfs:range xsd:string .

:heldItemLifecycle a owl:DatatypeProperty ;
    rdfs:label "held item lifecycle" ;
    rdfs:comment "Row key lifecycle: active or retired. A retired program is never admitted." ;
    rdfs:domain :HeldItem ;
    rdfs:range xsd:string .

:heldItemCompiledBy a owl:DatatypeProperty ;
    rdfs:label "compiled by" ;
    rdfs:comment "Row key compiled_by: the principal that compiled the program." ;
    rdfs:domain :HeldItem ;
    rdfs:range xsd:string .

:heldItemVerifiedBy a owl:DatatypeProperty ;
    rdfs:label "verified by" ;
    rdfs:comment "Row key verified_by: the principal that verified the program; it must differ from compiled_by." ;
    rdfs:domain :HeldItem ;
    rdfs:range xsd:string .

:heldItemVerificationRef a owl:DatatypeProperty ;
    rdfs:label "verification ref" ;
    rdfs:comment "Row key verification_ref: the verification record of the program." ;
    rdfs:domain :HeldItem ;
    rdfs:range xsd:string .

:heldItemVerificationPasses a owl:DatatypeProperty ;
    rdfs:label "verification passes" ;
    rdfs:comment "Row key verification_passes: the passes the verification earned." ;
    rdfs:domain :HeldItem ;
    rdfs:range xsd:integer .

:heldItemCritiqueRef a owl:DatatypeProperty ;
    rdfs:label "critique ref" ;
    rdfs:comment "Row key critique_ref: the critique record of an output proposal." ;
    rdfs:domain :HeldItem ;
    rdfs:range xsd:string .

:heldItemCritiqueDigest a owl:DatatypeProperty ;
    rdfs:label "critique digest" ;
    rdfs:comment "Row key critique_digest: the content digest the critique verdict is bound to." ;
    rdfs:domain :HeldItem ;
    rdfs:range xsd:string .

:heldItemCritiqueVerdict a owl:DatatypeProperty ;
    rdfs:label "critique verdict" ;
    rdfs:comment "Row key critique_verdict: accept or reject." ;
    rdfs:domain :HeldItem ;
    rdfs:range xsd:string .

# MEDULLA-DECISION-ENGINE-R137.15: the stored signature of one kind of
# sub-call. A call is admitted only when it matches this node.
:SubCallSignature a owl:Class ;
    rdfs:label "Sub-call signature" ;
    rdfs:comment "The admitted revision, input and output schema digests, tool set and model of one kind of sub-call." ;
    rdfs:subClassOf bfo:0000001 .

:signature_id a owl:DatatypeProperty ;
    rdfs:label "signature id" ;
    rdfs:domain :SubCallSignature ;
    rdfs:range xsd:string .

# :revision (the signature revision) is declared once in the harness module.

:digest a owl:DatatypeProperty ;
    rdfs:label "signature digest" ;
    rdfs:domain :SubCallSignature ;
    rdfs:range xsd:string .

:input_schema_digest a owl:DatatypeProperty ;
    rdfs:label "input schema digest" ;
    rdfs:domain :SubCallSignature ;
    rdfs:range xsd:string .

:output_schema_digest a owl:DatatypeProperty ;
    rdfs:label "output schema digest" ;
    rdfs:domain :SubCallSignature ;
    rdfs:range xsd:string .

:admitted_tool_ids a owl:DatatypeProperty ;
    rdfs:label "admitted tool id" ;
    rdfs:domain :SubCallSignature ;
    rdfs:range xsd:string .

:model_id a owl:DatatypeProperty ;
    rdfs:label "model id" ;
    rdfs:domain :SubCallSignature ;
    rdfs:range xsd:string .

# Capability gap and desired enhancement nodes (MEDULLA-ORCH-VOCAB-R004.6.1).
:CapabilityGap a owl:Class ;
    rdfs:label "CapabilityGap" ;
    rdfs:subClassOf bfo:0000001 ;
    rdfs:comment "A capability the library lacks for a task class (MEDULLA-ORCH-VOCAB-R004.6.1)." .

:FailureGap a owl:Class ;
    rdfs:label "FailureGap" ;
    rdfs:subClassOf bfo:0000001 ;
    rdfs:comment "A recurring failure pattern filed as a gap (MEDULLA-DECISION-ENGINE-R701.3). Not a CapabilityGap: it names a failure signature, not a capability, task class and domain." .

:DesiredEnhancement a owl:Class ;
    rdfs:label "DesiredEnhancement" ;
    rdfs:subClassOf bfo:0000001 ;
    rdfs:comment "An improvement wanted on an existing capability (MEDULLA-ORCH-VOCAB-R004.6.1)." .

:forCapability a owl:ObjectProperty ;
    rdfs:label "for capability" ;
    rdfs:comment "The capability a gap or enhancement is for." .

:forTaskClass a owl:ObjectProperty ;
    rdfs:label "for task class" ;
    rdfs:comment "The task class a gap or enhancement is for." .

:inDomain a owl:ObjectProperty ;
    rdfs:label "in domain" ;
    rdfs:comment "The domain a gap or enhancement is in." .

:disposition a owl:DatatypeProperty ;
    rdfs:label "disposition" ;
    rdfs:comment "Where a capability gap or desired enhancement stands: open, accepted, resolved or rejected (MEDULLA-ORCH-VOCAB-R004.6.1)." ;
    rdfs:range xsd:string .

# MEDULLA-ORCH-VOCAB-R014.1: the source-neutral process terms. A process step, a gate and
# an event node are task steps; a flow and a lane are concepts. BPMN (bpmn-v1.ttl) and
# ARIS packs extend these.
:ProcessStep a owl:Class ;
    rdfs:label "Process Step" ;
    rdfs:comment "A unit of work in a process model: a task, a sub-process or a call." ;
    rdfs:subClassOf :TaskStep .

:ProcessGate a owl:Class ;
    rdfs:label "Process Gate" ;
    rdfs:comment "A split or join of a process model: the point where flows diverge or converge." ;
    rdfs:subClassOf :TaskStep .

:ProcessEventNode a owl:Class ;
    rdfs:label "Process Event Node" ;
    rdfs:comment "Something that happens in a process model: it starts, ends, waits or interrupts the flow." ;
    rdfs:subClassOf :TaskStep .

:ProcessSequenceFlow a owl:Class ;
    rdfs:label "Process Sequence Flow" ;
    rdfs:comment "A directed flow from one step, gate or event node to another." ;
    rdfs:subClassOf :Concept .

:ProcessLane a owl:Class ;
    rdfs:label "Process Lane" ;
    rdfs:comment "A role or agent kind that performs the elements placed in it." ;
    rdfs:subClassOf :Concept .

:flowSource a owl:ObjectProperty ;
    rdfs:label "flowSource" ;
    rdfs:comment "The step, gate or event node a flow leaves." ;
    rdfs:domain :ProcessSequenceFlow ;
    rdfs:range :TaskStep .

:flowTarget a owl:ObjectProperty ;
    rdfs:label "flowTarget" ;
    rdfs:comment "The step, gate or event node a flow enters." ;
    rdfs:domain :ProcessSequenceFlow ;
    rdfs:range :TaskStep .

:flowCondition a owl:DatatypeProperty ;
    rdfs:label "flowCondition" ;
    rdfs:comment "The condition expression that must hold for a flow to be taken." ;
    rdfs:domain :ProcessSequenceFlow ;
    rdfs:range xsd:string .

:isDefaultFlow a owl:DatatypeProperty ;
    rdfs:label "isDefaultFlow" ;
    rdfs:comment "True on the flow a gate takes when no other condition holds." ;
    rdfs:domain :ProcessSequenceFlow ;
    rdfs:range xsd:boolean .

:inLane a owl:ObjectProperty ;
    rdfs:label "inLane" ;
    rdfs:comment "The lane that performs a process element." ;
    rdfs:domain :TaskStep ;
    rdfs:range :ProcessLane .

:hasProcessElement a owl:ObjectProperty ;
    rdfs:label "hasProcessElement" ;
    rdfs:comment "An element (step, gate, event node, flow or lane) of a process model. No range: elements come from several classes." ;
    rdfs:domain :ProcessModel .

:eventPosition a owl:DatatypeProperty ;
    rdfs:label "eventPosition" ;
    rdfs:comment "Where an event node sits in the flow: start, end, intermediate or boundary." ;
    rdfs:domain :ProcessEventNode ;
    rdfs:range xsd:string .

# MEDULLA-ORCH-VOCAB-R014.4: what binds a process step to its executor. :usesTool and
# :hasPrompt widen their domain to :ProcessStep above; :inLane of a lane with
# :hasAgentKind names the agent kind of a step.
:evaluatesDecision a owl:ObjectProperty ;
    rdfs:label "evaluatesDecision" ;
    rdfs:comment "The decision logic a step evaluates." ;
    rdfs:domain :ProcessStep ;
    rdfs:range :DecisionLogic .

:approverRole a owl:DatatypeProperty ;
    rdfs:label "approverRole" ;
    rdfs:comment "The role that approves a human step." ;
    rdfs:domain :ProcessStep ;
    rdfs:range xsd:string .

:toolArguments a owl:DatatypeProperty ;
    rdfs:label "toolArguments" ;
    rdfs:comment "A JSON argument template for the step's tool, in the binding form of MEDULLA-DECISION-ENGINE-R134.111.8." ;
    rdfs:domain :ProcessStep ;
    rdfs:range xsd:string .

# MEDULLA-ORCH-VOCAB-R014.9: the canonical kind and gate a stored workflow step holds,
# and the process source system.
:stepKind a owl:DatatypeProperty ;
    rdfs:label "stepKind" ;
    rdfs:comment "The canonical kind of a stored workflow step: start, end, human, agent, decision, branch, fork, join, wait, call or boundary." ;
    rdfs:range xsd:string .

:stepGate a owl:DatatypeProperty ;
    rdfs:label "stepGate" ;
    rdfs:comment "The canonical gate of a stored workflow step: and, or or xor." ;
    rdfs:range xsd:string .

:processSourceSystem a owl:DatatypeProperty ;
    rdfs:label "processSourceSystem" ;
    rdfs:comment "The notation a process came from: bpmn20 or aris_epc." ;
    rdfs:range xsd:string .

# MEDULLA-ORCH-VOCAB-R004.6.3: the task class hierarchy a gap query walks.
:subTaskClassOf a owl:ObjectProperty ;
    rdfs:label "sub task class of" ;
    rdfs:comment "A task class is a kind of its parent task class. A descendant gap query follows these edges." ;
    rdfs:domain :TaskClass ;
    rdfs:range :TaskClass .
