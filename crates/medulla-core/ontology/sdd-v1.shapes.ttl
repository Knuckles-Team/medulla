@prefix : <https://knuckles-team.github.io/ontology/core#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Lifecycle edge shapes (MEDULLA-SDLC-R001.1): one NodeShape per edge of the
# closed set. The domain is the shape target and the range is sh:class, so a
# lifecycle edge with a foreign endpoint is a violation, not a new state. A
# violation is a report entry, never an automatic edit (precedent:
# sdd-row-v1.shapes.ttl).

:ChangesEdgeShape a sh:NodeShape ;
    sh:description "A changes edge links a Changeset to a CodeSymbol." ;
    sh:name "Changes edge shape" ;
    sh:targetClass :Changeset ;
    sh:property [ sh:path :changes ;
            sh:class :CodeSymbol ;
            sh:message "LIFECYCLE_EDGE_CHANGES: a changes edge must link a Changeset to a CodeSymbol." ] .

:CitesRequirementEdgeShape a sh:NodeShape ;
    sh:description "A citesRequirement edge links a Changeset to a Requirement." ;
    sh:name "Cites requirement edge shape" ;
    sh:targetClass :Changeset ;
    sh:property [ sh:path :citesRequirement ;
            sh:class :Requirement ;
            sh:message "LIFECYCLE_EDGE_CITES_REQUIREMENT: a citesRequirement edge must link a Changeset to a Requirement." ] .

:ImplementsEdgeShape a sh:NodeShape ;
