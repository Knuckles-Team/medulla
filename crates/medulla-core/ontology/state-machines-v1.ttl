# spec: MEDULLA-TYPED-PACKS-R810.1
# The Admission machine: the lifecycle of one physical write's admission. The Rust edge table
# ADMISSION_MACHINE is the same table.

:AdmissionState a owl:Class ;
    rdfs:label "Admission State" ;
    rdfs:comment "A state of the Admission machine." ;
    rdfs:subClassOf :State .

:AdmissionTerminalState a owl:Class ;
    rdfs:label "Admission Terminal State" ;
    rdfs:comment "A terminal state of the Admission machine." ;
    rdfs:subClassOf :TerminalState, :AdmissionState .

:AdmissionTransition a owl:Class ;
    rdfs:label "Admission Transition" ;
    rdfs:comment "A transition of the Admission machine." ;
    rdfs:subClassOf :Transition .

:AdmissionEvent a owl:Class ;
    rdfs:label "Admission Event" ;
    rdfs:comment "An event of the Admission machine." ;
    rdfs:subClassOf :TransitionEvent .

:AdmissionGuard a owl:Class ;
    rdfs:label "Admission Guard" ;
    rdfs:comment "A guard of the Admission machine." ;
    rdfs:subClassOf :TransitionGuard .

:AdmissionMachine a :StateMachine ;
    rdfs:label "Admission machine" ;
    :initialState :AdmissionMachine_Idle ;
    :hasState :AdmissionMachine_Idle, :AdmissionMachine_Applying, :AdmissionMachine_Finished, :AdmissionMachine_Replayed, :AdmissionMachine_Poisoned .

:AdmissionMachine_Idle a :AdmissionState ;
    rdfs:label "Admission Idle" ;
    rdfs:comment "No batch is admitted yet." ;
    :storedForm "idle" .

:AdmissionMachine_Applying a :AdmissionState ;
    rdfs:label "Admission Applying" ;
    rdfs:comment "One batch is admitted; its owner window opens and closes inside it." ;
    :storedForm "applying" .

:AdmissionMachine_Finished a :AdmissionState ;
    rdfs:label "Admission Finished" ;
    rdfs:comment "The admitted batch finished and awaits its commit." ;
    :storedForm "finished" .

:AdmissionMachine_Replayed a :AdmissionState ;
    rdfs:label "Admission Replayed" ;
    rdfs:comment "Admission resolved to an already-durable receipt; this write applies nothing for it." ;
    :storedForm "replayed" .

:AdmissionMachine_Poisoned a :AdmissionTerminalState ;
    rdfs:label "Admission Poisoned" ;
    rdfs:comment "An unfinished drop poisoned the write; no further event is accepted." ;
    :storedForm "poisoned" .

:AdmissionMachine_Event_Admit a :AdmissionEvent ;
    rdfs:label "Admission Admit" .

:AdmissionMachine_Event_OpenOwner a :AdmissionEvent ;
    rdfs:label "Admission OpenOwner" .

:AdmissionMachine_Event_Finish a :AdmissionEvent ;
    rdfs:label "Admission Finish" .

:AdmissionMachine_Event_Replay a :AdmissionEvent ;
    rdfs:label "Admission Replay" .

:AdmissionMachine_Event_Poison a :AdmissionEvent ;
    rdfs:label "Admission Poison" .

:AdmissionMachine_Guard_BatchMatchesOwnerClosed a :AdmissionGuard ;
    rdfs:label "Admission BatchMatchesOwnerClosed" ;
    rdfs:comment "Guard: The event names the admitted batch and its owner window is still closed." .

:AdmissionMachine_Guard_BatchMatchesOwnerReady a :AdmissionGuard ;
    rdfs:label "Admission BatchMatchesOwnerReady" ;
    rdfs:comment "Guard: The event names the admitted batch and its owner work is done or the layout is ledger-only." .

:AdmissionMachine_A01 a :AdmissionTransition ;
    rdfs:label "Admission A01" ;
    :edgeId "A01" ;
    :fromState :AdmissionMachine_Idle ;
    :toState :AdmissionMachine_Applying ;
    :firedBy :AdmissionMachine_Event_Admit .

:AdmissionMachine_A02 a :AdmissionTransition ;
    rdfs:label "Admission A02" ;
    :edgeId "A02" ;
    :fromState :AdmissionMachine_Finished ;
    :toState :AdmissionMachine_Applying ;
    :firedBy :AdmissionMachine_Event_Admit .

:AdmissionMachine_A03 a :AdmissionTransition ;
    rdfs:label "Admission A03" ;
    :edgeId "A03" ;
    :fromState :AdmissionMachine_Replayed ;
    :toState :AdmissionMachine_Applying ;
    :firedBy :AdmissionMachine_Event_Admit .

:AdmissionMachine_A04 a :AdmissionTransition ;
    rdfs:label "Admission A04" ;
