    :fromState :WorkItemMachine_Leased ;
    :toState :WorkItemMachine_Ready ;
    :guardedBy :WorkItemMachine_Guard_FenceLiveCountersOk ;
    :firedBy :WorkItemMachine_Event_Defer .

:WorkItemMachine_W22 a :WorkItemTransition ;
