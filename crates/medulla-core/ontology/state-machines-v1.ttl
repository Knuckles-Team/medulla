    :edgeId "A06" ;
    :fromState :AdmissionMachine_Idle ;
    :toState :AdmissionMachine_Replayed ;
    :firedBy :AdmissionMachine_Event_Replay .

:AdmissionMachine_A07 a :AdmissionTransition ;
    rdfs:label "Admission A07" ;
    :edgeId "A07" ;
    :fromState :AdmissionMachine_Finished ;
    :toState :AdmissionMachine_Replayed ;
    :firedBy :AdmissionMachine_Event_Replay .

:AdmissionMachine_A08 a :AdmissionTransition ;
