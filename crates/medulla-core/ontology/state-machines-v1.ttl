    :edgeId "DR05" ;
    :fromState :ShardDrainMachine_ShrinkRequested ;
    :toState :ShardDrainMachine_ShrinkCommitted ;
    :guardedBy :ShardDrainMachine_Guard_VoterObservationValid ;
    :firedBy :ShardDrainMachine_Event_CommitShrink .

:ShardDrainMachine_DR06 a :ShardDrainTransition ;
