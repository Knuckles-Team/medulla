# Business operations shapes (MEDULLA-BUSINESS-OPS-R001, R002.1).
#
# SHACL Core plus aggregate-free `sh:sparql` only. The companion of
# business_ops-v1.ttl; further business shapes land beside these, never replacing them.

@prefix kg:   <https://knuckles-team.github.io/ontology/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# spec: MEDULLA-BUSINESS-OPS-R001.1
kg:BusinessProfileShape a sh:NodeShape ;
    sh:targetClass kg:BusinessProfile ;
    sh:property [
        sh:path rdfs:label ; sh:minCount 1 ;
        sh:message "A BusinessProfile carries a label."
    ] ;
    sh:message "A business profile is named." .

kg:ApprovalRuleShape a sh:NodeShape ;
    sh:targetClass kg:ApprovalRule ;
    sh:property [
        sh:path rdfs:label ; sh:minCount 1 ;
        sh:message "An ApprovalRule carries a label."
    ] ;
    sh:property [
        sh:path kg:approvalCeilingMinor ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
        sh:message "An ApprovalRule carries exactly one ceiling, an integer in minor units."
    ] ;
    sh:property [
        sh:path kg:approvalCurrency ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "An ApprovalRule carries exactly one currency code."
    ] ;
    sh:message "An approval rule names its ceiling in minor units and its currency." .

kg:BusinessOpsShapesPrefixes a owl:Ontology ;
    sh:declare [ sh:prefix "kg" ; sh:namespace "https://knuckles-team.github.io/ontology/core#"^^xsd:anyURI ] .

# spec: MEDULLA-BUSINESS-OPS-R001.3
# Every amount is an integer in minor units: a float literal fails `MoneyShape`.
kg:MoneyShape a sh:NodeShape ;
    sh:targetSubjectsOf kg:amountMinor ;
    sh:property [
        sh:path kg:amountMinor ; sh:maxCount 1 ; sh:datatype xsd:integer ;
        sh:message "An amount is one integer in minor units."
    ] ;
    sh:property [
        sh:path kg:amountCurrency ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:message "An amount carries one currency code."
    ] ;
    sh:message "Money is an integer in minor units with a currency code." .

kg:OrderLineMoneyShape a sh:NodeShape ;
    sh:targetClass kg:OrderLine ;
    sh:property [
        sh:path kg:unitPriceMinor ; sh:datatype xsd:integer ;
        sh:message "A unit price is an integer in minor units."
    ] ;
    sh:property [
        sh:path kg:taxMinor ; sh:datatype xsd:integer ;
        sh:message "A tax amount is an integer in minor units."
    ] ;
    sh:property [
        sh:path kg:lineQuantity ; sh:datatype xsd:integer ;
        sh:message "A line quantity is an integer."
    ] ;
    sh:message "An order line carries only integer money and quantity." .

kg:RefundShape a sh:NodeShape ;
    sh:targetClass kg:Refund ;
    sh:property [
        sh:path kg:refundOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class kg:Payment ;
        sh:message "A Refund names exactly one payment it refunds."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A Refund amount is not above the payment it refunds." ;
        sh:prefixes kg:BusinessOpsShapesPrefixes ;
        sh:select """
            SELECT $this WHERE {
                $this kg:refundOf ?payment ; kg:amountMinor ?amount .
                ?payment kg:amountMinor ?paid .
                FILTER(?amount > ?paid)
            }
        """ ;
    ] ;
    sh:message "A refund returns part or all of one payment." .

# spec: MEDULLA-BUSINESS-OPS-R001.5
kg:ObligationInstanceShape a sh:NodeShape ;
    sh:targetClass kg:ObligationInstance ;
    sh:property [
        sh:path kg:obligationStatus ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "open" "satisfied" "waived" "overdue" ) ;
        sh:message "An obligation instance status is open, satisfied, waived or overdue."
    ] ;
    sh:property [
        sh:path kg:instanceDueDate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ;
        sh:message "An obligation instance has exactly one due date."
    ] ;
    sh:message "An obligation instance has a due date and a status of the instance machine." .

kg:RecurrenceRuleShape a sh:NodeShape ;
    sh:targetClass kg:RecurrenceRule ;
    sh:property [
        sh:path kg:recurrenceFrequency ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( "daily" "weekly" "monthly" "quarterly" "yearly" ) ;
        sh:message "A recurrence rule frequency is daily, weekly, monthly, quarterly or yearly."
    ] ;
    sh:property [
        sh:path kg:businessDayAdjustment ; sh:maxCount 1 ;
        sh:in ( "none" "next_business_day" "previous_business_day" ) ;
        sh:message "A business-day adjustment is none, next_business_day or previous_business_day."
    ] ;
    sh:message "A recurrence rule names its frequency." .
