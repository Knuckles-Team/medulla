@prefix : <https://knuckles-team.github.io/ontology/core#> .
@prefix cat: <https://knuckles-team.github.io/ontology/catalog#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix cp: <https://knuckles-team.github.io/ontology/connector-pack#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Connector-backed catalog assets name exactly one connector (MEDULLA-TYPED-PACKS-R106.1).
# AgentAsset is an Agent Library asset governed by R108 and is intentionally
# outside this connector requirement.
cat:ConnectorAssetShape a sh:NodeShape ;
    sh:targetClass cat:ToolAsset, cat:PromptAsset, cat:SkillAsset, cat:DataResource, cat:Field ;
    sh:property [ sh:path cp:ofConnector ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ],
    [ sh:path cp:digest ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9a-f]{64}$" ] .

# A data resource serves exactly one ontology class.
cat:DataResourceShape a sh:NodeShape ;
    sh:targetClass cat:DataResource ;
    sh:property [ sh:path cp:servesClass ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

# A field names exactly one ontology property.
cat:FieldShape a sh:NodeShape ;
    sh:targetClass cat:Field ;
    sh:property [ sh:path cp:servesProperty ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

# A system-prompt candidate names at least one task it frames (MEDULLA-DECISION-ENGINE-R814.4).
:PromptCandidateShape a sh:NodeShape ;
    sh:targetClass :PromptCandidate ;
    sh:property [ sh:path :systemPromptFor ; sh:minCount 1 ; sh:nodeKind sh:IRI ] .

# A stewardship assignment names one asset, one principal and one catalog role.
cat:StewardshipAssignmentShape a sh:NodeShape ;
    sh:targetClass cat:StewardshipAssignment ;
    sh:property [ sh:path cat:assignedTo ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ],
    [ sh:path cat:principal ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ],
    [ sh:path cat:role ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( cat:owner cat:steward cat:custodian ) ] .

# A lineage edge names both ends and a closed hop type.
cat:LineageEdgeShape a sh:NodeShape ;
    sh:targetClass cat:LineageEdge ;
    sh:property [ sh:path cat:from ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ],
    [ sh:path cat:to ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ],
    [ sh:path cat:hop ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
      sh:in ( "connector" "operation" "resource" "field" "ingest" "transform" ) ] .

# Each lineage edge node is paired with the direct cat:lineageTo edge between its ends
# (MEDULLA-TYPED-PACKS-R106.2). The unpaired edge is refused as LINEAGE_EDGE_UNPAIRED (R106.4).
# The paired edge is looked up with OPTIONAL: the constraint dialect declines EXISTS.
cat:LineageEdgePairShape a sh:NodeShape ;
    sh:targetClass cat:LineageEdge ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A lineage edge needs the direct cat:lineageTo edge from its cat:from to its cat:to." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://knuckles-team.github.io/ontology/catalog#from> ?from ;
                      <https://knuckles-team.github.io/ontology/catalog#to> ?to .
                OPTIONAL {
                    ?from <https://knuckles-team.github.io/ontology/catalog#lineageTo> ?to .
                    ?from <https://knuckles-team.github.io/ontology/catalog#lineageTo> ?paired .
                }
                FILTER(!BOUND(?paired))
            }
        """ ;
    ] .

# Each connector-backed asset has a stewardship assignment or carries the owner_missing flag
# (MEDULLA-TYPED-PACKS-R106.2). A pack with no declared owner imports flagged, never refused.
cat:ConnectorAssetOwnerShape a sh:NodeShape ;
    sh:targetClass cat:ToolAsset, cat:PromptAsset, cat:SkillAsset, cat:DataResource, cat:Field ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A connector asset needs a cat:StewardshipAssignment or the owner_missing flag." ;
        sh:select """
            SELECT $this WHERE {
                OPTIONAL { ?assignment <https://knuckles-team.github.io/ontology/catalog#assignedTo> $this . }
                OPTIONAL {
                    $this <https://knuckles-team.github.io/ontology/catalog#flag> "owner_missing" .
                    $this <https://knuckles-team.github.io/ontology/catalog#flag> ?flagged .
                }
                FILTER(!BOUND(?assignment) && !BOUND(?flagged))
            }
        """ ;
    ] .

# A glossary term has one preferred label and names at least one class.
cat:GlossaryTermShape a sh:NodeShape ;
    sh:targetClass cat:GlossaryTerm ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:maxCount 1 ],
    [ sh:path cat:definesClass ; sh:nodeKind sh:IRI ],
    [ sh:path :definesAsset ; sh:nodeKind sh:IRI ],
    [ sh:path dct:isReplacedBy ; sh:nodeKind sh:IRI ] ;
    # A term defines a class or an asset (MEDULLA-TYPED-PACKS-R801.1).
    sh:or ( [ sh:path cat:definesClass ; sh:minCount 1 ] [ sh:path :definesAsset ; sh:minCount 1 ] ) .

# The asset flag vocabulary is closed.
cat:AssetFlagShape a sh:NodeShape ;
    sh:targetClass cat:ToolAsset, cat:PromptAsset, cat:SkillAsset, cat:DataResource, cat:Field ;
    sh:property [ sh:path cat:flag ; sh:datatype xsd:string ; sh:in ( "owner_missing" "deprecated" ) ] .

# Each family asset names one owner or carries the owner_missing flag
# (MEDULLA-TYPED-PACKS-R108.1).
cat:FamilyAssetOwnerShape a sh:NodeShape ;
    sh:targetClass cat:AgentTemplateAsset, cat:A2AAgentAsset, cat:AgentVersion, cat:OrgUnit,
        cat:Team, cat:Person, cat:Role, cat:BusinessDomain, cat:Product, cat:Service,
        cat:WorkflowDefinition, cat:WorkflowRun, cat:WorkflowStep, cat:KnowledgeGraph,
        cat:SpecialistPackage, cat:ProviderAsset, cat:DashboardAsset ;
    sh:property [ sh:path cat:flag ; sh:datatype xsd:string ; sh:in ( "owner_missing" "deprecated" ) ],
    [ sh:path cat:hasOwner ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:or ( [ sh:path cat:hasOwner ; sh:minCount 1 ]
            [ sh:path cat:flag ; sh:hasValue "owner_missing" ] ) .

# Specialist packages and providers carry a SHA-256 digest.
cat:DigestedAssetShape a sh:NodeShape ;
    sh:targetClass cat:SpecialistPackage, cat:ProviderAsset ;
    sh:property [ sh:path cp:digest ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
                  sh:pattern "^[0-9a-f]{64}$" ] .

# A dashboard asset carries one revision number (MEDULLA-TYPED-PACKS-R109.1).
cat:DashboardAssetShape a sh:NodeShape ;
    sh:targetClass cat:DashboardAsset ;
    sh:property [ sh:path cat:revision ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:nonNegativeInteger ] .
